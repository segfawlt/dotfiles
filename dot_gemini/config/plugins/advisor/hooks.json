{
  "advisor": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "run_command|edit_file|write_file|replace_file_content|multi_replace_file_content|write_to_file|create_file|delete_file|edit_notebook|delete_directory|move|invoke_subagent|manage_task|read_file|view_file|grep_search|find_by_name|list_dir",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/agy-advisor post-tool-hook",
            "timeout": 5
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "~/.local/bin/agy-advisor pre-invocation-hook",
        "timeout": 75
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "~/.local/bin/agy-advisor stop-hook",
        "timeout": 130
      }
    ]
  }
}
