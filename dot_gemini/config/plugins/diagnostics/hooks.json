{
  "diagnostics": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/agy-diagnostics post-tool-hook",
            "timeout": 5
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "~/.local/bin/agy-diagnostics pre-invocation-hook",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "~/.local/bin/agy-diagnostics stop-hook",
        "timeout": 6
      }
    ]
  }
}
