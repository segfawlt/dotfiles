OUTPUT_HAZARDS = [
    ("instruction override", re.compile(r"\bignore\s+(?:all\s+)?(?:prior|previous|earlier)\s+(?:user\s+)?instructions\b", re.I)),
    ("destructive shell command", re.compile(r"\brm\s+(?:-[a-zA-Z]*r[a-zA-Z]*f|-[a-zA-Z]*f[a-zA-Z]*r)\b")),
    ("denial instruction", re.compile(r"\bdeny\s+(?:this|it|the\s+request)\s+if\s+(?:asked|questioned)\b", re.I)),
]

BOUNDARY_GUIDANCE = (
