function toLocalDatetimeValue(ms) {
  const d = new Date(ms);
  const pad = n => String(n).padStart(2, "0");
  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
}
function esc(str) {
  return String(str || "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#39;");
}

function renderSparklineSVG(values, color = "var(--chart-primary)", width = 160, height = 28) {
  if (!values || values.length < 2) return "";
  const max = Math.max(...values, 0.001);
  const n = values.length;
  const step = width / (n - 1);
  let d = "";
  for (let i = 0; i < n; i++) {
    const x = (i * step).toFixed(1);
    const y = (height - 2 - (values[i] / max) * (height - 4)).toFixed(1);
    d += (i === 0 ? "M" : "L") + x + "," + y;
  }
  const areaD = d + `L${width},${height}L0,${height}Z`;
  return `
    <div class="sparkline" style="width:100%;height:${height}px;">
      <svg width="100%" height="${height}" viewBox="0 0 ${width} ${height}" preserveAspectRatio="none" aria-hidden="true">
        <path class="area" d="${areaD}" fill="${color}"></path>
        <path class="chart-line" d="${d}" stroke="${color}"></path>
      </svg>
    </div>
  `;
}

function toggleTheme() {
  const cur = document.documentElement.getAttribute("data-theme") === "dark" ? "light" : "dark";
  document.documentElement.setAttribute("data-theme", cur);
  document.getElementById("themeToggleBtn").textContent = cur === "dark" ? "Light" : "Dark";
  localStorage.setItem("agy-stats-theme", cur);
  renderOverviewActivityChart();
}
function initTheme() {
  const saved = localStorage.getItem("agy-stats-theme") || "dark";
  document.documentElement.setAttribute("data-theme", saved);
  document.getElementById("themeToggleBtn").textContent = saved === "dark" ? "Light" : "Dark";
}

function navigateTab(tabId) {
  hideQuotaConversionTip();
  document.querySelectorAll(".nav-row").forEach(b => b.dataset.active = (b.dataset.tab === tabId));
  document.querySelectorAll(".view-pane").forEach(p => p.classList.toggle("active", p.id === "pane-" + tabId));
  window.scrollTo({ top: 0 });
  requestAnimationFrame(() => {
    syncSegmentedThumbs();
    if (tabId === "overview" && G_OVERVIEW_DATA) renderOverviewActivityChart();
  });
}

function initCustomInputs() {
  const fromEl = document.getElementById("customFromInput");
  const toEl = document.getElementById("customToInput");
  if (fromEl && !fromEl.value) {
    const now = Date.now();
    fromEl.value = toLocalDatetimeValue(now - 6 * 3600 * 1000);
    toEl.value = toLocalDatetimeValue(now);
  }
}

function setTimeRange(rangeKey) {
  G_CURRENT_RANGE = rangeKey;
  document.querySelectorAll("#timeRangeSeg .segmented-option").forEach(b => {
    b.dataset.active = (b.dataset.range === rangeKey);
  });
  syncSegmentedThumbs();
  const bar = document.getElementById("customRangeBar");
  if (rangeKey === "custom") {
    initCustomInputs();
    bar.classList.add("open");
    applyCustomRange();
  } else {
    bar.classList.remove("open");
    loadStats(rangeKey, false);
  }
}

function applyCustomRange() {
  const fromVal = document.getElementById("customFromInput").value;
  const toVal = document.getElementById("customToInput").value;
  const fromMs = fromVal ? Date.parse(fromVal) : (Date.now() - 6 * 3600 * 1000);
  const toMs = toVal ? Date.parse(toVal) : Date.now();
  loadStats("custom", false, fromMs, toMs);
}

function refreshCurrentRange() {
  if (G_CURRENT_RANGE === "custom") {
    const fromVal = document.getElementById("customFromInput").value;
    const toVal = document.getElementById("customToInput").value;
    loadStats("custom", true, fromVal ? Date.parse(fromVal) : null, toVal ? Date.parse(toVal) : null);
  } else {
    loadStats(G_CURRENT_RANGE, true);
  }
}

