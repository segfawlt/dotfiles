    return q === "multi" ? "multi" : "server";
  } catch (e) { return "server"; }
})();
let G_PACING_SOURCE = (() => {
  try {
    const s = localStorage.getItem("agy-stats-pacing-source-v2");
    return (s === "server" || s === "local") ? s : "local";
  } catch (e) { return "local"; }
})();
let G_PACING_STYLE = (() => {
  try {
