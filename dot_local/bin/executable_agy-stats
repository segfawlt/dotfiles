  const applyBtn = document.getElementById("applyUpdateWebBtn");
  const curVer = cfg.current_version || "1.0.0";
  const seenVer = cfg.latest_seen_version || "";
  if (verBadge) {
    if (seenVer && seenVer !== curVer) {
