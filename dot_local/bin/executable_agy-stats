function initSkeletons() {
  document.querySelectorAll("[data-table-skel]").forEach(el => {
    const rows = Math.max(1, Number(el.dataset.tableSkel || 8));
    let html = "";
    for (let i = 0; i < rows; i++) {
      const w = 92 - ((i * 13) % 30);
      html += `<div class="skeleton" style="height:16px;width:${w}%;"></div>`;
    }
    el.innerHTML = html;
  });
}

function revealLoadedContent() {
  if (G_INITIAL_REVEALED) return;
  G_INITIAL_REVEALED = true;
  const ovSkel = document.getElementById("overviewStatsSkeleton");
  if (ovSkel) ovSkel.style.display = "none";
  document.querySelectorAll("[data-grid-skel], [data-table-skel]").forEach(el => {
    el.style.display = "none";
  });
  ["quotaPoolsGrid", "errorsStatGrid", "frustrationStatGrid"].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.removeAttribute("hidden");
  });
  document.querySelectorAll(".table-wrap[hidden]").forEach(el => {
    el.removeAttribute("hidden");
  });
  const disSec = (G_SETTINGS && G_SETTINGS.cli && Array.isArray(G_SETTINGS.cli.disabled_sections))
    ? G_SETTINGS.cli.disabled_sections
    : [];
  applyOverviewDisplaySections(disSec);
}

function syncSegmentedThumbs(snap = false) {
  document.querySelectorAll(".segmented").forEach(seg => {
    let thumb = seg.querySelector(":scope > .segmented-thumb");
    if (!thumb) {
      thumb = document.createElement("span");
      thumb.className = "segmented-thumb";
      thumb.setAttribute("aria-hidden", "true");
      seg.insertBefore(thumb, seg.firstChild);
    }
    const active = seg.querySelector(':scope > .segmented-option[data-active="true"]');
    if (!active || active.offsetWidth === 0) {
      seg.dataset.measured = "false";
      thumb.style.display = "none";
      return;
    }
    const skipTransition = snap || seg.dataset.measured !== "true";
    if (skipTransition) thumb.style.transition = "none";
    thumb.style.display = "";
    thumb.style.width = active.offsetWidth + "px";
    thumb.style.left = active.offsetLeft + "px";
    seg.dataset.measured = "true";
    if (skipTransition) {
      void thumb.offsetWidth;
      thumb.style.transition = "";
    }
  });
}

function flashChangedStats() {
  const isFirstPass = G_PREV_STAT_VALUES.size === 0;
  document.querySelectorAll(".stat-grid").forEach(grid => {
    const gridKey = grid.id || "grid";
    grid.querySelectorAll(":scope > .stat").forEach((statEl, idx) => {
      const labelEl = statEl.querySelector(".stat-label");
      const valEl = statEl.querySelector(".stat-value");
      if (!valEl) return;
      const rawLabel = (labelEl ? labelEl.textContent : String(idx)) || String(idx);
      const normLabel = rawLabel.replace(/\s*\([^)]*\)\s*/g, " ").trim();
      const key = `${gridKey}::${normLabel}`;
      const valText = (valEl.textContent || "").trim();
      if (!isFirstPass && G_PREV_STAT_VALUES.has(key) && G_PREV_STAT_VALUES.get(key) !== valText) {
        valEl.dataset.flash = "true";
        setTimeout(() => { valEl.dataset.flash = "false"; }, 900);
      }
      G_PREV_STAT_VALUES.set(key, valText);
    });
  });
}

function fmtLiveAgo(ms) {
  const s = Math.max(0, Math.round(ms / 1000));
  if (s < 45) return "just now";
  const m = Math.round(s / 60);
  if (m < 60) return `${m}m ago`;
  const h = Math.round(m / 60);
  return h < 24 ? `${h}h ago` : `${Math.round(h / 24)}d ago`;
}

function updateLiveAgo() {
  if (G_SYNC_PHASE !== "idle" || G_LAST_SYNCED_AT === null) return;
  const info = document.getElementById("liveScanInfo");
  if (info) {
    info.textContent = fmtLiveAgo(Date.now() - G_LAST_SYNCED_AT);
    info.style.display = "inline";
  }
}

setInterval(updateLiveAgo, 15000);

window.addEventListener("scroll", () => {
  const topbar = document.getElementById("shellTopbar");
  if (topbar) topbar.dataset.scrolled = window.scrollY > 4 ? "true" : "false";
}, { passive: true });

