}

function findPool(poolId) {
  return (G_FULL_DATA?.quota || []).find(q => q.id === poolId) || null;
}

// Overview Rendering
function renderDynamicOverview() {
  const ovData = G_OVERVIEW_DATA;
  if (!ovData || !ovData.overall) return;

  const ov = ovData.overall;
  const ts = ovData.timeSeries || [];

  document.getElementById("activityDescription").textContent = ov.unitDescription;

  const reqSpark = ts.map(t => t.requests);
  const tokSpark = ts.map(t => t.tokens);
  const cacheSpark = ts.map(t => Math.max(0, t.tokens - (t.requests * 200)));
  const errSpark = ts.map(t => t.errors || 0);
  const errSparkColor = ov.failedRequests > 0 ? "var(--bad)" : "var(--chart-primary)";
  const sessInRange = Number(ov.totalSessionsInRange || 0);

  document.getElementById("primaryStatGrid").innerHTML = `
    <div class="stat">
      <div class="stat-label">Requests</div>
      <div class="stat-value">${B(ov.totalRequests)}</div>
      <div class="stat-foot"><span class="truncate">${B(ov.successfulRequests)} ok · ${B(sessInRange)} ${sessInRange === 1 ? "session" : "sessions"}</span></div>
      <div class="stat-spark">${renderSparklineSVG(reqSpark, "var(--chart-primary)")}</div>
    </div>

    <div class="stat">
      <div class="stat-label">Conversation tokens</div>
      <div class="stat-value">${Re(ov.conversationTokens)}</div>
      <div class="stat-foot"><span class="truncate">${Re(ov.totalOutputTokens)} output</span></div>
      <div class="stat-spark">${renderSparklineSVG(tokSpark, "var(--chart-primary)")}</div>
    </div>

    <div class="stat">
      <div class="stat-label">Cache rate</div>
      <div class="stat-value">${He(ov.cacheRate)}</div>
      <div class="stat-foot"><span class="truncate">${Re(ov.totalCacheReadTokens)} cached</span></div>
      <div class="stat-spark">${renderSparklineSVG(cacheSpark, "var(--chart-primary)")}</div>
    </div>

    <div class="stat">
      <div class="stat-label">Error rate</div>
      <div class="stat-value">${He(ov.errorRate, 1)}</div>
      <div class="stat-foot"><span class="truncate">${B(ov.failedRequests)} failed</span></div>
      <div class="stat-spark">${renderSparklineSVG(errSpark, errSparkColor)}</div>
    </div>
  `;

  document.getElementById("secondaryStatGrid").innerHTML = `
    <div class="stat" data-size="sm"><div class="stat-label">Uncached input</div><div class="stat-value">${Re(ov.totalInputTokens)}</div></div>
    <div class="stat" data-size="sm"><div class="stat-label">Cache read</div><div class="stat-value">${Re(ov.totalCacheReadTokens)}</div></div>
    <div class="stat" data-size="sm"><div class="stat-label">Output</div><div class="stat-value">${Re(ov.totalOutputTokens)}</div></div>
    <div class="stat" data-size="sm"><div class="stat-label">Tokens/s</div><div class="stat-value">${ov.avgTokensPerSecond.toFixed(1)}</div></div>
    <div class="stat" data-size="sm"><div class="stat-label">Avg latency</div><div class="stat-value">${Rt(ov.avgDuration)}</div></div>
    <div class="stat" data-size="sm"><div class="stat-label">P95 latency</div><div class="stat-value">${Rt(ov.p95Duration)}</div></div>
  `;

  renderPacingSection("overviewPacingBody");
  renderOverviewActivityChart();
  renderDynamicTokenMix();
  renderTopSessionsOverview();
  renderDynamicLatestRequests();
}

function _activePoolView(po) {
  if (!po) return null;
  if (G_QUOTA_MODE === "multi" && G_PACING_SOURCE === "local" && po.localView) {
    return po.localView;
  }
  return po;
}

function _poolHealthTone(po) {
  const v = _activePoolView(po);
  if (!v) return "neutral";
  if (Number(v.serverWkRemPct ?? 100) <= 0.05 || Number(v.server5hRemPct ?? 100) <= 0.05 || v.wkWillRunOut || v.fhWillRunOut) {
    return "bad";
  }
  if (v.wkCaution || Number(v.server5hUnclippedPct || 0) >= 85) {
    return "warn";
  }
  return "ok";
}

function _clockPinHtml(pct) {
  const clamped = Math.min(100, Math.max(0, Number(pct || 0)));
  const tagShift = clamped < 9 ? "translateX(-10%)" : (clamped > 91 ? "translateX(-90%)" : "translateX(-50%)");
  return `
    <div style="position:absolute; top:0; left:${clamped}%; pointer-events:none;">
      <div class="pacing-clock-tag" style="position:absolute; top:0; left:0; transform:${tagShift};">Now · ${Math.round(clamped)}%</div>
      <div class="pacing-clock-line" style="position:absolute; top:13px; left:-1px;"></div>
    </div>
  `;
}

function showQuotaConversionTip(e, poolKey) {
  const tip = document.getElementById("quotaHoverTip");
  const ov = G_OVERVIEW_DATA?.overall || G_FULL_DATA?.overall;
  if (!tip || !ov?.pacing) return;
  const pools = ov.pacing.pools || { gemini: ov.pacing };
  const pk = (poolKey === "3p" && pools["3p"]) ? "3p" : "gemini";
  const rawPool = pools[pk] || pools.gemini || ov.pacing;
  const p = _activePoolView(rawPool) || rawPool;
  const gem = _activePoolView(pools.gemini) || pools.gemini || p;
  const tp = _activePoolView(pools["3p"]) || pools["3p"] || null;

  const gemB2W = Number(gem?.burstToWkPct ?? 25.0);
  const gemTanks = Number(gem?.wkTanksTotal ?? (100 / Math.max(1, gemB2W)));
  const tpB2W = Number(tp?.burstToWkPct ?? 50.0);
  const tpTanks = Number(tp?.wkTanksTotal ?? (100 / Math.max(1, tpB2W)));

  const fhUsed = Number(p.server5hUsedPct ?? 0);
  const fhRem = Number(p.server5hRemPct ?? Math.max(0, 100 - fhUsed));
  const wkRem = Number(p.serverWkRemPct ?? 0);
  const activeB2W = Number(p.burstToWkPct ?? (pk === "3p" ? 50.0 : 25.0));
  const fhUsedWk = Number(p.fhUsedAsWkPct ?? ((fhUsed / 100) * activeB2W));
  const fhRemWk = Number(p.fhRemAsWkPct ?? ((fhRem / 100) * activeB2W));
  const tanksLeft = Number(p.burstTanksEquivLeft ?? (wkRem / Math.max(1, activeB2W)));
  const activeLabel = p.label || (pk === "3p" ? "Claude / GPT" : "Gemini");

  tip.innerHTML = `
    <div class="chart-tooltip-title" style="font-family:var(--font-sans); font-weight:600; color:var(--ink-2); font-size:11.5px;">5h burst → weekly quota</div>
    <div class="chart-tooltip-row" data-active-pool="${pk === 'gemini'}">
      <span class="swatch" style="background:${pk === 'gemini' ? 'var(--chart-primary)' : 'var(--ink-3)'};"></span>
      <span class="chart-tooltip-label">Gemini 100% 5h</span>
      <span class="chart-tooltip-value">${gemB2W.toFixed(1)}% of Weekly <span class="dim">(${gemTanks.toFixed(0)}x)</span></span>
    </div>
    <div class="chart-tooltip-row" data-active-pool="${pk === '3p'}">
      <span class="swatch" style="background:${pk === '3p' ? 'var(--chart-primary)' : 'var(--ink-3)'};"></span>
      <span class="chart-tooltip-label">Claude/GPT 100% 5h</span>
      <span class="chart-tooltip-value">${tpB2W.toFixed(1)}% of Weekly <span class="dim">(${tpTanks.toFixed(0)}x)</span></span>
    </div>
    <div class="chart-tooltip-row chart-tooltip-total">
      <span class="chart-tooltip-label">${esc(activeLabel)} 5h used (${fhUsed.toFixed(1)}%)</span>
      <span class="chart-tooltip-value">${fhUsedWk.toFixed(1)}% wk</span>
    </div>
    <div class="chart-tooltip-row">
      <span class="chart-tooltip-label">${esc(activeLabel)} 5h left (${fhRem.toFixed(1)}%)</span>
      <span class="chart-tooltip-value">${fhRemWk.toFixed(1)}% wk</span>
    </div>
    <div class="chart-tooltip-row">
      <span class="chart-tooltip-label">${esc(activeLabel)} wk left (${wkRem.toFixed(1)}%)</span>
      <span class="chart-tooltip-value">~${tanksLeft.toFixed(1)} 5h tanks</span>
    </div>
  `;

  tip.style.display = "block";
  const target = e.currentTarget || e.target;
  const rect = target.getBoundingClientRect();
  const tipRect = tip.getBoundingClientRect();
  const left = Math.min(window.innerWidth - tipRect.width - 12, Math.max(12, rect.left + (rect.width / 2) - (tipRect.width / 2)));
  let top = rect.bottom + 8;
  if (top + tipRect.height > window.innerHeight - 12) {
    top = Math.max(12, rect.top - tipRect.height - 8);
  }
  tip.style.left = `${Math.round(left)}px`;
  tip.style.top = `${Math.round(top)}px`;
}

function hideQuotaConversionTip() {
  const tip = document.getElementById("quotaHoverTip");
  if (tip) tip.style.display = "none";
}

window.addEventListener("scroll", hideQuotaConversionTip, { passive: true });

function renderQuotaPoolsGrid() {
  const grid = document.getElementById("quotaPoolsGrid");
  const d = G_FULL_DATA || G_OVERVIEW_DATA;
  if (!grid || !d) return;
  const ov = d.overall || {};
  const qList = d.quota || [];
  grid.innerHTML = qList.length ? qList.map(g => {
    const rem = Number(g.remainingPct ?? (g.remainingFraction * 100)).toFixed(1);
    const used = Number(g.usedPct ?? (100 - g.remainingFraction * 100)).toFixed(1);
    const isGemWk = g.id === "gemini-weekly";
    const isGem5h = g.id === "gemini-5h";
    const is3pWk = g.id === "3p-weekly";
    const is3p5h = g.id === "3p-5h";
    const localPct = isGemWk ? Number(ov.cycleWeekLocalPct || 0)
      : isGem5h ? Number(ov.cycle5hLocalPct || 0)
      : is3pWk ? Number(ov.cycle3pWeekLocalPct || 0)
      : is3p5h ? Number(ov.cycle3p5hLocalPct || 0)
      : 0;
    const localCycleStr = (G_QUOTA_MODE === "multi" && localPct > 0) ? ` · ${localPct}% this setup` : "";
    const fullFoot = `${rem}% left · resets ${fmtResetIn(g.resetTime)}${localCycleStr}`;
    const qTipPool = (is3pWk || is3p5h) ? "3p" : "gemini";
    return `
      <div class="stat" style="cursor:help;" onmouseenter="showQuotaConversionTip(event, '${qTipPool}')" onmouseleave="hideQuotaConversionTip()">
        <div class="stat-label"><span class="pacing-tip-trigger">${esc(g.groupName)} · ${esc(g.windowLabel)}</span></div>
        <div class="stat-value">${used}%</div>
        <div class="stat-foot"><span class="truncate" title="${esc(fullFoot)}">${esc(fullFoot)}</span></div>
      </div>
    `;
  }).join("") : `<div class="stat"><div class="stat-label">Server quota</div><div class="stat-value">–</div><div class="stat-foot">Live quota pools unavailable</div></div>`;
}

function renderPacingSection(targetId) {
  const el = document.getElementById(targetId);
  if (!el || !G_OVERVIEW_DATA?.overall) return;
  const cardEl = el.closest(".pacing-deck");
  if (!G_OVERVIEW_DATA.overall.pacing) {
    if (cardEl) { cardEl.dataset.tone = "neutral"; cardEl.dataset.minimal = "true"; }
    el.innerHTML = `<div class="dim micro" style="padding:16px 20px;">Live server quota pacing unavailable.</div>`;
    return;
  }
  const ov = G_OVERVIEW_DATA.overall;
  const pools = ov.pacing.pools || { gemini: ov.pacing };
  const has3p = !!(pools["3p"] && pools["3p"].available);
  if (G_PACING_POOL === "3p" && !has3p) G_PACING_POOL = "gemini";
  const baseP = pools[G_PACING_POOL] || pools.gemini || ov.pacing;
  const isMultiMode = (G_QUOTA_MODE === "multi");
  const useLocalSource = isMultiMode && G_PACING_SOURCE === "local" && !!baseP.localView;
  const p = useLocalSource ? baseP.localView : baseP;
  const styleMode = (G_PACING_STYLE === "straight" || G_PACING_STYLE === "minimal") ? G_PACING_STYLE : "fun";

  const gemView = _activePoolView(pools.gemini);
  const tpView = _activePoolView(pools["3p"]);
  const gemTone = _poolHealthTone(pools.gemini);
  const tpTone = _poolHealthTone(pools["3p"]);

  let resetDay = "reset";
  if (p.wkResetTime) {
    try {
      const d = new Date(p.wkResetTime);
      if (!isNaN(d.getTime())) resetDay = d.toLocaleDateString("en-US", { weekday: "long" });
    } catch (e) {}
  }

  const resetDisp = fmtResetIn(p.wkResetTime);
  const burstRefill = fmtResetIn(p.fhResetTime);
  const baseLabel = p.label || (G_PACING_POOL === "3p" ? "Claude / GPT" : "Gemini");
  const poolLabel = useLocalSource ? `${baseLabel} (This setup)` : baseLabel;

  // 5-Hour Burst metrics
  const fhUsed = Number(p.server5hUsedPct ?? 0);
  const fhRem = Number(p.server5hRemPct ?? Math.max(0, 100 - fhUsed));
  const fhExhausted = fhRem <= 0.05;
  const fhWarmup = !!p.fhWarmup && !fhExhausted;
  const fhRunOut = !!p.fhWillRunOut && !fhExhausted;
  const fhProjUnclipped = Number(p.server5hUnclippedPct ?? fhUsed);
  const fhProj = Number(p.server5hProjectedPct ?? Math.min(100, fhProjUnclipped));
  const fhRateHr = Number(p.server5hRatePerHour ?? 0);
  const fhSafeHr = Number(p.safe5hHourlyBudgetLeft ?? 20);
  const fhRateSrc = p.fhRateSource || "5h window";
  const fhMultVal = p.target5hMultiplier != null ? Number(p.target5hMultiplier) : null;
  const fhCutPct = Math.min(99, Math.max(1, Math.round((1 - (fhSafeHr / Math.max(0.01, fhRateHr))) * 100)));
  const fhLocalW = Math.min(100, Math.max(0, Number(baseP.local5hUsedPct || 0)));
  const fhOtherW = Math.min(100 - fhLocalW, Math.max(0, Number(baseP.other5hUsedPct || 0)));
  const fhHasDualSeg = isMultiMode && !useLocalSource && fhLocalW > 0.05 && fhOtherW >= 1.0;

  let fhBarColor = "var(--ok)";
  let fhSubTitleHtml = "";
  let fhRightMetaHtml = "";
  if (fhExhausted) {
    fhBarColor = "var(--bad)";
    fhSubTitleHtml = `exhausted · refills in ${esc(burstRefill)}`;
    fhRightMetaHtml = `<span class="mono" style="color:var(--bad);">Paused until refill</span>`;
  } else if (fhWarmup) {
    fhBarColor = "var(--ok)";
    fhSubTitleHtml = `fresh window · refills in ${esc(burstRefill)}`;
    fhRightMetaHtml = `<span class="mono">~${Re(p.est5hReqsLeft)} avg reqs in 5h tank</span>`;
  } else if (fhRunOut) {
    fhBarColor = "var(--bad)";
    const fhTte = fmtHoursJS(p.fhTteHours);
    fhSubTitleHtml = `dry in ~${esc(fhTte)} · refills in ${esc(burstRefill)}`;
    const fhMultTxt = fhMultVal != null ? `${fhMultVal.toFixed(2)}x pace` : `-${fhCutPct}%`;
    fhRightMetaHtml = `<span class="mono" style="color:var(--bad);">Drop to ${esc(fhMultTxt)} (&lt;= ${fhSafeHr.toFixed(1)}%/hr)</span>`;
  } else if (fhProjUnclipped >= 85) {
    fhBarColor = "var(--warn)";
    fhSubTitleHtml = `refills in ${esc(burstRefill)} · active sprint`;
    fhRightMetaHtml = `<span class="mono">Tracks ~${fhProj.toFixed(0)}% by refill (${esc(fhRateSrc)})</span>`;
  } else {
    fhBarColor = "var(--ok)";
    const fhStep = (fhMultVal != null && fhMultVal >= 1.15 && fhMultVal <= 15)
      ? ` · can go <strong style="color:var(--ink-1);">${fhMultVal.toFixed(1)}x</strong> faster`
      : "";
    fhSubTitleHtml = `refills in ${esc(burstRefill)}${fhStep}`;
    fhRightMetaHtml = `<span class="mono">Tracks ~${fhProj.toFixed(0)}% by refill (${esc(fhRateSrc)})</span>`;
  }

  // Weekly Endurance & Smooth 5h metrics
  const wkUsed = Number(p.serverWkUsedPct ?? 0);
  const wkRem = Number(p.serverWkRemPct ?? Math.max(0, 100 - wkUsed));
  const wkExhausted = wkRem <= 0.05;
  const wkWarmup = !!p.wkWarmup && !wkExhausted;
  const wkUnkillable = !!p.wkUnkillable && !wkExhausted;
  const wkRunOut = !!p.wkWillRunOut && !wkExhausted;
  const wkCaution = !!p.wkCaution && !wkExhausted && !wkUnkillable && !wkWarmup && !wkRunOut;
  const wkLessBurst = !!p.wkLessThanOneBurst && !wkExhausted && !wkUnkillable;
  const wkProjUnclipped = Number(p.serverWkUnclippedPct ?? wkUsed);
  const wkProj = Number(p.serverWkProjectedPct ?? Math.min(100, wkProjUnclipped));
  const wkRatio = Number(p.serverWkPaceRatio ?? 0);
  const wkRemH = Number(p.wkRemainingHours ?? 24);
  const useWkHr = wkRemH < 24.0;
  const wkCurRate = Number(useWkHr ? p.serverWkRatePerHour : p.serverWkRatePerDay);
  const wkSafeRate = Number(useWkHr ? p.safeHourlyBudgetLeft : p.safeDailyBudgetLeft);
  const wkUnit = useWkHr ? "hr" : "day";
  const wkDigits = useWkHr ? 2 : 1;
  const wkCurStr = `~${wkCurRate.toFixed(wkDigits)}%/${wkUnit}`;
  const wkTargetStr = `${wkSafeRate.toFixed(wkDigits)}%/${wkUnit}`;
  const wkMultVal = p.targetWkMultiplier != null ? Number(p.targetWkMultiplier) : null;
  const wkCutPct = Math.min(99, Math.max(1, Math.round((1 - (wkSafeRate / Math.max(0.01, wkCurRate))) * 100)));
  const wkLocalW = Math.min(100, Math.max(0, Number(baseP.localWkUsedPct || 0)));
  const wkOtherW = Math.min(100 - wkLocalW, Math.max(0, Number(baseP.otherWkUsedPct || 0)));
  const wkHasDualSeg = isMultiMode && !useLocalSource && wkLocalW > 0.05 && wkOtherW >= 1.0;

  const smoothSessPct = Number(p.smooth5hSessionPct ?? 0);
  const smooth24x7Pct = Number(p.smooth5h24x7Pct ?? 0);
  const burstToWk = Number(p.burstToWkPct ?? (G_PACING_POOL === "3p" ? 50.0 : 25.0));
  const awakeSessions = Number(p.awake5hSessionsLeft ?? 1);
  const calWindows = Number(p.smoothCalWindowsLeft ?? p.burstWindowsLeft ?? 1);
  const maxFinalWk = Number(p.maxFinalWkPct ?? Math.min(100, wkUsed + Number(p.maxReachableAddWkPct || 0)));
  const peak1hWk = Number(p.peak1hWkPct ?? 0);
  const sprintHrs = p.sprintHoursLeft != null ? Number(p.sprintHoursLeft) : null;

  const wkClockPos = Math.min(100, Math.max(0, Number(p.wkElapsedPct || 0)));
  const clockDelta = Math.round(wkUsed - wkClockPos);

  let wkBarColor = "var(--ok)";
  let wkSubTitleHtml = "";
  let wkRightMetaHtml = "";
  if (wkExhausted) {
    wkBarColor = "var(--bad)";
    wkSubTitleHtml = `exhausted · resets in ${esc(resetDisp)}`;
    wkRightMetaHtml = `<span class="mono" style="color:var(--bad);">0% remaining</span>`;
  } else if (wkUnkillable) {
    wkBarColor = "var(--ok)";
    wkSubTitleHtml = `resets in ${esc(resetDisp)} · impossible to exhaust`;
    wkRightMetaHtml = `<span class="mono">${Math.max(0, -clockDelta)}% behind clock = safe surplus</span>`;
  } else if (wkRunOut) {
    wkBarColor = "var(--bad)";
    wkSubTitleHtml = `resets in ${esc(resetDisp)} · ${wkRatio.toFixed(1)}x burn`;
    wkRightMetaHtml = `<span class="mono" style="color:var(--bad);">${clockDelta >= 1 ? `+${clockDelta}% ahead of clock` : `empties in ~${esc(fmtHoursJS(p.wkTteHours))}`}</span>`;
  } else if (wkCaution) {
    wkBarColor = "var(--warn)";
    wkSubTitleHtml = `resets in ${esc(resetDisp)} · ahead of clock`;
    wkRightMetaHtml = `<span class="mono" style="color:var(--warn);">+${Math.max(1, clockDelta)}% ahead · &lt;= ${esc(wkTargetStr)}</span>`;
  } else if (wkProjUnclipped >= 85) {
    wkBarColor = "var(--ok)";
    wkSubTitleHtml = `resets in ${esc(resetDisp)} · on target`;
    wkRightMetaHtml = `<span class="mono">Lands ~${wkProj.toFixed(0)}% at reset</span>`;
  } else {
    wkBarColor = "var(--ok)";
    wkSubTitleHtml = `resets in ${esc(resetDisp)} · ${wkRem.toFixed(1)}% left`;
    wkRightMetaHtml = `<span class="mono">Tracks ~${wkProj.toFixed(0)}% at reset</span>`;
  }

  // Controls cluster (Pool switcher + optional Multi-Surface Source switcher + Fun/Straight/Minimal switcher)
  const controlsHtml = `
    <div class="pacing-controls">
      ${has3p ? `
        <div class="segmented" data-size="sm">
          <button type="button" class="segmented-option" data-active="${G_PACING_POOL === 'gemini'}" onclick="setPacingPool('gemini')" onmouseenter="showQuotaConversionTip(event, 'gemini')" onmouseleave="hideQuotaConversionTip()">
            <span class="dot" data-tone="${gemTone}" style="width:6px;height:6px;"></span>
            <span>Gemini</span>
            <span class="mono micro dim">${Math.round(Number(gemView?.serverWkUsedPct || 0))}%</span>
          </button>
          <button type="button" class="segmented-option" data-active="${G_PACING_POOL === '3p'}" onclick="setPacingPool('3p')" onmouseenter="showQuotaConversionTip(event, '3p')" onmouseleave="hideQuotaConversionTip()">
            <span class="dot" data-tone="${tpTone}" style="width:6px;height:6px;"></span>
            <span>Claude/GPT</span>
            <span class="mono micro dim">${Math.round(Number(tpView?.serverWkUsedPct || 0))}%</span>
          </button>
        </div>
      ` : ""}
      ${isMultiMode ? `
        <div class="segmented" data-size="sm" title="Switch pacing calculation between local CLI setup and account server pool">
          <button type="button" class="segmented-option" data-active="${useLocalSource}" onclick="setPacingSource('local')">This setup</button>
          <button type="button" class="segmented-option" data-active="${!useLocalSource}" onclick="setPacingSource('server')">Server</button>
        </div>
      ` : ""}
      <div class="segmented" data-size="sm" title="Switch pacing guidance style">
        <button type="button" class="segmented-option" data-active="${styleMode === 'fun'}" onclick="setPacingStyle('fun')">Fun</button>
        <button type="button" class="segmented-option" data-active="${styleMode === 'straight'}" onclick="setPacingStyle('straight')">Straight</button>
        <button type="button" class="segmented-option" data-active="${styleMode === 'minimal'}" onclick="setPacingStyle('minimal')">Minimal</button>
      </div>
    </div>
  `;

  // Active-cycle Server vs. Local since-reset breakdown (always ON in Quota tab; optional on Overview)
  const showResetPanel = (targetId === "quotaPacingBody") || !!G_SHOW_RESET_BREAKDOWN;
  const isSrvLive = baseP.sourceActual !== "local_fallback";
  const srv5hPct = Number(baseP.server5hUsedPct ?? 0);
  const loc5hPct = Number(baseP.rawLocal5hUsedPct ?? 0);
  const loc5hReqs = Number(baseP.local5hReqs || 0);
  const oth5hPct = isSrvLive ? Math.max(0, srv5hPct - loc5hPct) : 0;
  const oth5hSub = !isSrvLive ? "server offline" : (loc5hPct > srv5hPct + 0.3 ? "pending sync" : "server - local");

  const srvWkPct = Number(baseP.serverWkUsedPct ?? 0);
  const locWkPct = Number(baseP.rawLocalWkUsedPct ?? 0);
  const locWkReqs = Number(baseP.localWkReqs || 0);
  const othWkPct = isSrvLive ? Math.max(0, srvWkPct - locWkPct) : 0;
  const othWkSub = !isSrvLive ? "server offline" : (locWkPct > srvWkPct + 0.3 ? "pending sync" : "server - local");

  const resetBreakdownHtml = `
    <div class="pacing-reset-breakdown">
      <div class="pacing-reset-col">
        <div class="pacing-reset-head">
          <span class="pacing-reset-title">5h since reset</span>
          <span class="pacing-reset-since">since ${esc(baseP.fhCycleSince || "–")} (${esc(fmtHoursJS(baseP.fhElapsedHours))} ago)</span>
        </div>
        <div class="pacing-reset-metrics">
          <div class="pacing-reset-item">
            <span class="pacing-reset-label">Server used</span>
            <span class="pacing-reset-val">${isSrvLive ? `${srv5hPct.toFixed(1)}%` : "–"}</span>
            <span class="pacing-reset-sub">${isSrvLive ? "live /usage" : "local fallback"}</span>
          </div>
          <div class="pacing-reset-item">
            <span class="pacing-reset-label">Local (this setup)</span>
            <span class="pacing-reset-val">${loc5hPct.toFixed(1)}%</span>
            <span class="pacing-reset-sub">${B(loc5hReqs)} ${loc5hReqs === 1 ? "req" : "reqs"}</span>
          </div>
          <div class="pacing-reset-item">
            <span class="pacing-reset-label">Other surfaces</span>
            <span class="pacing-reset-val">${isSrvLive ? `${oth5hPct.toFixed(1)}%` : "–"}</span>
            <span class="pacing-reset-sub">${esc(oth5hSub)}</span>
          </div>
        </div>
      </div>

      <div class="pacing-reset-col">
        <div class="pacing-reset-head">
          <span class="pacing-reset-title">Weekly since reset</span>
          <span class="pacing-reset-since">since ${esc(baseP.wkCycleSince || "–")} (${esc(fmtHoursJS(baseP.wkElapsedHours))} ago)</span>
        </div>
        <div class="pacing-reset-metrics">
          <div class="pacing-reset-item">
            <span class="pacing-reset-label">Server used</span>
            <span class="pacing-reset-val">${isSrvLive ? `${srvWkPct.toFixed(1)}%` : "–"}</span>
            <span class="pacing-reset-sub">${isSrvLive ? "live /usage" : "local fallback"}</span>
          </div>
          <div class="pacing-reset-item">
            <span class="pacing-reset-label">Local (this setup)</span>
            <span class="pacing-reset-val">${locWkPct.toFixed(1)}%</span>
            <span class="pacing-reset-sub">${B(locWkReqs)} ${locWkReqs === 1 ? "req" : "reqs"}</span>
          </div>
          <div class="pacing-reset-item">
            <span class="pacing-reset-label">Other surfaces</span>
            <span class="pacing-reset-val">${isSrvLive ? `${othWkPct.toFixed(1)}%` : "–"}</span>
            <span class="pacing-reset-sub">${esc(othWkSub)}</span>
          </div>
        </div>
      </div>
    </div>
  `;

  // Minimal (zero-pressure) mode: compact calm 2-bar view, no big coach headline
  if (styleMode === "minimal") {
    if (cardEl) { cardEl.dataset.tone = "neutral"; cardEl.dataset.minimal = "true"; }
    const minFhW = Math.min(100, Math.max(0, fhUsed));
    const minWkW = Math.min(100, Math.max(0, wkUsed));
    el.innerHTML = `
      <div>
        <div class="stack" style="gap:12px; padding:16px 20px;">
          <div class="row" style="justify-content:space-between; flex-wrap:wrap; gap:10px; align-items:center;">
            <span class="muted" style="font-size:13px; font-weight:600;">${esc(poolLabel)} Quota</span>
            ${controlsHtml}
          </div>
          <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(260px, 1fr)); gap:10px;">
            <div style="padding:10px 12px; background:var(--raised); border:1px solid var(--line-1); border-radius:var(--r-control); display:flex; flex-direction:column; gap:6px; cursor:help;" onmouseenter="showQuotaConversionTip(event, '${esc(G_PACING_POOL)}')" onmouseleave="hideQuotaConversionTip()">
              <div class="row" style="justify-content:space-between; font-size:12px;">
                <span class="pacing-tip-trigger" style="color:var(--ink-2); font-weight:500;">${esc(poolLabel)} · 5-Hour Burst</span>
                <span class="mono"><strong style="color:var(--ink-1);">${fhUsed.toFixed(1)}%</strong> <span class="dim">(${fhRem.toFixed(1)}% left · ${esc(burstRefill)})</span></span>
              </div>
              <div style="height:6px; width:100%; background:var(--line-1); border-radius:var(--r-pill); overflow:hidden;">
                <div style="width:${minFhW}%; height:100%; background:${fhUsed >= 90 ? 'var(--bad)' : 'var(--chart-primary)'}; border-radius:var(--r-pill);"></div>
              </div>
            </div>
            <div style="padding:10px 12px; background:var(--raised); border:1px solid var(--line-1); border-radius:var(--r-control); display:flex; flex-direction:column; gap:6px;">
              <div class="row" style="justify-content:space-between; font-size:12px;">
                <span style="color:var(--ink-2); font-weight:500;">${esc(poolLabel)} · Weekly Pool</span>
                <span class="mono"><strong style="color:var(--ink-1);">${wkUsed.toFixed(1)}%</strong> <span class="dim">(${wkRem.toFixed(1)}% left · ${esc(resetDisp)})</span></span>
              </div>
              <div style="height:6px; width:100%; background:var(--line-1); border-radius:var(--r-pill); overflow:hidden; display:flex;">
                ${wkHasDualSeg ? `
                  <div style="width:${wkLocalW}%; height:100%; background:var(--chart-primary);" title="This setup: ${baseP.localWkUsedPct}%"></div>
                  <div style="width:${wkOtherW}%; height:100%; background:var(--chart-secondary); opacity:0.85;" title="Other surfaces: ${baseP.otherWkUsedPct}%"></div>
                ` : `
                  <div style="width:${minWkW}%; height:100%; background:${wkUsed >= 90 ? 'var(--bad)' : 'var(--chart-primary)'}; border-radius:var(--r-pill);"></div>
                `}
              </div>
            </div>
          </div>
        </div>
        ${showResetPanel ? resetBreakdownHtml : ""}
      </div>
    `;
    syncSegmentedThumbs();
    return;
  }

  // Scoreboard cells: (1) Pace to Finish 100%  (2) Smooth 5h Strategy
  const wkMultTxt = wkMultVal != null ? `${wkMultVal < 1 ? wkMultVal.toFixed(2) : wkMultVal.toFixed(1)}x` : null;
  let scorePaceBig = "", scorePaceSub = "";
  if (wkExhausted) {
    scorePaceBig = `0x`;
    scorePaceSub = `wait for reset in ${esc(resetDisp)}`;
  } else if (wkUnkillable) {
    scorePaceBig = (wkMultVal != null && wkMultVal <= 25) ? `${wkMultVal.toFixed(1)}x` : `All-out`;
    scorePaceSub = `your current pace · zero weekly rationing`;
  } else if (wkWarmup) {
    scorePaceBig = `Calibrating`;
    scorePaceSub = `&lt;= ${esc(wkTargetStr)} sustainable ceiling`;
  } else if (wkMultVal != null) {
    scorePaceBig = wkMultTxt;
    if (wkRunOut) {
      scorePaceSub = `your pace · slow down by ${wkCutPct}% (${esc(wkCurStr)} → ${esc(wkTargetStr)})`;
    } else if (wkCaution) {
      scorePaceSub = `your pace · ease off ${wkCutPct}% (${esc(wkCurStr)} → ${esc(wkTargetStr)})`;
    } else if (wkProjUnclipped >= 85) {
      scorePaceSub = `your pace · hold steady (${esc(wkCurStr)} vs ${esc(wkTargetStr)})`;
    } else {
      scorePaceSub = `your pace · can step up (${esc(wkCurStr)} → ${esc(wkTargetStr)})`;
    }
  } else if (wkRunOut || wkCaution) {
    scorePaceBig = `&lt;= ${esc(wkTargetStr)}`;
    scorePaceSub = `your pace · tight runway (${wkRem.toFixed(1)}% for ${esc(resetDisp)})`;
  } else {
    scorePaceBig = `Up to ${esc(wkTargetStr)}`;
    scorePaceSub = `light recent burn · ~${Re(p.estReqsLeft)} reqs left`;
  }

  let scoreSmoothBig = "", scoreSmoothSub = "";
  if (wkExhausted) {
    scoreSmoothBig = `0%`;
    scoreSmoothSub = `per 5h session · resets in ${esc(resetDisp)}`;
  } else if (wkUnkillable || smooth24x7Pct > 100) {
    scoreSmoothBig = `Max 100%`;
    scoreSmoothSub = `every 5h window (~${p.burstWindowsLeft} left · ~${maxFinalWk.toFixed(0)}% wk max)`;
  } else if (smoothSessPct > 100) {
    scoreSmoothBig = `100%`;
    scoreSmoothSub = `per awake 5h session · ~${smooth24x7Pct}% if 24/7`;
  } else {
    scoreSmoothBig = `~${smoothSessPct}%`;
    scoreSmoothSub = `per 5h session (~${awakeSessions.toFixed(0)} awake · ~${smooth24x7Pct}% if 24/7)`;
  }

  // Editorial Hero Headlines + Sub-copy (Fun coach takes vs Straight factual mode)
  let deckTone = "ok";
  let funTakes = [];
  let straightHeadHtml = "";
  let straightSubTxt = "";

  if (wkExhausted || fhExhausted) {
    deckTone = "bad";
    const waitClock = wkExhausted ? resetDisp : burstRefill;
    const which = wkExhausted ? "weekly" : "5-hour burst";
    funTakes = [
      {
        h: `${esc(poolLabel)} tank is at <span class="hl-accent">0.0%</span> — recharge drops in ${esc(waitClock)}.`,
        s: `To squeeze another token out of ${poolLabel}, you have to wait out the ${which} clock or flip over to your other model pool.`
      },
      {
        h: `Pit stop time — <span class="hl-accent">fresh quota lands in ${esc(waitClock)}</span>.`,
        s: `To keep shipping right now while ${poolLabel} ${which} refills, switch model pools or grab a well-earned coffee.`
      }
    ];
    straightHeadHtml = `${esc(poolLabel)} ${which} pool exhausted — <span class="hl-accent">resets in ${esc(waitClock)}</span>.`;
    straightSubTxt = `0.0% remaining in ${which} window. Switch model pool or wait ${waitClock} for refill.`;
  } else if (wkRunOut) {
    deckTone = "bad";
    const wkTte = fmtHoursJS(p.wkTteHours);
    const wkShort = fmtHoursJS(p.wkShortfallHours);
    const multHl = wkMultTxt ? `${wkMultTxt} your pace` : `<= ${wkTargetStr}`;
    const burstWarn = wkLessBurst ? ` Even one full 5h burst (${burstToWk.toFixed(0)}% wk) will drain the weekly pool.` : "";
    const aheadLead = clockDelta >= 5 ? `+${clockDelta}% ahead of the weekly clock (${wkUsed.toFixed(0)}% used with ${resetDisp} left). ` : "";
    funTakes = [
      {
        h: `Hit the brakes — drop to <span class="hl-accent">${esc(multHl)}</span> or run dry ${esc(wkShort)} early.`,
        s: `${aheadLead}To keep ${poolLabel} alive until ${resetDay}'s reset (${wkRem.toFixed(1)}% left), ration ~${smoothSessPct}% per 5h session across ~${awakeSessions.toFixed(0)} awake sessions.${burstWarn}`
      },
      {
        h: `Whoa — ${wkUsed.toFixed(0)}% burned with <span class="hl-accent">${esc(resetDisp)} still on the clock</span>.`,
        s: `At ${wkCurStr}, ${poolLabel} empties in ~${wkTte}. Cap each 5h session near ~${smoothSessPct}% (<= ${wkTargetStr}) to reach ${resetDay} without 429s.${burstWarn}`
      },
      {
        h: `Ration like a Mars rover: aim for <span class="hl-accent">~${smoothSessPct}% per 5h session</span>.`,
        s: `To stretch the remaining ${wkRem.toFixed(1)}% ${poolLabel} quota across ${resetDisp}, dial pace down to ${wkMultTxt || wkTargetStr} and route routine turns to lighter tiers.${burstWarn}`
      }
    ];
    straightHeadHtml = `Reduce ${esc(poolLabel)} pace to <span class="hl-accent">${esc(multHl)}</span> — ${wkUsed.toFixed(0)}% used with ${esc(resetDisp)} left.`;
    straightSubTxt = `${aheadLead}Projected to exhaust ${wkShort} before ${resetDay}'s reset (empties in ~${wkTte}). Cap at <= ${wkTargetStr} (~${smoothSessPct}% per 5h session).${burstWarn}`;
  } else if (fhRunOut) {
    deckTone = "bad";
    const fhTte = fmtHoursJS(p.fhTteHours);
    const fhMultTxt = fhMultVal != null ? `${fhMultVal.toFixed(2)}x burst pace` : `-${fhCutPct}% burst burn`;
    funTakes = [
      {
        h: `Cool the sprint — 5h burst runs dry in <span class="hl-accent">~${esc(fhTte)}</span>.`,
        s: `To reach the ${burstRefill} refill without hitting the rev limiter, ease off to ${fhMultTxt} (<= ${fhSafeHr.toFixed(1)}%/hr). Weekly ${poolLabel} pool is still safe at ${wkRem.toFixed(1)}% left.`
      },
      {
        h: `Ease off to <span class="hl-accent">${esc(fhMultTxt)}</span> until the ${esc(burstRefill)} refill.`,
        s: `To avoid a mandatory 5h pit stop, pace the remaining ~${Re(p.est5hReqsLeft)} reqs in this tank — after refill, ~${smoothSessPct}% per 5h session finishes the week smoothly.`
      }
    ];
    straightHeadHtml = `5-hour ${esc(poolLabel)} burst exhausts in <span class="hl-accent">~${esc(fhTte)}</span> (${esc(fhRateSrc)} pace).`;
    straightSubTxt = `Drop to ${fhMultTxt} (<= ${fhSafeHr.toFixed(1)}%/hr) until refill in ${burstRefill}. Weekly pool remains safe (${wkRem.toFixed(1)}% left).`;
  } else if (wkUnkillable) {
    deckTone = "ok";
    funTakes = [
      {
        h: `Go all-out. <span class="hl-accent">You can't kill this tank</span> before ${esc(resetDay)}'s reset.`,
        s: `To finish as much ${poolLabel} quota as physically possible in the next ${resetDisp}, max 100% of every 5h window — even redlining non-stop still lands near ~${maxFinalWk.toFixed(0)}% weekly.`
      },
      {
        h: `Floor the pedal — <span class="hl-accent">zero weekly rationing</span> needed from here.`,
        s: `To drain ${wkRem.toFixed(1)}% ${poolLabel} weekly in ${resetDisp}, you would have to bend spacetime (${wkMultTxt ? `${wkMultTxt} your pace` : `${p.burstWindowsLeft} windows left`}). Only the 5h burst cap applies.`
      },
      {
        h: `Unleash the subagents — <span class="hl-accent">maxing every 5h window</span> is 100% safe.`,
        s: `To waste as little ${poolLabel} quota as possible before ${resetDay} wipes the slate clean, use ~${Re(p.estReqsLeft)} remaining avg reqs freely.`
      }
    ];
    straightHeadHtml = `Safe to use freely — <span class="hl-accent">weekly exhaustion is unreachable</span> before reset.`;
    straightSubTxt = `Even maxing 100% of every remaining 5h window (${p.burstWindowsLeft} windows in ${resetDisp}) caps weekly total near ~${maxFinalWk.toFixed(0)}%.`;
  } else if (wkWarmup) {
    deckTone = "ok";
    const sPct = Math.min(100, smoothSessPct);
    funTakes = [
      {
        h: `Fresh ${esc(poolLabel)} week — aim for <span class="hl-accent">~${sPct}% per 5h session</span>.`,
        s: `To burn all 100% of this brand-new cycle smoothly without hitting walls, distribute usage across ~${awakeSessions.toFixed(0)} awake sessions (~${Re(p.estReqsLeft)} avg reqs in tank).`
      },
      {
        h: `New cycle unlocked — <span class="hl-accent">${wkRem.toFixed(1)}% runway</span> ready for takeoff.`,
        s: `To lock in a live pace multiplier on ${poolLabel}, ship a few commits first (sustainable cruise speed is ${wkTargetStr} to ${resetDay}).`
      }
    ];
    straightHeadHtml = `Fresh ${esc(poolLabel)} cycle — target <span class="hl-accent">~${sPct}% per 5h session</span>.`;
    straightSubTxt = `Cycle started < 6h ago (${wkRem.toFixed(1)}% left, resets in ${resetDisp}). Sustainable ceiling is ${wkTargetStr}.`;
  } else if (wkCaution) {
    deckTone = "warn";
    const sPct = Math.min(100, smoothSessPct);
    const aheadTxt = clockDelta >= 1 ? `+${clockDelta}% ahead of the weekly clock` : `${wkRem.toFixed(1)}% left for ${resetDisp}`;
    funTakes = [
      {
        h: `Running a bit warm (${esc(aheadTxt)}) — cruise near <span class="hl-accent">~${sPct}% per 5h session</span>.`,
        s: `To glide into ${resetDay}'s reset (${resetDisp} left) without late-week rationing, keep ${poolLabel} burn under ${wkTargetStr} across ~${awakeSessions.toFixed(0)} awake sessions.`
      },
      {
        h: `Ease off the throttle slightly — <span class="hl-accent">${wkRem.toFixed(1)}% left</span> for the next ${esc(resetDisp)}.`,
        s: `${poolLabel} is burning ahead of schedule (${wkCurStr} vs ${wkTargetStr} ceiling). Trim pace to ${wkMultTxt || wkTargetStr} so the runway stays comfortable.`
      }
    ];
    straightHeadHtml = `Ahead of weekly clock (${esc(aheadTxt)}) — <span class="hl-accent">keep &lt;= ${esc(wkTargetStr)}</span>.`;
    straightSubTxt = `${wkUsed.toFixed(1)}% used with ${resetDisp} remaining. Target ~${sPct}% per 5h session across ~${awakeSessions.toFixed(1)} awake sessions to avoid running dry early.`;
  } else if (wkProjUnclipped >= 85) {
    deckTone = "ok";
    const sPct = Math.min(100, smoothSessPct);
    funTakes = [
      {
        h: `Right in the pocket — <span class="hl-accent">hold ${esc(wkMultTxt || "1.0x")} pace</span> to land near 100%.`,
        s: `To finish almost every drop of ${poolLabel} right as ${resetDay}'s reset hits (${resetDisp}), keep cruising near ~${sPct}% per 5h session (~${Re(p.estReqsLeft)} reqs left).`
      },
      {
        h: `On-schedule velocity — tracking <span class="hl-accent">~${wkProj.toFixed(0)}% used</span> by ${esc(resetDay)}.`,
        s: `To extract full value from ${poolLabel} without hitting a single wall, keep this steady rhythm across your ~${awakeSessions.toFixed(0)} remaining awake sessions.`
      }
    ];
    straightHeadHtml = `${esc(poolLabel)} pace is on target — tracking <span class="hl-accent">~${wkProj.toFixed(0)}% at reset</span>.`;
    straightSubTxt = `Hold near ${wkMultTxt || "1.0x"} current pace (~${sPct}% per 5h session across ~${awakeSessions.toFixed(1)} awake sessions · ${resetDisp} left).`;
  } else {
    deckTone = "ok";
    const unused = Math.max(0, 100 - wkProj).toFixed(0);
    const stepHl = wkMultTxt ? `step up ${wkMultTxt}` : `push ~${Math.min(100, smoothSessPct)}% per 5h`;
    const smoothDesc = smoothSessPct > 100 ? `maxing 100% per awake 5h session` : `~${smoothSessPct}% per 5h session across ~${awakeSessions.toFixed(0)} awake sessions`;
    funTakes = [
      {
        h: `Plenty of headroom — <span class="hl-accent">${esc(stepHl)}</span> to use all 100%.`,
        s: `To stop gifting ~${unused}% unused ${poolLabel} quota back on ${resetDay} (${resetDisp} left), ramp up or distribute ${smoothDesc}.`
      },
      {
        h: `~${unused}% ${esc(poolLabel)} surplus on the table — <span class="hl-accent">spin up bigger tasks</span>.`,
        s: `To burn your remaining ${wkRem.toFixed(1)}% cleanly before ${resetDay}, target ${smoothDesc} (~${Re(p.estReqsLeft)} avg reqs waiting).`
      }
    ];
    straightHeadHtml = `${esc(poolLabel)} is under-paced — <span class="hl-accent">${esc(wkMultTxt ? `${wkMultTxt} your pace` : `~${unused}% surplus`)}</span> to reach 100%.`;
    straightSubTxt = `Tracking ~${wkProj.toFixed(0)}% by reset (${resetDisp} left). Smooth 100% target: ${smoothDesc}.`;
  }

  if (cardEl) {
    cardEl.dataset.tone = deckTone;
    cardEl.dataset.minimal = "false";
  }

  const chosenTake = funTakes[G_PACING_QUIP_IDX % funTakes.length];
  const heroHeadHtml = styleMode === "fun" ? chosenTake.h : straightHeadHtml;
  const heroSubTxt = styleMode === "fun" ? chosenTake.s : straightSubTxt;

  const sprintMeta = (sprintHrs != null && peak1hWk > 0)
    ? `~${sprintHrs.toFixed(1)}h at ${peak1hWk.toFixed(2)}%/hr peak sprint`
    : `~${p.burstTanksEquivLeft} full 5h tanks`;
  const compactMetaTxt = G_PACING_BARS
    ? `~${Re(p.estReqsLeft)} avg reqs left · ${sprintMeta}`
    : `${wkRem.toFixed(1)}% wk left · resets in ${resetDisp} · ${sprintMeta}`;

  const fhClockPos = Math.min(100, Math.max(0, Number(p.fhElapsedPct || 0)));
  const fhBarW = Math.min(100, Math.max(0, fhUsed));
  const wkBarW = Math.min(100, Math.max(0, wkUsed));

  const fhLeftMetaHtml = !isMultiMode
    ? (p.sourceActual === "local_fallback"
        ? `Local fallback · since ${esc(p.fhCycleSince)}`
        : (fhUsed <= 0.05 ? `Server 5h pool ready` : `Server 5h pool · since ${esc(p.fhCycleSince)}`))
    : (useLocalSource
        ? `This setup <strong class="mono" style="color:var(--ink-2);">${fhUsed.toFixed(1)}%</strong> · Server total <strong class="mono" style="color:var(--ink-2);">${Number(baseP.server5hUsedPct ?? 0).toFixed(1)}%</strong>`
        : (fhHasDualSeg
            ? `<span class="swatch" style="background:var(--chart-primary);"></span> This setup <strong class="mono" style="color:var(--ink-2);">${baseP.local5hUsedPct}%</strong> &nbsp;·&nbsp; <span class="swatch" style="background:var(--chart-secondary);"></span> Other surfaces <strong class="mono" style="color:var(--ink-2);">${baseP.other5hUsedPct}%</strong>`
            : (fhOtherW >= 1.0
                ? `0% this setup · <strong class="mono" style="color:var(--ink-2);">${baseP.other5hUsedPct}%</strong> other surfaces`
                : (fhUsed <= 0.05 ? `Fresh 5h burst tank ready` : `This setup <strong class="mono" style="color:var(--ink-2);">${baseP.local5hUsedPct}%</strong>`))));

  const wkBurstWarnSpan = wkLessBurst ? ` · <span style="color:var(--bad);">&lt;1 full 5h burst left</span>` : "";
  const wkLeftMetaHtml = !isMultiMode
    ? (p.sourceActual === "local_fallback"
        ? `Local fallback · since ${esc(p.wkCycleSince)}${wkBurstWarnSpan}`
        : `Server pool · since ${esc(p.wkCycleSince)}${wkBurstWarnSpan}`)
    : (useLocalSource
        ? `This setup <strong class="mono" style="color:var(--ink-2);">${wkUsed.toFixed(1)}%</strong> · Server total <strong class="mono" style="color:var(--ink-2);">${Number(baseP.serverWkUsedPct ?? 0).toFixed(1)}%</strong>${wkBurstWarnSpan}`
        : (wkHasDualSeg
            ? `<span class="swatch" style="background:var(--chart-primary);"></span> This setup <strong class="mono" style="color:var(--ink-2);">${baseP.localWkUsedPct}%</strong> &nbsp;·&nbsp; <span class="swatch" style="background:var(--chart-secondary);"></span> Other surfaces <strong class="mono" style="color:var(--ink-2);">${baseP.otherWkUsedPct}%</strong>${wkBurstWarnSpan}`
            : (wkOtherW >= 1.0
                ? `0% this setup · <strong class="mono" style="color:var(--ink-2);">${baseP.otherWkUsedPct}%</strong> other surfaces${wkBurstWarnSpan}`
                : `This setup <strong class="mono" style="color:var(--ink-2);">${baseP.localWkUsedPct}%</strong>${wkBurstWarnSpan}`)));

  el.innerHTML = `
    <div>
      <div class="pacing-hero">
        <div class="pacing-copy">
          <h2 class="pacing-headline">${heroHeadHtml}</h2>
          <p class="pacing-sub">${esc(heroSubTxt)}</p>
          <div class="pacing-actions">
            ${styleMode === "fun" && funTakes.length > 1 ? `
              <button type="button" class="pacing-pill-btn" onclick="cyclePacingQuip()" title="Cycle another coach headline">Next take</button>
            ` : ""}
            <button type="button" class="pacing-pill-btn" data-active="${G_PACING_BARS}" onclick="togglePacingBars()" title="Show or hide the 5-hour and weekly progress bars (saved to config)">
              ${G_PACING_BARS ? "Hide 5h &amp; wk bars" : "Show 5h &amp; wk bars"}
            </button>
            <span class="mono dim pacing-tip-trigger" style="font-size:11.5px;" onmouseenter="showQuotaConversionTip(event, '${esc(G_PACING_POOL)}')" onmouseleave="hideQuotaConversionTip()">${esc(compactMetaTxt)}</span>
          </div>
        </div>

        <div class="pacing-right">
          ${controlsHtml}
          <div class="pacing-scoreboard">
            <div class="pacing-score-cell">
              <span class="pacing-score-label">Pace to finish 100%</span>
              <div class="pacing-score-big" data-tone="accent">${scorePaceBig}</div>
              <span class="pacing-score-sub">${scorePaceSub}</span>
            </div>
            <div class="pacing-score-cell" data-has-tip="true" onmouseenter="showQuotaConversionTip(event, '${esc(G_PACING_POOL)}')" onmouseleave="hideQuotaConversionTip()">
              <span class="pacing-score-label"><span class="pacing-tip-trigger">Smooth 5h strategy</span></span>
              <div class="pacing-score-big">${esc(scoreSmoothBig)}</div>
              <span class="pacing-score-sub">${scoreSmoothSub}</span>
            </div>
          </div>
        </div>
      </div>

      ${G_PACING_BARS ? `
        <div class="pacing-tracks">
          <!-- 5-Hour Burst Track -->
          <div class="pacing-track-col">
            <div class="pacing-track-head" style="cursor:help;" onmouseenter="showQuotaConversionTip(event, '${esc(G_PACING_POOL)}')" onmouseleave="hideQuotaConversionTip()">
              <div class="pacing-track-title">
                <strong class="pacing-tip-trigger">5-Hour Burst</strong>
                <span class="mono dim truncate" style="font-size:11.5px;">${fhSubTitleHtml}</span>
              </div>
              <div class="pacing-track-pct-wrap">
                <span class="pacing-track-pct" style="color:${fhBarColor};">${fhUsed.toFixed(1)}%</span>
                <span class="mono dim" style="font-size:12px;"> / ${fhRem.toFixed(1)}% left</span>
              </div>
            </div>
            <div class="pacing-race-wrap">
              ${_clockPinHtml(fhClockPos)}
              <div class="pacing-race-track">
                ${fhHasDualSeg ? `
                  <div style="width:${fhLocalW}%; height:100%; background:var(--chart-primary);" title="This setup: ${baseP.local5hUsedPct}%"></div>
                  <div style="width:${fhOtherW}%; height:100%; background:var(--chart-secondary); opacity:0.88;" title="Other surfaces: ${baseP.other5hUsedPct}%"></div>
                ` : `
                  <div style="width:${fhBarW}%; height:100%; background:${fhBarColor}; border-radius:var(--r-pill);"></div>
                `}
              </div>
            </div>
            <div class="pacing-track-meta">
              <span>${fhLeftMetaHtml}</span>
              ${fhRightMetaHtml}
            </div>
          </div>

          <!-- Weekly Pool Track -->
          <div class="pacing-track-col">
            <div class="pacing-track-head">
              <div class="pacing-track-title">
                <strong>Weekly Pool</strong>
                <span class="mono dim truncate" style="font-size:11.5px;">${wkSubTitleHtml}</span>
              </div>
              <div class="pacing-track-pct-wrap">
                <span class="pacing-track-pct" style="color:${wkBarColor};">${wkUsed.toFixed(1)}%</span>
                <span class="mono dim" style="font-size:12px;"> / ${wkRem.toFixed(1)}% left</span>
              </div>
            </div>
            <div class="pacing-race-wrap">
              ${_clockPinHtml(wkClockPos)}
              <div class="pacing-race-track">
                ${wkHasDualSeg ? `
                  <div style="width:${wkLocalW}%; height:100%; background:var(--chart-primary);" title="This setup: ${baseP.localWkUsedPct}%"></div>
                  <div style="width:${wkOtherW}%; height:100%; background:var(--chart-secondary); opacity:0.88;" title="Other surfaces: ${baseP.otherWkUsedPct}%"></div>
                ` : `
                  <div style="width:${wkBarW}%; height:100%; background:${wkBarColor}; border-radius:var(--r-pill);"></div>
                `}
              </div>
            </div>
            <div class="pacing-track-meta">
              <span>${wkLeftMetaHtml}</span>
              ${wkRightMetaHtml}
            </div>
          </div>
        </div>
      ` : ""}
      ${showResetPanel ? resetBreakdownHtml : ""}
    </div>
  `;
  syncSegmentedThumbs();
}

function renderTopSessionsOverview() {
  const d = G_FULL_DATA;
  if (!d) return;
  const thead = document.getElementById("topSessionsThead");
  const tbody = document.getElementById("topSessionsTbody");
  if (!thead || !tbody) return;

  thead.innerHTML = `
    <tr>
      <th style="width:48px;">Rank</th>
      <th>Session</th>
      <th>Project</th>
      <th>Model</th>
      <th data-align="right">Requests</th>
      <th data-align="right" title="Average input + cache context tokens per request">Avg context</th>
      <th data-align="right">Cache</th>
      <th data-align="right">Weekly quota</th>
    </tr>
  `;

  const top = (d.sessions || []).slice(0, 8);
  if (!top.length) {
    tbody.innerHTML = '<tr><td colspan="8" class="dim" style="text-align:center;padding:20px;">No sessions in this range</td></tr>';
    return;
  }

  const maxWk = Math.max(...top.map(s => s.pct_week || 0), 0.01);
  tbody.innerHTML = top.map((s, idx) => {
    const barPct = Math.min(100, Math.max(4, ((s.pct_week || 0) / maxWk) * 100)).toFixed(0);
    const isBloated = (s.avgContextTokens || 0) >= 120000;
    return `
      <tr data-clickable="true" onclick="navigateTab('traces'); openSessionTrace('${esc(s.cid)}')">
        <td class="mono micro"><span class="badge" data-tone="${idx === 0 ? 'warn' : (idx < 3 ? 'accent' : 'neutral')}">#${idx + 1}</span></td>
        <td>
          <strong>${esc((s.title || "").slice(0, 44))}</strong>
          ${s.subagents > 0 ? `<span class="mono micro dim" style="margin-left:6px;">+${s.subagents} sub</span>` : ""}
        </td>
        <td class="mono micro dim">${esc(s.workspace)}</td>
        <td class="mono micro">${esc((s.models || [])[0] || "Gemini")}</td>
        <td data-align="right" class="num">${B(s.steps)}</td>
        <td data-align="right" class="num" style="${isBloated ? 'color:var(--warn);font-weight:600;' : ''}" title="${isBloated ? 'High context window size per turn' : ''}">${Re(s.avgContextTokens || 0)}</td>
        <td data-align="right" class="num">${s.cacheRate ?? 0}%</td>
        <td data-align="right" class="num" style="min-width:120px;" title="≈ ${s.pct_5h}% of 5h limit">
          <div class="row" style="justify-content:flex-end; gap:8px;">
            <div style="width:48px; height:6px; background:var(--raised); border-radius:3px; overflow:hidden;">
              <div style="width:${barPct}%; height:100%; background:var(--chart-primary);"></div>
            </div>
            <strong style="color:var(--chart-primary);">${s.pct_week}%</strong>
          </div>
        </td>
      </tr>
    `;
  }).join("");
}

function renderOverviewActivityChart() {
  const ovData = G_OVERVIEW_DATA;
  if (!ovData) return;

  const ts = ovData.timeSeries || [];
  const shortWin = !!ovData.overall?.isShortWindow;
  const el = document.getElementById("activityChart");
  const legendEl = document.getElementById("activityLegend");

  if (!ts.length) {
    el.innerHTML = '<div class="chart-empty" style="display:flex;height:240px;align-items:center;justify-content:center;color:var(--ink-3);">No requests in this range</div>';
    legendEl.innerHTML = "";
    return;
  }

  const n = ts.length;
  const isReq = G_ACTIVITY_METRIC === "requests";
  const isTok = G_ACTIVITY_METRIC === "tokens";
  const maxVal = Math.max(...ts.map(t => isReq ? t.requests : (isTok ? t.tokens : t.pctWeek)), 0.001);

  if (isReq) {
    legendEl.innerHTML = `
      <div class="legend-item"><span class="swatch" style="background:var(--chart-primary);"></span> OK: ${B(ts.reduce((a,b)=>a+(b.requests-b.errors),0))}</div>
      <div class="legend-item"><span class="swatch" style="background:var(--bad);"></span> Failed: ${B(ts.reduce((a,b)=>a+b.errors,0))}</div>
    `;
  } else if (isTok) {
    legendEl.innerHTML = `
      <div class="legend-item"><span class="swatch" style="background:var(--chart-primary);"></span> Tokens: ${Re(ts.reduce((a,b)=>a+b.tokens,0))}</div>
    `;
  } else {
    legendEl.innerHTML = `
      <div class="legend-item"><span class="swatch" style="background:var(--chart-primary);"></span> Weekly quota: ${ovData.overall.pctWeeklySpent}%${shortWin ? ` <span class="dim">(≈ ${ovData.overall.pct5hSpent}% of 5h limit)</span>` : ""}</div>
    `;
  }

  const chartWidth = Math.max(300, Math.round(el.clientWidth || el.getBoundingClientRect().width || 800));
  const chartHeight = 240;
  const topMargin = 12;
  const bottomMargin = 28;
  const baselineY = chartHeight - bottomMargin;
  const plotHeight = baselineY - topMargin;

  const colWidth = chartWidth / n;
  const barW = Math.max(1, Math.min(56, colWidth * (colWidth > 6 ? 0.72 : 0.9)));

  let barsHtml = "";
  ts.forEach((t, i) => {
    const colLeft = i * colWidth;
    const colCenter = (i + 0.5) * colWidth;
    const barX = colCenter - (barW / 2);

    if (isReq) {
      const okH = Math.max(0, Math.round(((t.requests - t.errors) / maxVal) * plotHeight));
      const errH = Math.max(0, Math.round((t.errors / maxVal) * plotHeight));
      const totalH = okH + errH;
      barsHtml += `
        <g class="chart-bar-group" data-idx="${i}" onmouseenter="showChartTip(event, ${i})" onmouseleave="hideChartTip()">
          <rect x="${colLeft.toFixed(1)}" y="0" width="${colWidth.toFixed(1)}" height="${baselineY}" fill="transparent"></rect>
          ${errH > 0 ? `<rect class="chart-bar" x="${barX.toFixed(1)}" y="${(baselineY - totalH).toFixed(1)}" width="${barW.toFixed(1)}" height="${errH}" fill="var(--bad)"></rect>` : ""}
          ${okH > 0 ? `<rect class="chart-bar" x="${barX.toFixed(1)}" y="${(baselineY - okH).toFixed(1)}" width="${barW.toFixed(1)}" height="${okH}" fill="var(--chart-primary)"></rect>` : ""}
        </g>
      `;
    } else {
      const val = isTok ? t.tokens : t.pctWeek;
      const h = val > 0 ? Math.max(2, Math.round((val / maxVal) * plotHeight)) : 0;
      const fill = "var(--chart-primary)";
      barsHtml += `
        <g class="chart-bar-group" data-idx="${i}" onmouseenter="showChartTip(event, ${i})" onmouseleave="hideChartTip()">
          <rect x="${colLeft.toFixed(1)}" y="0" width="${colWidth.toFixed(1)}" height="${baselineY}" fill="transparent"></rect>
          ${h > 0 ? `<rect class="chart-bar" x="${barX.toFixed(1)}" y="${(baselineY - h).toFixed(1)}" width="${barW.toFixed(1)}" height="${h}" fill="${fill}"></rect>` : ""}
        </g>
      `;
    }
  });

  const minLabelWidth = 64;
  const maxLabels = Math.max(1, Math.floor(chartWidth / minLabelWidth));
  const step = Math.max(1, Math.ceil(n / maxLabels));

  let axisTicksHtml = "";
  ts.forEach((t, i) => {
    if (i % step === 0) {
      const colCenter = (i + 0.5) * colWidth;
      axisTicksHtml += `<text x="${colCenter.toFixed(1)}" y="${baselineY + 18}" text-anchor="middle">${esc(t.date)}</text>`;
    }
  });

  el.innerHTML = `
    <svg width="${chartWidth}" height="${chartHeight}" viewBox="0 0 ${chartWidth} ${chartHeight}">
      <line class="chart-baseline" x1="0" y1="${baselineY}" x2="${chartWidth}" y2="${baselineY}"></line>
      ${barsHtml}
      <g class="chart-axis">
        ${axisTicksHtml}
      </g>
    </svg>
    <div class="chart-tooltip" id="chartTooltip"></div>
  `;
}

function showChartTip(e, idx) {
  const ovData = G_OVERVIEW_DATA;
  const ts = ovData?.timeSeries || [];
  const item = ts[idx];
  if (!item) return;

  const tip = document.getElementById("chartTooltip");
  if (!tip) return;

  const shortWin = !!ovData.overall?.isShortWindow;
  tip.innerHTML = `
    <div class="chart-tooltip-title">${esc(item.date)}</div>
    <div class="chart-tooltip-row">
      <span class="swatch" style="background:var(--chart-primary);"></span>
      <span class="chart-tooltip-label">Requests</span>
      <span class="chart-tooltip-value">${B(item.requests)}${item.errors > 0 ? ` (${B(item.errors)} err)` : ""}</span>
    </div>
    <div class="chart-tooltip-row">
      <span class="swatch" style="background:var(--chart-primary);"></span>
      <span class="chart-tooltip-label">Weekly quota</span>
      <span class="chart-tooltip-value">${item.pctWeek}%</span>
    </div>
    ${shortWin ? `
    <div class="chart-tooltip-row">
      <span class="swatch" style="background:var(--chart-secondary);"></span>
      <span class="chart-tooltip-label">5h equiv</span>
      <span class="chart-tooltip-value">${item.pct5h}%</span>
    </div>` : ""}
    <div class="chart-tooltip-row chart-tooltip-total">
      <span class="chart-tooltip-label">Tokens</span>
      <span class="chart-tooltip-value">${Re(item.tokens)}</span>
    </div>
  `;

  const rect = e.currentTarget.getBoundingClientRect();
  const parentRect = document.getElementById("activityChart").getBoundingClientRect();
  tip.style.display = "block";
  tip.style.left = Math.min(parentRect.width - 200, Math.max(8, rect.left - parentRect.left + (rect.width / 2) - 90)) + "px";
  tip.style.top = "10px";
}

function hideChartTip() {
  const tip = document.getElementById("chartTooltip");
  if (tip) tip.style.display = "none";
}

function renderDynamicTokenMix() {
  const ovData = G_OVERVIEW_DATA;
  if (!ovData) return;

  const ov = ovData.overall;
  const totalConv = ov.conversationTokens || 1;

  const segments = [
    { key: "cacheRead", label: "Cache read", value: ov.totalCacheReadTokens, color: "var(--cat-1)" },
    { key: "input", label: "Uncached input", value: ov.totalInputTokens, color: "var(--cat-2)" },
    { key: "output", label: "Output", value: ov.totalOutputTokens, color: "var(--cat-3)" },
    ...(ov.totalCacheWriteTokens > 0 ? [{ key: "cacheWrite", label: "Cache write", value: ov.totalCacheWriteTokens, color: "var(--cat-4)" }] : [])
  ];

  const knownAgentColors = {
    "Lead": "var(--cat-1)",
    "self": "var(--cat-2)",
    "research": "var(--cat-3)",
    "image-generator": "var(--cat-4)",
    "subagent": "var(--cat-5)"
  };
  const extraAgentPalette = [
    "var(--cat-6)", "var(--cat-7)", "var(--cat-8)",
    "var(--cat-5)", "var(--cat-4)", "var(--cat-3)", "var(--cat-2)"
  ];
  const rawAgents = ovData.byAgentType || [];
  const headAgents = rawAgents.length > 6 ? rawAgents.slice(0, 5) : rawAgents;
  const tailAgents = rawAgents.length > 6 ? rawAgents.slice(5) : [];
  const usedAgentColors = new Set();
  for (const ag of headAgents) {
    const c = knownAgentColors[ag.agentType];
    if (c) usedAgentColors.add(c);
  }
  const agentSegments = headAgents.map(ag => {
    let color = knownAgentColors[ag.agentType];
    if (!color) {
      color = extraAgentPalette.find(c => !usedAgentColors.has(c)) || "var(--cat-6)";
      usedAgentColors.add(color);
    }
    return { ...ag, color, tip: ag.agentType };
  });
  if (tailAgents.length) {
    const tailReqs = tailAgents.reduce((s, a) => s + (a.totalRequests || 0), 0);
    const tailToks = tailAgents.reduce((s, a) => s + (a.totalTokens || 0), 0);
    const tailShare = tailAgents.reduce((s, a) => s + (a.share || 0), 0);
    agentSegments.push({
      agentType: `other (${tailAgents.length})`,
      totalRequests: tailReqs,
      totalTokens: tailToks,
      share: tailShare,
      color: "var(--cat-8)",
      tip: tailAgents.map(a => a.agentType).join(", ")
    });
  }

  document.getElementById("tokenMixBody").innerHTML = `
    <div class="stack" style="gap:18px;">
      <div class="stack" style="gap:10px;">
        <div class="share-bar" role="img">
          ${segments.filter(s => s.value > 0).map(s => `
            <div class="share-bar-seg" style="flex-grow:${s.value / totalConv}; background:${s.color};" title="${s.label}: ${He(s.value / totalConv)}"></div>
          `).join("")}
        </div>
        <div class="legend">
          ${segments.map(s => `
            <div class="legend-item">
              <span class="swatch" style="background:${s.color};"></span>
              <span>${s.label}: ${He(s.value / totalConv, 0)}</span>
            </div>
          `).join("")}
        </div>
      </div>

      <div class="stack" style="gap:10px;">
        <div class="section-label">By agent</div>
        <div class="share-bar" role="img">
          ${agentSegments.map(ag => `
            <div class="share-bar-seg" style="flex-grow:${ag.share}; background:${ag.color};" title="${esc(ag.tip || ag.agentType)}: ${He(ag.share)}"></div>
          `).join("")}
        </div>
        <div class="stack" style="gap:8px; margin-top:2px;">
          ${agentSegments.map(ag => `
            <div class="row" style="justify-content:space-between; gap:12px;">
              <span class="row" style="flex:1; min-width:0;">
                <span class="swatch" style="background:${ag.color};"></span>
                <span class="truncate" title="${esc(ag.tip || ag.agentType)}">${esc(ag.agentType)}</span>
                <span class="dim num micro" style="flex-shrink:0;">${B(ag.totalRequests)} req</span>
              </span>
              <span class="row" style="flex-shrink:0;">
                <span class="dim num">${Re(ag.totalTokens)}</span>
                <span class="num" style="min-width:48px; text-align:right;">${He(ag.share)}</span>
              </span>
            </div>
          `).join("")}
        </div>
      </div>
    </div>
  `;
}

function renderDynamicLatestRequests() {
  const ovData = G_OVERVIEW_DATA;
  if (!ovData) return;

  document.getElementById("latestRequestsThead").innerHTML = `
    <tr>
      <th>Model</th>
      <th>When</th>
      <th data-align="right">Tokens</th>
      <th data-align="right">Weekly quota</th>
      <th data-align="right">Duration</th>
      <th data-align="right">Status</th>
    </tr>
  `;

  const reqs = (ovData.recent_requests || []).slice(0, 12);
  if (!reqs.length) {
    document.getElementById("latestRequestsTbody").innerHTML = '<tr><td colspan="6" class="dim" style="text-align:center;padding:16px;">No requests</td></tr>';
    return;
  }

  document.getElementById("latestRequestsTbody").innerHTML = reqs.map(r => `
    <tr data-clickable="true" onclick="openDrawer('${esc(r.id)}')">
      <td>
        <div class="row" style="gap:8px;">
          <strong>${esc(r.model)}</strong>
          <span class="dim micro truncate" style="max-width:160px;">${esc(r.agent || r.project)}</span>
        </div>
      </td>
      <td class="muted">${da(r.ts || r.time)}</td>
      <td data-align="right" class="num">${Re(r.total)}</td>
      <td data-align="right" class="num" title="≈ ${r.pct_5h}% of 5h limit">${r.pct_week}%</td>
      <td data-align="right" class="num">${Rt(r.durationMs)}</td>
      <td data-align="right">
        <span class="badge" data-tone="${r.status === 'error' ? 'bad' : 'ok'}">${r.status === 'error' ? 'Failed' : 'OK'}</span>
      </td>
    </tr>
  `).join("");
}

// Slide-Over Drawers
function openDrawer(reqId) {
  const r = (G_FULL_DATA?.recent_requests || []).find(x => x.id === reqId) ||
            (G_OVERVIEW_DATA?.recent_requests || []).find(x => x.id === reqId);
  if (!r) return;

  document.getElementById("drawerToneBadge").textContent = r.status === "error" ? "Failed" : "OK";
  document.getElementById("drawerToneBadge").setAttribute("data-tone", r.status === "error" ? "bad" : "ok");
  document.getElementById("drawerTitle").textContent = r.model;
  document.getElementById("drawerSubtitle").textContent = `${(r.time || "").slice(0, 19).replace("T", " ")} · ${r.agent}`;

  document.getElementById("drawerBody").innerHTML = `
    <div class="stat-grid" style="--stat-min:120px;">
      <div class="stat" data-size="sm">
        <div class="stat-label">Weekly quota</div>
        <div class="stat-value" style="color:var(--chart-primary);">${r.pct_week}%</div>
        <div class="stat-foot">≈ ${r.pct_5h}% of 5h</div>
      </div>
      <div class="stat" data-size="sm">
        <div class="stat-label">In / Out / Cache</div>
        <div class="stat-value" style="font-size:13px;">${Re(r.in)} / ${Re(r.out)} / ${Re(r.cache)}</div>
      </div>
      <div class="stat" data-size="sm">
        <div class="stat-label">Duration</div>
        <div class="stat-value">${Rt(r.durationMs)}</div>
      </div>
    </div>

    <div class="stack" style="gap:6px;">
      <div class="section-label">Session</div>
      <div class="card" style="padding:12px;">
        <div class="row" style="justify-content:space-between;">
          <div style="font-weight:600;">${esc(r.title)}</div>
          <button class="btn" data-size="sm" data-variant="ghost" onclick="closeDrawer(); navigateTab('traces'); openSessionTrace('${esc(r.cid)}')">Trace →</button>
        </div>
        <div class="mono micro dim" style="margin-top:4px;">${esc(r.project)} · ${esc(r.cid.slice(0, 12))}</div>
      </div>
    </div>

    <div class="stack" style="gap:6px;">
      <div class="section-label">Tools (${r.tools ? r.tools.length : 0})</div>
      <pre class="code-block">${esc(r.tools && r.tools.length ? r.tools.join("\n") : "None")}</pre>
    </div>

    <div class="stack" style="gap:6px;">
      <div class="section-label">Preview</div>
      <pre class="code-block">${esc(r.preview)}</pre>
    </div>
  `;

  document.getElementById("drawerScrim").classList.add("open");
  document.getElementById("sideDrawer").classList.add("open");
}

function openErrorDrawer(errIdx) {
  const e = (G_FULL_DATA?.errors || [])[errIdx];
  if (!e) return;

  document.getElementById("drawerToneBadge").textContent = "Error";
  document.getElementById("drawerToneBadge").setAttribute("data-tone", "bad");
  document.getElementById("drawerTitle").textContent = e.signature || "Execution Error";
  document.getElementById("drawerSubtitle").textContent = `${(e.time || "").slice(0, 19).replace("T", " ")} · ${e.model}`;

  document.getElementById("drawerBody").innerHTML = `
    <div class="stack" style="gap:6px;">
      <div class="section-label">Session</div>
      <div class="card" style="padding:12px;">
        <div class="row" style="justify-content:space-between;">
          <div style="font-weight:600;">${esc(e.title)}</div>
          <button class="btn" data-size="sm" data-variant="ghost" onclick="closeDrawer(); navigateTab('traces'); openSessionTrace('${esc(e.cid)}')">Trace →</button>
        </div>
        <div class="mono micro dim" style="margin-top:4px;">${esc(e.cid)} · step ${e.step ?? 0}</div>
      </div>
    </div>
    <div class="stack" style="gap:6px;">
      <div class="section-label">Output</div>
      <pre class="code-block" style="max-height:420px;">${esc(e.fullMsg || e.msg)}</pre>
    </div>
  `;

  document.getElementById("drawerScrim").classList.add("open");
  document.getElementById("sideDrawer").classList.add("open");
}

function openSpanDrawer(spanIdx) {
  const sp = (G_CURRENT_TRACE?.spans || [])[spanIdx];
  if (!sp) return;

  document.getElementById("drawerToneBadge").textContent = sp.isError ? "Failed" : sp.agent;
  document.getElementById("drawerToneBadge").setAttribute("data-tone", sp.isError ? "bad" : (sp.kind === "user" ? "accent" : "ok"));
  document.getElementById("drawerTitle").textContent = `${sp.model} · step ${sp.step}`;
  document.getElementById("drawerSubtitle").textContent = `${(sp.time || "").slice(0, 19).replace("T", " ")} · ${sp.cid.slice(0, 8)}`;

  document.getElementById("drawerBody").innerHTML = `
    <div class="stat-grid" style="--stat-min:120px;">
      <div class="stat" data-size="sm"><div class="stat-label">Weekly quota</div><div class="stat-value" style="color:var(--chart-primary);">${sp.pctWeek}%</div>${sp.total > 0 ? `<div class="stat-foot">≈ ${sp.pct5h}% of 5h</div>` : ""}</div>
      <div class="stat" data-size="sm"><div class="stat-label">Tokens</div><div class="stat-value">${Re(sp.total)}</div></div>
      <div class="stat" data-size="sm"><div class="stat-label">Duration</div><div class="stat-value">${Rt(sp.durationMs)}</div></div>
    </div>
    ${sp.tools && sp.tools.length ? `
    <div class="stack" style="gap:6px;">
      <div class="section-label">Tools (${sp.tools.length})</div>
      <pre class="code-block">${esc(sp.tools.join("\n"))}</pre>
    </div>` : ""}
    <div class="stack" style="gap:6px;">
      <div class="section-label">Content</div>
      <pre class="code-block" style="max-height:380px;">${esc(sp.preview)}</pre>
    </div>
  `;
  document.getElementById("drawerScrim").classList.add("open");
  document.getElementById("sideDrawer").classList.add("open");
}

function closeDrawer() {
  document.getElementById("drawerScrim").classList.remove("open");
  document.getElementById("sideDrawer").classList.remove("open");
}

// Render Individual Panes Safely
function renderRequestsPane() {
  const d = G_FULL_DATA;
  if (!d) return;
  const q = (document.getElementById("reqSearchInput")?.value || "").trim().toLowerCase();

  document.getElementById("requestsFullThead").innerHTML = `
    <tr>
      <th>When</th>
      <th>Session</th>
      <th>Project</th>
      <th>Model</th>
      <th data-align="right">Tools</th>
      <th data-align="right">Tokens</th>
      <th data-align="right">Weekly quota</th>
      <th data-align="right">Duration</th>
      <th data-align="right">Status</th>
    </tr>
  `;

  const filtered = (d.recent_requests || []).filter(r => {
    if (G_REQ_STATUS_FILTER !== "all" && r.status !== G_REQ_STATUS_FILTER) return false;
    if (!q) return true;
    const hay = `${r.model} ${r.title} ${r.project} ${r.agent} ${(r.tools || []).join(" ")}`.toLowerCase();
    return hay.includes(q);
  });

  if (!filtered.length) {
    document.getElementById("requestsFullTbody").innerHTML = '<tr><td colspan="9" class="dim" style="text-align:center;padding:24px;">No matching requests</td></tr>';
    return;
  }

  document.getElementById("requestsFullTbody").innerHTML = filtered.slice(0, 200).map(r => `
    <tr data-clickable="true" onclick="openDrawer('${esc(r.id)}')">
      <td class="mono muted micro">${esc((r.time || "").slice(5, 19).replace("T", " "))}</td>
      <td><strong>${esc((r.title || "").slice(0, 38))}</strong></td>
      <td class="mono micro dim">${esc(r.project)}</td>
      <td class="mono micro">${esc(r.model)}</td>
      <td data-align="right" class="num">${(r.tools || []).length}</td>
      <td data-align="right" class="num">${Re(r.total)}</td>
      <td data-align="right" class="num" title="≈ ${r.pct_5h}% of 5h limit">${r.pct_week}%</td>
      <td data-align="right" class="num">${Rt(r.durationMs)}</td>
      <td data-align="right"><span class="badge" data-tone="${r.status === 'error' ? 'bad' : 'ok'}">${r.status === 'error' ? 'Failed' : 'OK'}</span></td>
    </tr>
  `).join("");
}

function renderErrorsPane() {
  const d = G_FULL_DATA;
  if (!d) return;
  const errs = d.errors || [];
  const sigs = d.error_signatures || [];
  const affectedSessions = new Set(errs.map(e => e.cid)).size;

  document.getElementById("errorsStatGrid").innerHTML = `
    <div class="stat" data-size="sm"><div class="stat-label">Failures</div><div class="stat-value" style="color:var(--bad);">${B(errs.length)}</div></div>
    <div class="stat" data-size="sm"><div class="stat-label">Signatures</div><div class="stat-value">${B(sigs.length)}</div></div>
    <div class="stat" data-size="sm"><div class="stat-label">Sessions</div><div class="stat-value">${B(affectedSessions)}</div></div>
  `;

  document.getElementById("errorSigTbody").innerHTML = sigs.length ? sigs.map(s => `
    <tr>
      <td class="mono micro"><strong>${esc(s.signature)}</strong></td>
      <td data-align="right" class="num"><span class="badge" data-tone="bad">${s.count}</span></td>
      <td class="mono micro">${esc(s.topModel)}</td>
      <td data-align="right" class="muted micro">${da(s.latest)}</td>
    </tr>
  `).join("") : '<tr><td colspan="4" class="dim" style="text-align:center;padding:20px;">No errors</td></tr>';

  document.getElementById("errorLogTbody").innerHTML = errs.length ? errs.slice(0, 100).map((e, idx) => `
    <tr data-clickable="true" onclick="openErrorDrawer(${idx})">
      <td class="mono muted micro">${esc((e.time || "").slice(5, 19).replace("T", " "))}</td>
      <td><strong>${esc((e.title || "").slice(0, 36))}</strong></td>
      <td class="mono micro">${esc(e.model)}</td>
      <td class="mono micro" style="color:var(--bad);">${esc(e.msg)}</td>
    </tr>
  `).join("") : '<tr><td colspan="4" class="dim" style="text-align:center;padding:20px;">No failures</td></tr>';
}

function renderTracesPane() {
  const d = G_FULL_DATA;
  if (!d) return;
  const q = (document.getElementById("traceSearchInput")?.value || "").trim().toLowerCase();

  document.getElementById("tracesSessionsThead").innerHTML = `
    <tr>
      <th style="width:48px;">Rank</th>
      <th>Session</th>
      <th>Agent</th>
      <th>Model</th>
      <th data-align="right">Requests</th>
      <th data-align="right" title="Average input + cache context tokens per request">Avg context</th>
      <th data-align="right">Cache</th>
      <th data-align="right">Tokens</th>
      <th data-align="right">Weekly quota</th>
    </tr>
  `;

  let sessions = (d.sessions || []).filter(s => {
    if (!q) return true;
    return `${s.title} ${s.workspace} ${s.agent} ${s.cid} ${(s.models || []).join(" ")}`.toLowerCase().includes(q);
  });

  if (G_TRACE_SORT === "bloat") {
    sessions = sessions.slice().sort((a, b) => (b.avgContextTokens || 0) - (a.avgContextTokens || 0));
  } else if (G_TRACE_SORT === "requests") {
    sessions = sessions.slice().sort((a, b) => (b.steps || 0) - (a.steps || 0));
  } else if (G_TRACE_SORT === "recent") {
    sessions = sessions.slice().sort((a, b) => (b.last_ts || 0) - (a.last_ts || 0));
  } else {
    sessions = sessions.slice().sort((a, b) => (b.units || 0) - (a.units || 0));
  }

  if (!sessions.length) {
    document.getElementById("tracesSessionsTbody").innerHTML = '<tr><td colspan="9" class="dim" style="text-align:center;padding:24px;">No sessions</td></tr>';
    return;
  }

  const maxWk = Math.max(...sessions.map(s => s.pct_week || 0), 0.01);
  document.getElementById("tracesSessionsTbody").innerHTML = sessions.slice(0, 100).map((s, idx) => {
    const barPct = Math.min(100, Math.max(4, ((s.pct_week || 0) / maxWk) * 100)).toFixed(0);
    const isBloated = (s.avgContextTokens || 0) >= 120000;
    return `
    <tr data-clickable="true" onclick="openSessionTrace('${esc(s.cid)}')">
      <td class="mono micro"><span class="badge" data-tone="${idx === 0 ? 'warn' : (idx < 3 ? 'accent' : 'neutral')}">#${idx + 1}</span></td>
      <td>
        <strong>${esc((s.title || "").slice(0, 52))}</strong>
        <div class="mono micro dim">${esc(s.workspace)} · ${esc(s.cid.slice(0, 8))}${s.subagents > 0 ? ` · ${s.subagents} subagents` : ""}</div>
      </td>
      <td><span class="badge" data-tone="${s.agent === 'Lead' ? 'accent' : 'ok'}">${esc(s.agent)}</span></td>
      <td class="mono micro">${esc((s.models || [])[0] || "Gemini")}</td>
      <td data-align="right" class="num">${B(s.steps)}</td>
      <td data-align="right" class="num" style="${isBloated ? 'color:var(--warn);font-weight:600;' : ''}">${Re(s.avgContextTokens || 0)}</td>
      <td data-align="right" class="num">${s.cacheRate ?? 0}%</td>
      <td data-align="right" class="num">${Re(s.total)}</td>
      <td data-align="right" class="num" style="min-width:125px;" title="≈ ${s.pct_5h}% of 5h limit">
        <div class="row" style="justify-content:flex-end; gap:8px;">
          <div style="width:48px; height:6px; background:var(--raised); border-radius:3px; overflow:hidden;">
            <div style="width:${barPct}%; height:100%; background:var(--chart-primary);"></div>
          </div>
          <strong style="color:var(--chart-primary);">${s.pct_week}%</strong>
        </div>
      </td>
    </tr>
  `;
  }).join("");
}

function closeSessionTrace() {
  G_CURRENT_TRACE = null;
  document.getElementById("traceDetailContainer").style.display = "none";
  document.getElementById("tracesListContainer").style.display = "flex";
}

async function openSessionTrace(cid) {
  const listEl = document.getElementById("tracesListContainer");
  const detEl = document.getElementById("traceDetailContainer");
  const prog = document.getElementById("topbarProgress");
  listEl.style.display = "none";
  detEl.style.display = "flex";
  if (prog) prog.dataset.loading = "true";
  detEl.innerHTML = `
    <div class="row rise" style="gap:8px;">
      <button class="btn" data-size="sm" data-variant="ghost" onclick="closeSessionTrace()">← Traces</button>
    </div>
    <div class="skeleton rise" style="--i:1; width:100%; height:420px; border-radius:8px;"></div>
  `;

  try {
    const res = await fetch(`/api/trace?cid=${encodeURIComponent(cid)}`);
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    const tr = await res.json();
    G_CURRENT_TRACE = tr;

    const spanColor = sp => {
      if (sp.isError) return "var(--bad)";
      if (sp.kind === "user") return "var(--cat-3)";
      if (sp.kind === "subagent" || sp.agent !== "Lead") return "var(--cat-2)";
      return "var(--cat-1)";
    };

    detEl.innerHTML = `
      <div class="page-header rise">
        <div class="stack" style="gap:4px;">
          <div class="row" style="gap:8px;">
            <button class="btn" data-size="sm" data-variant="ghost" onclick="closeSessionTrace()">← Traces</button>
            ${tr.parent ? `<button class="btn" data-size="sm" data-variant="ghost" onclick="openSessionTrace('${esc(tr.parent)}')">↑ Parent</button>` : ""}
            <span class="badge" data-tone="accent">${esc(tr.agent)}</span>
          </div>
          <h1 class="page-title" style="margin-top:4px;">${esc(tr.title)}</h1>
          <div class="mono micro dim">${esc(tr.workspace)} · ${esc(tr.cid)}</div>
        </div>
      </div>

      <div class="stat-grid rise" style="--stat-min:150px; --i:1;">
        <div class="stat" data-size="sm"><div class="stat-label">Weekly quota</div><div class="stat-value" style="color:var(--chart-primary);">${tr.pctWeek}%</div><div class="stat-foot">≈ ${tr.pct5h}% of 5h limit</div></div>
        <div class="stat" data-size="sm"><div class="stat-label">Tokens</div><div class="stat-value">${Re(tr.totalTokens)}</div></div>
        <div class="stat" data-size="sm"><div class="stat-label">Spans</div><div class="stat-value">${B(tr.stepsCount)}</div></div>
        <div class="stat" data-size="sm"><div class="stat-label">Tools</div><div class="stat-value">${B(tr.toolsCount)}</div></div>
        <div class="stat" data-size="sm"><div class="stat-label">Duration</div><div class="stat-value">${Rt(tr.durationMs)}</div></div>
      </div>

      ${tr.subagents && tr.subagents.length ? `
      <div class="card rise" style="--i:2; padding:12px 16px;">
        <div class="row" style="gap:8px; flex-wrap:wrap;">
          <span class="section-label" style="margin-right:4px;">Subagents</span>
          ${tr.subagents.map(c => `
            <button class="btn" data-size="sm" data-variant="ghost" onclick="openSessionTrace('${esc(c.cid)}')">
              ${esc(c.agent)} · ${esc(c.cid.slice(0, 8))} →
            </button>
          `).join("")}
        </div>
      </div>` : ""}

      <div class="card rise" style="--i:${tr.subagents && tr.subagents.length ? 3 : 2};">
        <header class="card-header">
          <h2 class="card-title">Timeline</h2>
          <div class="legend">
            <span class="legend-item"><span class="swatch" style="background:var(--cat-3);"></span> User</span>
            <span class="legend-item"><span class="swatch" style="background:var(--cat-1);"></span> Lead</span>
            <span class="legend-item"><span class="swatch" style="background:var(--cat-2);"></span> Subagent</span>
            <span class="legend-item"><span class="swatch" style="background:var(--bad);"></span> Error</span>
          </div>
        </header>
        <div class="card-body" data-flush="true">
          <div class="table-wrap">
            <table class="table" data-dense="true">
              <thead>
                <tr>
                  <th>Step</th>
                  <th>Actor</th>
                  <th style="width:28%;">Waterfall</th>
                  <th>Summary / Tools</th>
                  <th data-align="right">Tokens</th>
                  <th data-align="right">Duration</th>
                </tr>
              </thead>
              <tbody>
                ${(tr.spans || []).map((sp, idx) => `
                  <tr data-clickable="true" onclick="openSpanDrawer(${idx})">
                    <td class="mono micro dim">#${sp.step}</td>
                    <td>
                      <div class="row" style="gap:6px;">
                        <span class="swatch" style="background:${spanColor(sp)};"></span>
                        <span class="mono micro">${esc(sp.kind === 'user' ? 'User' : sp.model)}</span>
                      </div>
                    </td>
                    <td>
                      <div class="wf-track">
                        <div class="wf-bar" style="left:${sp.offsetPct}%; width:${sp.widthPct}%; background:${spanColor(sp)};"></div>
                      </div>
                    </td>
                    <td class="mono micro truncate" style="max-width:280px; ${sp.isError ? 'color:var(--bad);' : ''}">
                      ${esc(sp.tools && sp.tools.length ? sp.tools.join(", ") : sp.preview.slice(0, 80))}
                    </td>
                    <td data-align="right" class="num micro">${sp.total > 0 ? Re(sp.total) : "–"}</td>
                    <td data-align="right" class="num micro">${Rt(sp.durationMs)}</td>
                  </tr>
                `).join("")}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    `;
  } catch (err) {
    detEl.innerHTML = `
      <div class="row rise" style="gap:8px;">
        <button class="btn" data-size="sm" data-variant="ghost" onclick="closeSessionTrace()">← Traces</button>
      </div>
      <div class="card rise" style="padding:24px;color:var(--bad);">Failed to load trace: ${esc(err.message)}</div>
    `;
  } finally {
    if (prog && G_SYNC_PHASE !== "syncing") prog.dataset.loading = "false";
  }
}

function renderFullViews() {
  const d = G_FULL_DATA;
  if (!d) return;

  // Models
  try {
    document.getElementById("modelsFullThead").innerHTML = `
      <tr>
        <th>Model</th>
        <th data-align="right">Requests</th>
        <th data-align="right">Input</th>
        <th data-align="right">Output</th>
        <th data-align="right">Cache read</th>
        <th data-align="right">Median / p95</th>
        <th data-align="right">Weekly quota</th>
      </tr>
    `;
    const mEntries = Object.entries(d.models || {});
    document.getElementById("modelsFullTbody").innerHTML = mEntries.length ? mEntries.map(([m, v]) => `
      <tr>
        <td class="mono">
          <strong>${esc(m)}</strong>
          ${v.is3p ? `<span class="badge" data-tone="neutral" style="margin-left:6px; height:18px; font-size:11px;">Claude/GPT</span>` : ""}
        </td>
        <td data-align="right" class="num">${B(v.steps)}</td>
        <td data-align="right" class="num">${Re(v.in)}</td>
        <td data-align="right" class="num">${Re(v.out)}</td>
        <td data-align="right" class="num">${Re(v.cache)}</td>
        <td data-align="right" class="num">${Rt(v.medianMs)} / ${Rt(v.p95Ms)}</td>
        <td data-align="right" class="num" style="color:var(--chart-primary); font-weight:600;" title="≈ ${v.pct_5h}% of 5h limit · ${v.is3p ? 'Claude & GPT pool' : 'Gemini pool'}">${v.pct_week}%</td>
      </tr>
    `).join("") : '<tr><td colspan="7" class="dim" style="text-align:center;padding:20px;">No models</td></tr>';
  } catch (e) { console.error("Models render error", e); }

  // Quota
  try {
    renderQuotaPoolsGrid();
    renderPacingSection("quotaPacingBody");

    document.getElementById("quotaLedgerTbody").innerHTML = Object.entries(d.daily || {}).reverse().map(([dt, v]) => `
      <tr>
        <td class="mono"><strong>${esc(dt)}</strong></td>
        <td data-align="right" class="num">${B(v.steps)}</td>
        <td data-align="right" class="num">${Re(v.in)}</td>
        <td data-align="right" class="num">${Re(v.out)}</td>
        <td data-align="right" class="num">${Re(v.cache)}</td>
        <td data-align="right" class="num">${Re(v.total)}</td>
        <td data-align="right" class="num" style="color:var(--chart-primary); font-weight:600;" title="≈ ${v.pct_5h ?? 0}% of 5h limit">${v.pct_week ?? 0}%</td>
      </tr>
    `).join("");
  } catch (e) { console.error("Quota render error", e); }

  // Activity: Requests, Errors, Traces
  try { renderRequestsPane(); } catch (e) { console.error("Requests render error", e); }
  try { renderErrorsPane(); } catch (e) { console.error("Errors render error", e); }
  try { renderTracesPane(); } catch (e) { console.error("Traces render error", e); }

  // Tools
  try {
    document.getElementById("toolsDetailedThead").innerHTML = `
      <tr>
        <th>Tool</th>
        <th>Model</th>
        <th data-align="right">Calls</th>
        <th data-align="right">Errors</th>
        <th data-align="right">Result chars</th>
        <th data-align="right">Avg / call</th>
        <th data-align="right">Tokens</th>
        <th data-align="right">Weekly quota</th>
      </tr>
    `;
    const tList = d.tools_detailed || [];
    document.getElementById("toolsDetailedTbody").innerHTML = tList.length ? tList.map(t => `
      <tr>
        <td class="mono"><strong>${esc(t.tool)}</strong></td>
        <td class="mono micro">${esc(t.topModel)}</td>
        <td data-align="right" class="num">${B(t.calls)}</td>
        <td data-align="right" class="num">${t.errors > 0 ? `<span class="badge" data-tone="bad">${t.errors}</span>` : "0"}</td>
        <td data-align="right" class="num">${Re(t.resultChars)}</td>
        <td data-align="right" class="num">${Re(t.avgResultChars)}</td>
        <td data-align="right" class="num">${Re(t.tokensShare)}</td>
        <td data-align="right" class="num" style="color:var(--chart-primary);" title="≈ ${t.pct5hShare}% of 5h limit">${t.pctWeekShare}%</td>
      </tr>
    `).join("") : '<tr><td colspan="8" class="dim" style="text-align:center;padding:20px;">No tool calls</td></tr>';
  } catch (e) { console.error("Tools render error", e); }

  // Frustration
  try {
    const totFrust = (d.frustrations || []).length;
    const rate = d.total_user_turns > 0 ? ((totFrust / d.total_user_turns) * 100).toFixed(1) : "0.0";
    document.getElementById("frustrationStatGrid").innerHTML = `
      <div class="stat"><div class="stat-label">Frustration rate</div><div class="stat-value">${rate}%</div><div class="stat-foot">${totFrust} signals · ${d.total_user_turns} turns</div></div>
      ${Object.entries(d.frustration_categories || {}).map(([cat, cnt]) => `
        <div class="stat" data-size="sm"><div class="stat-label">${esc(cat)}</div><div class="stat-value">${cnt}</div></div>
      `).join("")}
    `;

    const fList = (d.frustrations || []).slice(0, 80);
    document.getElementById("frustrationEventsTbody").innerHTML = fList.length ? fList.map(f => `
      <tr>
        <td class="mono muted micro">${esc((f.time || "").slice(5, 19).replace("T", " "))}</td>
        <td><span class="badge" data-tone="warn">${esc(f.category)}</span></td>
        <td class="mono micro">${esc(f.model || "Gemini")}</td>
        <td><strong>${esc((f.title || "").slice(0, 36))}</strong></td>
        <td class="mono micro">${esc(f.detail)}</td>
      </tr>
    `).join("") : '<tr><td colspan="5" class="dim" style="text-align:center;padding:20px;">No signals</td></tr>';
  } catch (e) { console.error("Frustration render error", e); }

  // Projects
  try {
    document.getElementById("projectsFullThead").innerHTML = `
      <tr>
        <th>Project</th>
        <th data-align="right">Sessions</th>
        <th data-align="right">Requests</th>
        <th data-align="right">Failures</th>
        <th data-align="right">Cache rate</th>
        <th data-align="right">Tokens</th>
        <th data-align="right">Weekly quota</th>
      </tr>
    `;
    const pList = d.projects || [];
    document.getElementById("projectsFullTbody").innerHTML = pList.length ? pList.map(p => `
      <tr>
        <td class="mono"><strong>${esc(p.project)}</strong></td>
        <td data-align="right" class="num">${B(p.sessions)}</td>
        <td data-align="right" class="num">${B(p.requests)}</td>
        <td data-align="right" class="num">${p.errors}</td>
        <td data-align="right" class="num">${p.cacheRate}%</td>
        <td data-align="right" class="num">${Re(p.total)}</td>
        <td data-align="right" class="num" style="color:var(--chart-primary); font-weight:600;" title="≈ ${p.pct_5h}% of 5h limit">${p.pct_week}%</td>
      </tr>
    `).join("") : '<tr><td colspan="7" class="dim" style="text-align:center;padding:20px;">No projects</td></tr>';
  } catch (e) { console.error("Projects render error", e); }
}

// Keyboard Shortcuts
let lastG = 0;
window.addEventListener("keydown", (e) => {
  if (e.key === "Escape") { closeDrawer(); closeSettingsModal(); return; }
  if (["INPUT", "TEXTAREA"].includes(document.activeElement?.tagName)) return;

  const k = e.key.toLowerCase();
  if (k === "g") { lastG = Date.now(); return; }
  if (Date.now() - lastG < 850) {
    lastG = 0;
    const map = { o: "overview", m: "models", q: "quota", r: "requests", e: "errors", t: "traces", l: "tools", f: "frustration", p: "projects", s: "settings" };
    if (map[k]) {
      e.preventDefault();
      if (map[k] === "settings") openSettingsModal();
      else navigateTab(map[k]);
      return;
    }
  }
  if (k === "1") setTimeRange("1h");
  else if (k === "2") setTimeRange("5h");
  else if (k === "3") setTimeRange("24h");
  else if (k === "4") setTimeRange("7d");
  else if (k === "5") setTimeRange("30d");
  else if (k === "6") setTimeRange("90d");
  else if (k === "7") setTimeRange("all");
  else if (k === "8") setTimeRange("custom");
});

// Settings & Preferences
let G_SETTINGS = null;

function applyOnboardingPreset(presetKey) {
  let mode = "web";
  let openBrowser = true;
  let cliView = "overview";
  let pacingStyle = "fun";
  let disabledSections = [];

  if (presetKey === "full_web") {
    mode = "web";
    openBrowser = true;
    cliView = "overview";
    pacingStyle = "fun";
    disabledSections = [];
  } else if (presetKey === "minimalist") {
    mode = "web";
    openBrowser = true;
    cliView = "overview";
    pacingStyle = "minimal";
    disabledSections = ["sessions", "requests", "tools", "frustration"];
  } else if (presetKey === "cli_minimalist") {
    mode = "cli";
    openBrowser = false;
    cliView = "overview";
    pacingStyle = "straight";
    disabledSections = ["sessions", "requests", "tools", "frustration"];
  } else if (presetKey === "cli_tokens") {
    mode = "cli";
    openBrowser = false;
    cliView = "tokens";
    pacingStyle = "minimal";
    disabledSections = [];
  }

  const webRadio = document.getElementById("settingModeWeb");
  const cliRadio = document.getElementById("settingModeCli");
  if (webRadio) webRadio.checked = (mode === "web");
  if (cliRadio) cliRadio.checked = (mode === "cli");

  const brCheck = document.getElementById("settingOpenBrowser");
  if (brCheck) brCheck.checked = openBrowser;

  const rQSrv = document.getElementById("settingQuotaServer");
  const rQMul = document.getElementById("settingQuotaMulti");
  if (rQSrv) rQSrv.checked = true;
  if (rQMul) rQMul.checked = false;
  const rbCheck = document.getElementById("settingResetBreakdown");
  if (rbCheck) rbCheck.checked = false;

  const rFun = document.getElementById("settingPacingFun");
  const rStr = document.getElementById("settingPacingStraight");
  const rMin = document.getElementById("settingPacingMinimal");
  if (rFun) rFun.checked = (pacingStyle === "fun");
  if (rStr) rStr.checked = (pacingStyle === "straight");
  if (rMin) rMin.checked = (pacingStyle === "minimal");

  const selView = document.getElementById("settingCliView");
  if (selView) selView.value = cliView;

  const disCliSet = new Set(disabledSections.map(x => String(x).toLowerCase()));
  document.querySelectorAll(".setting-cli-toggle").forEach(cb => {
    cb.checked = !disCliSet.has(cb.value.toLowerCase());
  });
}

async function fetchSettings() {
  try {
    const res = await fetch("/api/settings");
    if (res.ok) {
      G_SETTINGS = await res.json();
      applySettings(G_SETTINGS);
      if (G_SETTINGS && G_SETTINGS.onboarded === false) {
        openSettingsModal(true);
      }
    }
  } catch (e) {
    console.warn("Could not fetch settings:", e);
  }
}

function applySettings(cfg) {
  if (!cfg) return;
  let needPacingRender = false;
  const qMode = cfg.web?.quota_mode;
  if (qMode === "server" || qMode === "multi") {
    if (G_QUOTA_MODE !== qMode) {
      G_QUOTA_MODE = qMode;
      needPacingRender = true;
    }
    try { localStorage.setItem("agy-stats-quota-counting", qMode); } catch (e) {}
    const rQSrv = document.getElementById("settingQuotaServer");
    const rQMul = document.getElementById("settingQuotaMulti");
    if (rQSrv) rQSrv.checked = (qMode === "server");
    if (rQMul) rQMul.checked = (qMode === "multi");
  }
  const pStyle = cfg.web?.pacing_style;
  if (pStyle === "fun" || pStyle === "straight" || pStyle === "minimal") {
    G_PACING_STYLE = pStyle;
    try { localStorage.setItem("agy-stats-pacing-style", pStyle); } catch (e) {}
    needPacingRender = true;
  }
  if (typeof cfg.web?.pacing_bars === "boolean") {
    G_PACING_BARS = cfg.web.pacing_bars;
    try { localStorage.setItem("agy-stats-pacing-bars", G_PACING_BARS ? "true" : "false"); } catch (e) {}
    const cb = document.getElementById("settingPacingBars");
    if (cb) cb.checked = G_PACING_BARS;
    needPacingRender = true;
  }
  if (typeof cfg.web?.show_reset_breakdown === "boolean") {
    if (G_SHOW_RESET_BREAKDOWN !== cfg.web.show_reset_breakdown) {
      G_SHOW_RESET_BREAKDOWN = cfg.web.show_reset_breakdown;
      needPacingRender = true;
    }
    try { localStorage.setItem("agy-stats-reset-breakdown", G_SHOW_RESET_BREAKDOWN ? "true" : "false"); } catch (e) {}
    const rbCb = document.getElementById("settingResetBreakdown");
    if (rbCb) rbCb.checked = G_SHOW_RESET_BREAKDOWN;
  }
  if (needPacingRender && G_OVERVIEW_DATA) {
    renderPacingSection("overviewPacingBody");
    renderPacingSection("quotaPacingBody");
    renderQuotaPoolsGrid();
  }
  const disSec = (cfg.cli && Array.isArray(cfg.cli.disabled_sections)) ? cfg.cli.disabled_sections : [];
  applyOverviewDisplaySections(disSec);
}

function applyOverviewDisplaySections(disabledSections = []) {
  const dSet = new Set((disabledSections || []).map(s => String(s).toLowerCase()));
  const setVis = (id, show) => {
    const el = document.getElementById(id);
    if (el) el.style.display = show ? "" : "none";
  };
  const showSummary = !dSet.has("summary");
  setVis("overviewStatsSkeleton", showSummary && !G_INITIAL_REVEALED);
  setVis("overviewStatsWrap", showSummary && G_INITIAL_REVEALED);
  setVis("primaryStatGrid", showSummary);
  setVis("secondaryStatGrid", showSummary);
  setVis("overviewPacingCard", !dSet.has("quota"));

  const showAct = !dSet.has("days");
  const showMix = !dSet.has("models");
  setVis("overviewActivityCard", showAct);
  setVis("overviewTokenMixCard", showMix);
  const gridEl = document.getElementById("overviewMainSideGrid");
  if (gridEl) {
    if (!showAct && !showMix) {
      gridEl.style.display = "none";
    } else {
      gridEl.style.display = "";
      gridEl.style.gridTemplateColumns = (showAct && showMix) ? "" : "1fr";
    }
  }

  setVis("topSessionsCard", !dSet.has("sessions"));
  setVis("latestRequestsCard", !dSet.has("requests"));
  requestAnimationFrame(() => {
    syncSegmentedThumbs();
    if (showAct && G_OVERVIEW_DATA) renderOverviewActivityChart();
  });
}

