    titleEl.innerHTML = `${iconSvg} ${isFirstRun ? "Welcome to agy / stats — Quick Setup" : "Settings & Preferences"}`;
  }
  
  const isCli = cfg.default_mode === "cli";
  const webRadio = document.getElementById("settingModeWeb");
  const cliRadio = document.getElementById("settingModeCli");
  if (webRadio) webRadio.checked = !isCli;
  if (cliRadio) cliRadio.checked = isCli;

  const brCheck = document.getElementById("settingOpenBrowser");
  if (brCheck) brCheck.checked = cfg.web?.open_browser !== false;

  const qMode = cfg.web?.quota_mode || G_QUOTA_MODE || "server";
  const rQSrv = document.getElementById("settingQuotaServer");
  const rQMul = document.getElementById("settingQuotaMulti");
  if (rQSrv) rQSrv.checked = (qMode !== "multi");
  if (rQMul) rQMul.checked = (qMode === "multi");
  const rbCb = document.getElementById("settingResetBreakdown");
  if (rbCb) rbCb.checked = (cfg.web?.show_reset_breakdown !== undefined) ? !!cfg.web.show_reset_breakdown : G_SHOW_RESET_BREAKDOWN;

  const pStyle = cfg.web?.pacing_style || G_PACING_STYLE || "fun";
  const rFun = document.getElementById("settingPacingFun");
  const rStr = document.getElementById("settingPacingStraight");
  const rMin = document.getElementById("settingPacingMinimal");
  if (rFun) rFun.checked = (pStyle === "fun");
  if (rStr) rStr.checked = (pStyle === "straight");
  if (rMin) rMin.checked = (pStyle === "minimal");
  const pBarsCb = document.getElementById("settingPacingBars");
  if (pBarsCb) pBarsCb.checked = (cfg.web?.pacing_bars !== undefined) ? !!cfg.web.pacing_bars : G_PACING_BARS;

