def _describe_display_sections(disabled_list):
    dis = set(str(x).lower() for x in (disabled_list or []))
    if not dis:
        return "Full Overview (all 8 sections)"
    if dis == set(MINIMALIST_DISABLED_SECTIONS):
        return "Minimalist (Summary, Quota, Models, Activity)"
    total = len(OVERVIEW_SECTION_ITEMS)
    enabled = sum(1 for k, _, _ in OVERVIEW_SECTION_ITEMS if k not in dis)
    return f"Custom ({enabled}/{total} sections shown)"

