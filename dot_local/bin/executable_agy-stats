# Pure-Python RFC 8032 Ed25519 Signature Verification (zero external dependencies)
_ED_P = (1 << 255) - 19
_ED_L = (1 << 252) + 27742317777372353535851937790883648493
_ED_D = (-121665 * pow(121666, _ED_P - 2, _ED_P)) % _ED_P
_ED_I = pow(2, (_ED_P - 1) // 4, _ED_P)

def _ed_xrecover(y):
    xx = (y * y - 1) * pow(_ED_D * y * y + 1, _ED_P - 2, _ED_P) % _ED_P
    x = pow(xx, (_ED_P + 3) // 8, _ED_P)
    if (x * x - xx) % _ED_P != 0:
        x = (x * _ED_I) % _ED_P
    if x & 1:
        x = _ED_P - x
    return x

_ED_BY = (4 * pow(5, _ED_P - 2, _ED_P)) % _ED_P
_ED_BX = _ed_xrecover(_ED_BY)
_ED_B = (_ED_BX, _ED_BY, 1, (_ED_BX * _ED_BY) % _ED_P)

def _ed_add(P, Q):
    X1, Y1, Z1, T1 = P
    X2, Y2, Z2, T2 = Q
    A = ((Y1 - X1) * (Y2 - X2)) % _ED_P
    B = ((Y1 + X1) * (Y2 + X2)) % _ED_P
    C = (T1 * 2 * _ED_D * T2) % _ED_P
    D = (Z1 * 2 * Z2) % _ED_P
    E = (B - A) % _ED_P
    F = (D - C) % _ED_P
    G = (D + C) % _ED_P
    H = (B + A) % _ED_P
    return ((E * F) % _ED_P, (G * H) % _ED_P, (F * G) % _ED_P, (E * H) % _ED_P)

def _ed_mul(P, e):
    R = (0, 1, 1, 0)
    Q = P
    while e > 0:
        if e & 1:
            R = _ed_add(R, Q)
        Q = _ed_add(Q, Q)
        e >>= 1
    return R

def _ed_encode(P):
    X, Y, Z, _ = P
    zi = pow(Z, _ED_P - 2, _ED_P)
    x = (X * zi) % _ED_P
    y = (Y * zi) % _ED_P
    return (y | ((x & 1) << 255)).to_bytes(32, "little")

def _ed_decode(bs):
    if len(bs) != 32:
        return None
    y = int.from_bytes(bs, "little") & ((1 << 255) - 1)
    if y >= _ED_P:
        return None
    x_sign = (bs[31] >> 7) & 1
    u = (y * y - 1) % _ED_P
    v = (_ED_D * y * y + 1) % _ED_P
    x = (u * pow(v, 3, _ED_P) * pow(u * pow(v, 7, _ED_P), (_ED_P - 5) // 8, _ED_P)) % _ED_P
    vxx = (v * x * x) % _ED_P
    if vxx == u:
        pass
    elif vxx == (-u) % _ED_P:
        x = (x * _ED_I) % _ED_P
    else:
        return None
    if x == 0 and x_sign == 1:
        return None
    if (x & 1) != x_sign:
        x = _ED_P - x
    return (x, y, 1, (x * y) % _ED_P)

def ed25519_verify(pubkey32, msg, sig64):
    if len(pubkey32) != 32 or len(sig64) != 64:
        return False
    R_enc = sig64[:32]
    S = int.from_bytes(sig64[32:], "little")
    if S >= _ED_L:
        return False
    A = _ed_decode(pubkey32)
    R = _ed_decode(R_enc)
    if A is None or R is None:
        return False
    k = int.from_bytes(hashlib.sha512(R_enc + pubkey32 + msg).digest(), "little") % _ED_L
    return _ed_encode(_ed_mul(_ED_B, S)) == _ed_encode(_ed_add(R, _ed_mul(A, k)))

def _detect_runtime_platform():
    """Return (platform_key, display_name, is_tested_linux)."""
    if sys.platform == "win32":
        return ("windows", "Windows PowerShell", False)
    if sys.platform == "darwin":
        return ("macos", "macOS", False)
    if sys.platform.startswith("linux"):
        try:
            with open("/proc/version", "r", encoding="utf-8", errors="ignore") as f:
                pv = f.read().lower()
            if "microsoft" in pv or "wsl" in pv:
                return ("wsl2", "WSL2 (Windows Subsystem for Linux)", False)
        except Exception:
            pass
        return ("linux", "Linux", True)
    return (sys.platform, sys.platform, False)

def _discover_agy_roots():
    """Discover all installed Antigravity surfaces (CLI + Desktop/IDE)."""
    candidates = [
        os.path.expanduser("~/.gemini/antigravity-cli"),
        os.path.expanduser("~/.gemini/antigravity"),
        os.path.expanduser("~/.gemini/antigravity-ide"),
    ]
    existing = [p for p in candidates if os.path.isdir(p)]
    return existing if existing else [candidates[0]]

# Empirically calibrated dimensionless quota budgets & server 5h-to-weekly conversion factors
# Measured directly from IEEE-754 float32 /usage server remaining_fraction deltas:
# - Gemini Models: 100% of 5h limit = 25.0% of Weekly quota (4.0 full 5h tanks/week)
# - Claude & GPT:  100% of 5h limit = 50.0% of Weekly quota (2.0 full 5h tanks/week)
POOL_BURST_TO_WEEK_PCT = {
    "gemini": 25.0,
    "3p": 50.0,
}
_CALIBRATED_BURST_TO_WK_PCT = {}

QUOTA_BUDGET_5H = 52.0
QUOTA_BUDGET_WEEK = 208.0

def get_pool_burst_to_wk_pct(pool_key="gemini"):
    pk = "3p" if pool_key == "3p" else "gemini"
    val = _CALIBRATED_BURST_TO_WK_PCT.get(pk)
    if isinstance(val, (int, float)) and 5.0 <= float(val) <= 100.0:
        return float(val)
    return POOL_BURST_TO_WEEK_PCT[pk]

MODEL_QUOTA_WEIGHTS = {
    # (input_per_1M, output_per_1M, cache_read_per_1M)
    "argon_high":         (0.45,  3.60, 0.045),
    "argon_med":          (0.38,  3.04, 0.038),
    "flash_high":         (0.30,  2.40, 0.030),
    "flash_med":          (0.20,  1.60, 0.020),
    "flash_low":          (0.10,  0.80, 0.010),
    "claude_opus_high":   (3.80, 22.00, 0.380),
    "claude_opus_med":    (3.20, 18.50, 0.320),
    "claude_sonnet_high": (2.30, 13.50, 0.230),
    "claude_sonnet_med":  (1.90, 11.00, 0.190),
    "claude_sonnet_low":  (1.40,  8.00, 0.140),
    "claude_haiku":       (0.65,  3.80, 0.065),
    "gpt_oss":            (0.85,  4.80, 0.085),
    "other":              (0.35,  2.00, 0.035),
}

def compute_quota_units(model_name, inp, out, cache):
    ml = (model_name or "").lower()
    if "argon (high)" in ml or "pro (high)" in ml:
        w = MODEL_QUOTA_WEIGHTS["argon_high"]
    elif "argon" in ml or "pro" in ml:
        w = MODEL_QUOTA_WEIGHTS["argon_med"]
    elif "flash (high)" in ml:
        w = MODEL_QUOTA_WEIGHTS["flash_high"]
    elif "flash (low)" in ml or "lite" in ml:
        w = MODEL_QUOTA_WEIGHTS["flash_low"]
    elif "flash" in ml:
        w = MODEL_QUOTA_WEIGHTS["flash_med"]
    elif "opus" in ml:
        w = MODEL_QUOTA_WEIGHTS["claude_opus_high" if "(high)" in ml else "claude_opus_med"]
    elif "sonnet" in ml:
        if "(high)" in ml:
            w = MODEL_QUOTA_WEIGHTS["claude_sonnet_high"]
        elif "(low)" in ml:
            w = MODEL_QUOTA_WEIGHTS["claude_sonnet_low"]
        else:
            w = MODEL_QUOTA_WEIGHTS["claude_sonnet_med"]
    elif "haiku" in ml:
        w = MODEL_QUOTA_WEIGHTS["claude_haiku"]
    elif "gpt" in ml or "openai" in ml:
        w = MODEL_QUOTA_WEIGHTS["gpt_oss"]
    else:
        w = MODEL_QUOTA_WEIGHTS["other"]
    return (inp * w[0] + out * w[1] + cache * w[2]) / 1_000_000.0

def units_to_pct_5h(u, digits=2, is_3p=False):
    ratio = get_pool_burst_to_wk_pct("3p" if is_3p else "gemini") / 100.0
    budget_5h = max(1.0, QUOTA_BUDGET_WEEK * ratio)
    return round((u / budget_5h) * 100.0, digits)

def units_to_pct_week(u, digits=2):
    return round((u / QUOTA_BUDGET_WEEK) * 100.0, digits)

