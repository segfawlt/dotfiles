function setQuotaMode(modeKey, persist = true) {
  const norm = modeKey === "multi" ? "multi" : "server";
  hideQuotaConversionTip();
  G_QUOTA_MODE = norm;
  try { localStorage.setItem("agy-stats-quota-counting", norm); } catch (e) {}
  const rSrv = document.getElementById("settingQuotaServer");
  const rMul = document.getElementById("settingQuotaMulti");
  if (rSrv) rSrv.checked = (norm === "server");
  if (rMul) rMul.checked = (norm === "multi");
  if (persist) {
    if (G_SETTINGS && G_SETTINGS.web) G_SETTINGS.web.quota_mode = norm;
    fetch("/api/settings", {
      method: "POST",
      headers: { "Content-Type": "application/json", "X-Agy-Stats": "1" },
      body: JSON.stringify({ web: { quota_mode: norm } })
    }).catch(() => {});
  }
  renderPacingSection("overviewPacingBody");
  renderPacingSection("quotaPacingBody");
  renderQuotaPoolsGrid();
  syncSegmentedThumbs();
}
