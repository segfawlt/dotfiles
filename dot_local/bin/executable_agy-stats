        "disabled_tabs": []
    },
    "cli": {
        "default_view": "overview",  # "overview" | "tokens" | "summary" | "quota" | "sessions" | "models"
        "days": 10,
        "disabled_sections": []
    }
}

def _safe_int(val, default):
    if val is None or isinstance(val, bool):
        return default
    try:
        return int(val)
    except (ValueError, TypeError):
        return default

def _safe_bool(val, default):
    if val is None:
        return default
    if isinstance(val, bool):
        return val
    if isinstance(val, (int, float)):
        return bool(val)
    if isinstance(val, str):
        return val.strip().lower() in ("1", "true", "yes", "on")
    return default

def _atomic_write_json(target_path, payload):
    parent = os.path.dirname(target_path)
    os.makedirs(parent, exist_ok=True)
    tmp_path = os.path.join(parent, f".{os.path.basename(target_path)}.tmp.{os.getpid()}.{threading.get_ident()}")
    try:
        with open(tmp_path, "w", encoding="utf-8") as f:
            json.dump(payload, f, indent=2)
            f.write("\n")
            f.flush()
            try:
                os.fsync(f.fileno())
            except OSError:
                pass
        os.replace(tmp_path, target_path)
    except Exception:
        if os.path.exists(tmp_path):
            try:
                os.remove(tmp_path)
            except OSError:
                pass
        raise

def _read_config_with_status():
    res = copy.deepcopy(DEFAULT_CONFIG)
    if not os.path.exists(CONFIG_PATH):
        try:
            _atomic_write_json(CONFIG_PATH, res)
        except Exception:
            pass
        return res, False
    try:
        with open(CONFIG_PATH, "r", encoding="utf-8") as f:
            raw_txt = f.read()
        if not raw_txt.strip():
            return res, True
        cfg = json.loads(raw_txt)
    except Exception:
        return res, True

    if isinstance(cfg, dict):
        res["onboarded"] = _safe_bool(cfg.get("onboarded"), False)
        raw_url = cfg.get("update_url")
        res["update_url"] = str(raw_url).strip() if raw_url is not None and str(raw_url).strip() else DEFAULT_UPDATE_URL
        res["auto_check_updates"] = _safe_bool(cfg.get("auto_check_updates"), True)
        res["auto_update"] = _safe_bool(cfg.get("auto_update"), False)
        res["last_update_check"] = _safe_int(cfg.get("last_update_check"), 0)
        res["latest_seen_version"] = str(cfg.get("latest_seen_version") or "")
        res["last_auto_update_notice"] = str(cfg.get("last_auto_update_notice") or "")
        if "default_mode" in cfg and cfg["default_mode"] is not None:
            res["default_mode"] = "cli" if str(cfg["default_mode"]).lower() in ("cli", "terminal") else "web"
        if isinstance(cfg.get("web"), dict):
            w = cfg["web"]
            res["web"]["port"] = _safe_int(w.get("port"), 3872)
            res["web"]["open_browser"] = _safe_bool(w.get("open_browser"), True)
            # Read quota_counting so legacy dormant v1.0.x quota_mode="multi" stubs default cleanly to "server"
            if str(w.get("quota_counting") or "").lower() in ("server", "multi", "local"):
                qm_norm = "multi" if str(w.get("quota_counting")).lower() in ("multi", "local") else "server"
                res["web"]["quota_mode"] = qm_norm
                res["web"]["quota_counting"] = qm_norm
            res["web"]["show_reset_breakdown"] = _safe_bool(w.get("show_reset_breakdown"), False)
            if w.get("pacing_style") in ("fun", "straight", "minimal"):
                res["web"]["pacing_style"] = w["pacing_style"]
            res["web"]["pacing_bars"] = _safe_bool(w.get("pacing_bars"), True)
            if isinstance(w.get("disabled_tabs"), list):
                res["web"]["disabled_tabs"] = [str(t).lower() for t in w["disabled_tabs"] if t]
        if isinstance(cfg.get("cli"), dict):
            c = cfg["cli"]
            if c.get("default_view"):
                res["cli"]["default_view"] = str(c["default_view"]).lower()
            res["cli"]["days"] = max(1, _safe_int(c.get("days"), 10))
            if isinstance(c.get("disabled_sections"), list):
                res["cli"]["disabled_sections"] = [str(s).lower() for s in c["disabled_sections"] if s]
    return res, False

def load_config():
    res, _ = _read_config_with_status()
    return res

def save_config(updates):
    cur, unreadable = _read_config_with_status()
    if not isinstance(updates, dict):
        return cur
    # If config.json was unreadable/corrupt on disk, refuse passive background timestamp overwrites
    # so user preferences are never wiped by a background check; allow explicit user saves.
    is_bg_only = set(updates.keys()).issubset({"last_update_check", "latest_seen_version", "last_auto_update_notice"})
    if unreadable and is_bg_only:
        return cur
    if "onboarded" in updates:
        cur["onboarded"] = _safe_bool(updates["onboarded"], cur["onboarded"])
    if "update_url" in updates:
        u_val = str(updates["update_url"] or "").strip()
        cur["update_url"] = u_val if u_val else DEFAULT_UPDATE_URL
    if "auto_check_updates" in updates:
        cur["auto_check_updates"] = _safe_bool(updates["auto_check_updates"], cur["auto_check_updates"])
    if "auto_update" in updates:
        cur["auto_update"] = _safe_bool(updates["auto_update"], cur["auto_update"])
        if cur["auto_update"]:
            cur["auto_check_updates"] = True
    if "last_update_check" in updates:
        cur["last_update_check"] = _safe_int(updates["last_update_check"], cur["last_update_check"])
    if "latest_seen_version" in updates:
        cur["latest_seen_version"] = str(updates["latest_seen_version"] or "").strip()
    if "last_auto_update_notice" in updates:
        cur["last_auto_update_notice"] = str(updates["last_auto_update_notice"] or "").strip()
    if "default_mode" in updates:
        cur["default_mode"] = "cli" if str(updates["default_mode"]).lower() in ("cli", "terminal") else "web"
    if "web" in updates and isinstance(updates["web"], dict):
        for k, v in updates["web"].items():
            if k == "port" and v is not None:
                cur["web"]["port"] = _safe_int(v, cur["web"]["port"])
            elif k == "open_browser":
                cur["web"]["open_browser"] = _safe_bool(v, cur["web"]["open_browser"])
            elif k in ("quota_mode", "quota_counting"):
                qm_norm = "multi" if str(v or "").lower() in ("multi", "local") else "server"
                cur["web"]["quota_mode"] = qm_norm
                cur["web"]["quota_counting"] = qm_norm
            elif k == "show_reset_breakdown":
                cur["web"]["show_reset_breakdown"] = _safe_bool(v, cur["web"]["show_reset_breakdown"])
            elif k == "pacing_style" and v in ("fun", "straight", "minimal"):
                cur["web"]["pacing_style"] = v
            elif k == "pacing_bars":
                cur["web"]["pacing_bars"] = _safe_bool(v, cur["web"]["pacing_bars"])
            elif k == "disabled_tabs" and isinstance(v, list):
                cur["web"]["disabled_tabs"] = [str(t).lower() for t in v if t]
    if "cli" in updates and isinstance(updates["cli"], dict):
        for k, v in updates["cli"].items():
            if k == "default_view" and v:
                cur["cli"]["default_view"] = str(v).lower()
            elif k == "days" and v is not None:
                cur["cli"]["days"] = max(1, _safe_int(v, cur["cli"]["days"]))
            elif k == "disabled_sections" and isinstance(v, list):
                cur["cli"]["disabled_sections"] = [str(s).lower() for s in v if s]
    try:
        _atomic_write_json(CONFIG_PATH, cur)
    except Exception as ex:
        print(f"Warning: could not write {CONFIG_PATH}: {ex}")
    return cur

def is_tty():
    return sys.stdout.isatty()

class C:
    RESET   = "\033[0m"  if is_tty() else ""
    BOLD    = "\033[1m"  if is_tty() else ""
    DIM     = "\033[2m"  if is_tty() else ""
    CYAN    = "\033[36m" if is_tty() else ""
    GREEN   = "\033[32m" if is_tty() else ""
    YELLOW  = "\033[33m" if is_tty() else ""
    RED     = "\033[31m" if is_tty() else ""
    MAGENTA = "\033[35m" if is_tty() else ""

def format_num(n):
    return f"{n:,}" if isinstance(n, (int, float)) else str(n)

def format_tokens(n):
    n = float(n or 0)
    if n >= 1e9:
        return f"{n/1e9:.2f}B"
    if n >= 1e6:
        return f"{n/1e6:.2f}M"
    if n >= 1e3:
        return f"{n/1e3:.1f}K"
    return f"{int(n):,}"

FRUSTRATION_PATTERNS = {
    "profanity": re.compile(r"\b(wtf|damn|f+u+c+k+|s+h+i+t+|crap|bullshit)\b", re.IGNORECASE),
    "anguish": re.compile(r"\b(u+g+h+|o+m+g+|o+m+f+g+|sigh|give up|tired of this|not again|why is it still)\b", re.IGNORECASE),
    "blame": re.compile(r"\b(you (broke|failed|forgot|ruined|messed up|hallucinated|keep)|why did you|you didn't)\b", re.IGNORECASE),
    "negation": re.compile(r"(^|\n)\s*(no[,. !]|nope|stop|wait|cancel|undo|revert)\b|\b(not working|that's wrong|didn't work|still broken|failed again)\b", re.IGNORECASE),
    "yelling": re.compile(r"\b(STOP|WAIT|WHY|FIX|HELP|NO{2,}|WHAT|LISTEN|PLEASE|NEVER|AGAIN|ENOUGH|URGENT)\b|!{2,}|\?{2,}")
}

_HOME_PREFIX_RE = re.compile(r"^(?:/home/[^/\s]+|/Users/[^/\s]+|[A-Za-z]:/Users/[^/\s]+)(?=/|$)")
_VALID_CID_RE = re.compile(r"^[0-9a-fA-F-]+$")
_NONZERO_EXIT_RE = re.compile(r"^Command exited with code [1-9]\d*\b", re.MULTILINE)

def extract_workspace_path(raw_ws):
    if not raw_ws:
        return None
    s = str(raw_ws).strip()
    if not s or s == "General":
        return None
    if s.startswith("["):
        try:
            arr = json.loads(s)
            if isinstance(arr, list):
                s = next((str(x).strip() for x in arr if x and str(x).strip()), "")
            else:
                return None
        except Exception:
            s = s.strip("[]\"' ")
    if not s:
        return None
    if s.startswith("file://"):
        u = urllib.parse.urlparse(s)
        p = urllib.parse.unquote(u.path or "")
        if u.netloc and u.netloc.lower() != "localhost":
            p = f"//{u.netloc}{p}"
        if re.match(r"^/[A-Za-z]:/", p):
            p = p[1:]
        s = p
    else:
        s = urllib.parse.unquote(s)
    s = s.strip("\"' ").replace("\\", "/")
    if len(s) > 1 and not re.match(r"^[A-Za-z]:/$", s):
        s = s.rstrip("/")
    return s or None

def normalize_error_signature(msg):
    if not msg:
        return "Unknown error"
    s = msg.strip().split("\n")[0][:140]
    s = re.sub(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", "<uuid>", s, flags=re.I)
    home_norm = os.path.expanduser("~").replace("\\", "/").rstrip("/")
    if home_norm and len(home_norm) > 1:
        s = re.sub(re.escape(home_norm) + r"[/\\][^\s:\"']+", "<path>", s)
        s = re.sub(re.escape(home_norm.replace("/", "\\")) + r"[/\\][^\s:\"']+", "<path>", s)
    s = re.sub(r"(?:/home/[^/\s]+|/Users/[^/\s]+|[A-Za-z]:[/\\]Users[/\\][^/\\\s]+)[/\\][^\s:\"']+", "<path>", s)
    s = re.sub(r"\b\d{2,}\b", "<num>", s)
    return s

_FILE_EXT_RE = re.compile(r"\.(?:md|txt|py|sh|ps1|json|jsonl|yaml|yml|toml|html|css|js|ts|tsx|jsx|png|jpg|jpeg|gif|webp|svg|pdf|csv|log|sql|db|zip|tar|gz)$", re.IGNORECASE)

def infer_project_from_path(fp):
    clean = extract_workspace_path(fp)
    if not clean:
        return None
    home_norm = os.path.expanduser("~").replace("\\", "/").rstrip("/")
    rel = None
    if home_norm and (clean == home_norm or clean.startswith(home_norm + "/")):
        rel = "~" + clean[len(home_norm):]
    else:
        m_h = _HOME_PREFIX_RE.match(clean)
        if m_h:
            rel = "~" + clean[m_h.end():]
    if rel is not None:
        if rel == "~":
            return "~"
        parts = [p for p in rel.split("/")[1:] if p]
        if not parts:
            return "~"
        if parts[0].lower() in ("projects", "repos", "workspace", "workspaces", "code", "dev", "src", "git") and len(parts) >= 2:
            if len(parts) == 2 and _FILE_EXT_RE.search(parts[1]):
                return f"~/{parts[0]}"
            return f"~/{parts[0]}/{parts[1]}"
        if parts[0] == ".gemini" and len(parts) >= 2:
            return f"~/.gemini/{parts[1]}"
        if parts[0].startswith("."):
            return f"~/{parts[0]}"
        if len(parts) == 1 and _FILE_EXT_RE.search(parts[0]):
            return "~"
        if parts[0] in ("Documents", "Desktop") and len(parts) >= 2:
            if len(parts) == 2 and _FILE_EXT_RE.search(parts[1]):
                return f"~/{parts[0]}"
            if len(parts) >= 3 and not _FILE_EXT_RE.search(parts[2]):
                return f"~/{parts[0]}/{parts[1]}/{parts[2]}"
            return f"~/{parts[0]}/{parts[1]}"
        return f"~/{parts[0]}"
    m_wsl = re.match(r"^/mnt/[a-zA-Z]/Users/[^/]+(?:/(.*))?$", clean)
    if m_wsl:
        sub = m_wsl.group(1) or ""
        if not sub:
            return "~"
        sp = [p for p in sub.split("/") if p]
        if sp[0].lower() in ("projects", "repos", "workspace", "workspaces", "code", "dev", "src", "git") and len(sp) >= 2:
            if len(sp) == 2 and _FILE_EXT_RE.search(sp[1]):
                return f"~/{sp[0]}"
            return f"~/{sp[0]}/{sp[1]}"
        return f"~/{sp[0]}"
    parts = [p for p in clean.strip("/").split("/") if p]
    if parts and parts[0] not in ("tmp", "var", "proc", "sys", "dev", "etc", "run"):
        prefix = "/" if clean.startswith("/") else ""
        return prefix + "/".join(parts[:min(3, len(parts))])
    return None

def _is_step_error(d, stype, source, content):
    if d.get("status") == "ERROR":
        return True
    if stype == "GENERIC" and source == "MODEL" and content:
        if _NONZERO_EXIT_RE.search(content):
            return True
    return False

def _find_agy_binary():
    found = shutil.which("agy")
    if found:
        return found
    candidates = []
    if sys.platform == "win32":
        local_app = os.environ.get("LOCALAPPDATA", "")
        if local_app:
            candidates.extend([
                os.path.join(local_app, "agy", "bin", "agy.exe"),
                os.path.join(local_app, "agy", "bin", "agy.cmd"),
                os.path.join(local_app, "Programs", "Antigravity", "agy.exe"),
            ])
        candidates.extend([
            os.path.expanduser("~/.local/bin/agy.exe"),
            os.path.expanduser("~/.local/bin/agy.cmd"),
        ])
    else:
        candidates.extend([
            os.path.expanduser("~/.local/bin/agy"),
            "/opt/homebrew/bin/agy",
            "/usr/local/bin/agy",
        ])
    for c in candidates:
        if c and os.path.isfile(c):
            return c
    return None

def flatten_quota_pools(raw_groups):
    flat = []
    for g in (raw_groups or []):
        if "buckets" in g and isinstance(g["buckets"], list):
            gname = g.get("name", "Models")
            for b in g["buckets"]:
                rem_f = float(b.get("remaining_fraction", 1.0))
                win = b.get("window", "")
                wlabel = "Weekly" if win == "weekly" else ("5h" if win == "5h" else b.get("name", win))
                flat.append({
                    "id": b.get("id", ""),
                    "groupName": gname,
                    "window": win,
                    "windowLabel": wlabel,
                    "remainingFraction": rem_f,
                    "remainingPct": round(rem_f * 100.0, 1),
                    "usedPct": round((1.0 - rem_f) * 100.0, 1),
                    "resetTime": b.get("reset_time", "") or "",
                    "description": b.get("description", "") or ""
                })
        elif isinstance(g, dict) and ("remainingFraction" in g or "remaining_fraction" in g):
            rem_f = float(g.get("remainingFraction", g.get("remaining_fraction", 1.0)))
            flat.append({
                "id": g.get("id", ""),
                "groupName": g.get("groupName", g.get("name", "Models")),
                "window": g.get("window", ""),
                "windowLabel": g.get("windowLabel", g.get("window", "")),
                "remainingFraction": rem_f,
                "remainingPct": round(rem_f * 100.0, 1),
                "usedPct": round((1.0 - rem_f) * 100.0, 1),
                "resetTime": g.get("resetTime", g.get("reset_time", "")) or "",
                "description": g.get("description", "") or ""
            })
    return flat

def parse_iso_ms(raw_dt):
    if not raw_dt:
        return None
    try:
        return int(datetime.fromisoformat(raw_dt.replace("Z", "+00:00")).timestamp() * 1000)
    except Exception:
        return None

def _has_expired_pool(pools, now_ms):
    for p in (pools or []):
        rms = parse_iso_ms(p.get("resetTime") if isinstance(p, dict) else "")
        if rms and rms <= now_ms:
            return True
    return False

def _project_reset_ms(reset_ms, period_ms, now_ms):
    if not reset_ms or period_ms <= 0:
        return None
    if reset_ms <= now_ms:
        steps = ((now_ms - reset_ms) // period_ms) + 1
        return reset_ms + steps * period_ms
    return reset_ms

def _is_3p_model(model_name):
    ml = (model_name or "").lower()
    return ("claude" in ml) or ("opus" in ml) or ("sonnet" in ml) or ("haiku" in ml) or ("gpt" in ml) or ("openai" in ml)

_LAST_QUOTA_REFRESH_ATTEMPT = 0.0
_RECENT_SERVER_RATES = {}

def _update_quota_calibration(flat_pools, cal_state, now):
    """Guarded anchor calibrator + in-cycle server snapshot history for pure server delta pacing."""
    if not isinstance(cal_state, dict):
        cal_state = {}
    anchors = dict(cal_state.get("anchors") or {})
    ratios = dict(cal_state.get("ratios") or {})
    snapshots = dict(cal_state.get("snapshots") or {})
    changed = False

    by_id = {p.get("id"): p for p in (flat_pools or []) if isinstance(p, dict) and p.get("id")}
    for pk, wk_id, fh_id in (("gemini", "gemini-weekly", "gemini-5h"), ("3p", "3p-weekly", "3p-5h")):
        wb = by_id.get(wk_id)
        fb = by_id.get(fh_id)
        if not wb and not fb:
            continue
        wk_rt = (wb.get("resetTime") or "") if wb else ""
        fh_rt = (fb.get("resetTime") or "") if fb else ""
        wk_rem_f = float(wb.get("remainingFraction", 1.0)) if wb else 1.0
        fh_rem_f = float(fb.get("remainingFraction", 1.0)) if fb else 1.0
        wk_used_pct = round((1.0 - wk_rem_f) * 100.0, 2)
        fh_used_pct = round((1.0 - fh_rem_f) * 100.0, 2)
        fh_used_f = 1.0 - fh_rem_f

        sn = dict(snapshots.get(pk) or {})
        srv_wk_day = None
        srv_fh_hr = None
        if wk_rt:
            wk_pts = sn.get("wk_pts") if (sn.get("wk_reset") == wk_rt and isinstance(sn.get("wk_pts"), list)) else []
            if not wk_pts or (wk_used_pct + 2.0 < float(wk_pts[-1][1])):
                wk_pts = [[round(now, 1), wk_used_pct]]
                sn["wk_reset"] = wk_rt
                sn["wk_pts"] = wk_pts
                changed = True
            elif (now - float(wk_pts[-1][0])) >= 600 or abs(wk_used_pct - float(wk_pts[-1][1])) >= 0.4:
                wk_pts = (wk_pts + [[round(now, 1), wk_used_pct]])[-48:]
                sn["wk_reset"] = wk_rt
                sn["wk_pts"] = wk_pts
                changed = True
            for pt in wk_pts:
                dt_s = now - float(pt[0])
                if 16 * 3600 <= dt_s <= 30 * 3600 and wk_used_pct >= float(pt[1]):
                    srv_wk_day = ((wk_used_pct - float(pt[1])) / (dt_s / 3600.0)) * 24.0
                    break
        if fh_rt:
            fh_pts = sn.get("fh_pts") if (sn.get("fh_reset") == fh_rt and isinstance(sn.get("fh_pts"), list)) else []
            if not fh_pts or (fh_used_pct + 2.0 < float(fh_pts[-1][1])):
                fh_pts = [[round(now, 1), fh_used_pct]]
                sn["fh_reset"] = fh_rt
                sn["fh_pts"] = fh_pts
                changed = True
            elif (now - float(fh_pts[-1][0])) >= 180 or abs(fh_used_pct - float(fh_pts[-1][1])) >= 0.5:
                fh_pts = (fh_pts + [[round(now, 1), fh_used_pct]])[-24:]
                sn["fh_reset"] = fh_rt
                sn["fh_pts"] = fh_pts
                changed = True
            for pt in fh_pts:
                dt_s = now - float(pt[0])
                if 900 <= dt_s <= 4500 and fh_used_pct >= float(pt[1]):
                    srv_fh_hr = (fh_used_pct - float(pt[1])) / (dt_s / 3600.0)
                    break
        snapshots[pk] = sn
        _RECENT_SERVER_RATES[pk] = {"wk_day": srv_wk_day, "fh_hr": srv_fh_hr}

        if not wb or not fb or not wk_rt or not fh_rt:
            continue

        anc = anchors.get(pk)
        if not isinstance(anc, dict) or anc.get("fh_reset") != fh_rt or anc.get("wk_reset") != wk_rt:
            if fh_used_f <= 0.05:
                anchors[pk] = {
                    "fh_rem": fh_rem_f,
                    "wk_rem": wk_rem_f,
                    "fh_reset": fh_rt,
                    "wk_reset": wk_rt,
                    "ts": now,
                }
                changed = True
        else:
            d_fh = float(anc.get("fh_rem", fh_rem_f)) - fh_rem_f
            d_wk = float(anc.get("wk_rem", wk_rem_f)) - wk_rem_f
            elapsed_s = now - float(anc.get("ts", now))
            if d_fh >= 0.30 and elapsed_s >= 1800 and d_wk > 0.01:
                obs = (d_wk / d_fh) * 100.0
                if 8.0 <= obs <= 100.0:
                    snapped = round(obs, 1)
                    for clean in (12.5, 20.0, 25.0, 33.3, 50.0, 100.0):
                        if abs(obs - clean) <= 0.9:
                            snapped = clean
                            break
                    if ratios.get(pk) != snapped:
                        ratios[pk] = snapped
                        changed = True

    for pk, rv in ratios.items():
        if pk in ("gemini", "3p") and isinstance(rv, (int, float)) and 5.0 <= float(rv) <= 100.0:
            _CALIBRATED_BURST_TO_WK_PCT[pk] = float(rv)

    return {"anchors": anchors, "ratios": ratios, "snapshots": snapshots}, changed

def fetch_live_quota(force_refresh=False):
    global _LAST_QUOTA_REFRESH_ATTEMPT
    now = time.time()
    now_ms = int(now * 1000)
    raw_groups = None
    cal_state = {}
    if os.path.exists(CACHE_FILE):
        try:
            with open(CACHE_FILE, "r", encoding="utf-8") as f:
                cached = json.load(f)
                cal_state = cached.get("calibration") or {}
                for pk, rv in (cal_state.get("ratios") or {}).items():
                    if pk in ("gemini", "3p") and isinstance(rv, (int, float)) and 5.0 <= float(rv) <= 100.0:
                        _CALIBRATED_BURST_TO_WK_PCT[pk] = float(rv)
                if not force_refresh:
                    age = now - cached.get("timestamp", 0)
                    cand_groups = cached.get("groups", [])
                    cand_flat = flatten_quota_pools(cand_groups or [])
                    expired = _has_expired_pool(cand_flat, now_ms)
                    if age < 90 and (not expired or (now - _LAST_QUOTA_REFRESH_ATTEMPT) < 10):
                        raw_groups = cand_groups
        except Exception:
            pass

    if raw_groups is None:
        _LAST_QUOTA_REFRESH_ATTEMPT = now
        agy_bin = _find_agy_binary()
        if agy_bin:
            try:
                res = subprocess.run([agy_bin, "--print", "/usage", "--output-format", "json"], capture_output=True, text=True, timeout=6)
                if res.returncode == 0 and res.stdout.strip():
                    d = json.loads(res.stdout)
                    raw_groups = d.get("command", {}).get("data", {}).get("groups", [])
                    flat_now = flatten_quota_pools(raw_groups or [])
                    cal_state, _ = _update_quota_calibration(flat_now, cal_state, now)
                    _atomic_write_json(CACHE_FILE, {"timestamp": now, "groups": raw_groups, "calibration": cal_state})
                    return flat_now
            except Exception:
                pass

    if raw_groups is None and os.path.exists(CACHE_FILE):
        try:
            with open(CACHE_FILE, "r", encoding="utf-8") as f:
                raw_groups = json.load(f).get("groups", [])
        except Exception:
            raw_groups = []
    flat_res = flatten_quota_pools(raw_groups or [])
    _update_quota_calibration(flat_res, cal_state, now)
    return flat_res

# In-memory raw telemetry cache for instant range recalculation
_TELEMETRY_CACHE = None
_TELEMETRY_CACHE_TIME = 0

MODEL_SELECTION_RE = re.compile(r"setting `?Model Selection`? from (.+?) to (.+?)\.\s*No need")
SUBAGENT_CID_RE = re.compile(r'"conversationId":\s*"([0-9a-fA-F-]+)"')
WORKER_TAG_RE = re.compile(r"\[AGY_INTERNAL_WORKER\]\s*(?:\[([A-Za-z0-9_-]+?)(?:_UPDATE)?\])?")
WORKER_WATCHED_CID_RE = re.compile(r"^Watched-CID:\s*([0-9a-fA-F-]+)\s*$", re.MULTILINE)
WORKER_WATCHED_ROLE_RE = re.compile(r"^Watched-Role:\s*(\S+)\s*$", re.MULTILINE)
WORKER_MODEL_RE = re.compile(r"^(?:[A-Za-z0-9_-]+-)?Model:\s*(\S+)\s*$", re.MULTILINE)
WORKER_WORKSPACE_RE = re.compile(r"^Workspace:\s*(.+?)\s*$", re.MULTILINE)
WORKER_LEGACY_HDR_RE = re.compile(r"Watched Session Role:\s*`([^`]+)`\s*\(`([0-9a-fA-F]{8,})`\)")
INTERNAL_SUBAGENTS_PATH = os.path.expanduser("~/.agents/internal_subagents.json")

def _map_model_slug_to_display(mod):
    ml = (mod or "").strip().lower()
    if not ml or ml == "inherit":
        return None
    if "argon" in ml or ml == "pro" or "pro-" in ml:
        return "Gemini 4 Argon (High)" if ("high" in ml or ml == "pro") else "Gemini 4 Argon (Medium)"
    if "flash_lite" in ml or ("flash" in ml and "low" in ml):
        return "Gemini 3.8 Flash (Low)"
    if "flash" in ml and "medium" in ml:
        return "Gemini 3.8 Flash (Medium)"
    if "flash" in ml:
        return "Gemini 3.8 Flash (High)"
    if "opus" in ml:
        return "Claude Opus 5.5 (Medium)" if "medium" in ml else "Claude Opus 5.5 (High)"
    if "sonnet" in ml or "claude" in ml:
        if "low" in ml:
            return "Claude Sonnet 5.5 (Low)"
        if "medium" in ml:
            return "Claude Sonnet 5.5 (Medium)"
        return "Claude Sonnet 5.5 (High)"
    if "haiku" in ml:
        return "Claude Haiku 4.5"
    if "gpt" in ml:
        return "GPT-OSS 120B (Medium)"
    return None

def _resolve_initial_model(cid, conv_first_from, subagent_info, conv_meta, internal_worker_cids=None, visited=None):
    if visited is None:
        visited = set()
    if cid in visited:
        return "Gemini 4 Argon (Medium)"
    if cid in conv_first_from:
        return conv_first_from[cid]
    ag = (conv_meta.get(cid, {}).get("agent") or "").strip()
    is_iw = bool(internal_worker_cids and cid in internal_worker_cids)
    sub = subagent_info.get(cid)
    if sub:
        tname, mod, pcid = sub
        mapped = _map_model_slug_to_display(mod)
        if mapped:
            return mapped
        if tname == "research":
            return "Gemini 3.8 Flash (Medium)"
        if tname == "image-generator":
            return "Gemini 3.8 Flash (High)"
        if is_iw:
            return "Gemini 4 Argon (High)"
        if pcid:
            return _resolve_initial_model(pcid, conv_first_from, subagent_info, conv_meta, internal_worker_cids, visited | {cid})
    if ag == "research":
        return "Gemini 3.8 Flash (Medium)"
    if ag == "image-generator":
        return "Gemini 3.8 Flash (High)"
    if is_iw:
        return "Gemini 4 Argon (High)"
    return "Gemini 4 Argon (Medium)"

def load_raw_telemetry(force=False):
    global _TELEMETRY_CACHE, _TELEMETRY_CACHE_TIME
    now = time.time()
    if not force and _TELEMETRY_CACHE and (now - _TELEMETRY_CACHE_TIME < 30):
        if _has_expired_pool(_TELEMETRY_CACHE.get("quota"), int(now * 1000)) and (now - _LAST_QUOTA_REFRESH_ATTEMPT >= 10):
            _TELEMETRY_CACHE["quota"] = fetch_live_quota(force_refresh=True)
        return _TELEMETRY_CACHE

    t0 = time.time()
    roots = _discover_agy_roots()
    conv_meta = {}
    for root in roots:
        conv_db = os.path.join(root, "conversation_summaries.db")
        if os.path.exists(conv_db):
            try:
                with contextlib.closing(sqlite3.connect(conv_db)) as conn:
                    cur = conn.cursor()
                    for r in cur.execute("SELECT conversation_id, title, preview, step_count, last_modified_time, workspace_uris, agent_name, parent_conversation_id, killed FROM conversation_summaries"):
                        cid_row = str(r[0] or "").strip()
                        if not cid_row or not _VALID_CID_RE.match(cid_row):
                            continue
                        agent_raw = (r[6] or "").strip()
                        agent_name = agent_raw if agent_raw else ("Lead" if not r[7] else "subagent")
                        step_cnt = int(r[3] or 0)
                        prev_entry = conv_meta.get(cid_row)
                        if prev_entry and prev_entry.get("step_count", 0) > step_cnt:
                            continue
                        conv_meta[cid_row] = {
                            "title": r[1] or "Untitled Session",
                            "preview": r[2] or "",
                            "step_count": step_cnt,
                            "last_modified": r[4] or "",
                            "workspace": r[5] or "",
                            "agent": agent_name,
                            "parent": r[7] or "",
                            "killed": bool(r[8])
                        }
            except Exception:
                pass

    transcript_paths = {}
    for root in roots:
        pattern = os.path.join(root, "brain", "*", ".system_generated", "logs", "transcript.jsonl")
        for p in glob.glob(pattern):
            cid = os.path.basename(os.path.dirname(os.path.dirname(os.path.dirname(p))))
            if not _VALID_CID_RE.match(cid):
                continue
            existing_p = transcript_paths.get(cid)
            if existing_p:
                try:
                    if os.path.getsize(existing_p) >= os.path.getsize(p):
                        continue
                except OSError:
                    pass
            transcript_paths[cid] = p

    paths_items = list(transcript_paths.items())
    prefix_to_cid = {c[:8]: c for c in transcript_paths}

    # Pass 1: Discover initial models, native subagents, and internal worker sessions
    conv_first_from = {}
    subagent_info = {}
    internal_worker_cids = set()
    attached_internal_children = defaultdict(set)

    if os.path.isfile(INTERNAL_SUBAGENTS_PATH):
        try:
            with open(INTERNAL_SUBAGENTS_PATH, "r", encoding="utf-8") as rf:
                reg_data = json.load(rf)
            if isinstance(reg_data, dict):
                for icid, entry in reg_data.items():
                    if not isinstance(entry, dict) or not _VALID_CID_RE.match(str(icid)):
                        continue
                    i_ag = str(entry.get("agent") or "internal-worker").strip()
                    i_mod = str(entry.get("model") or "").strip()
                    i_par = str(entry.get("parent") or "").strip()
                    i_ws = str(entry.get("workspace") or "").strip()
                    if "/.gemini/config/plugins/" in i_ws:
                        i_ws = ""
                    i_lbl = i_ag.replace("-", " ").replace("_", " ").title()
                    i_title = str(entry.get("title") or f"{i_lbl} ({i_mod or 'auto'})").strip()
                    internal_worker_cids.add(icid)
                    subagent_info[icid] = (i_ag, i_mod or "inherit", i_par)
                    prev_m = conv_meta.get(icid, {})
                    conv_meta[icid] = {
                        "title": i_title,
                        "preview": prev_m.get("preview", ""),
                        "step_count": prev_m.get("step_count", 1),
                        "last_modified": entry.get("updated_at") or prev_m.get("last_modified", ""),
                        "workspace": i_ws,
                        "agent": i_ag,
                        "parent": i_par,
                        "killed": bool(prev_m.get("killed", False)),
                    }
                    if i_par:
                        attached_internal_children[i_par].add(icid)
        except Exception:
            pass

    for cid, p in paths_items:
        pending_sub = []
        try:
            with open(p, "r", encoding="utf-8", errors="replace") as f:
                for l_idx, line in enumerate(f):
                    if not line.strip():
                        continue
                    if l_idx == 0 and "[AGY_INTERNAL_WORKER]" in line:
                        internal_worker_cids.add(cid)
                        if cid not in subagent_info:
                            try:
                                d0 = json.loads(line)
                                c0 = str(d0.get("content") or "")
                                m_tag = WORKER_TAG_RE.search(c0)
                                tag_raw = (m_tag.group(1).strip() if (m_tag and m_tag.group(1)) else "internal-worker")
                                w_ag = tag_raw.lower()
                                w_lbl = tag_raw.replace("-", " ").replace("_", " ").title()
                                m_cid = WORKER_WATCHED_CID_RE.search(c0)
                                m_role = WORKER_WATCHED_ROLE_RE.search(c0)
                                m_mod = WORKER_MODEL_RE.search(c0)
                                m_ws = WORKER_WORKSPACE_RE.search(c0)
                                par_cid = m_cid.group(1).strip() if m_cid else ""
                                role_lbl = m_role.group(1).strip() if m_role else "Lead"
                                mod_slug = m_mod.group(1).strip() if m_mod else ""
                                ws_hdr = m_ws.group(1).strip() if m_ws else ""
                                if ws_hdr == "(unassigned)" or "/.gemini/config/plugins/" in ws_hdr:
                                    ws_hdr = ""
                                if not par_cid:
                                    m_leg = WORKER_LEGACY_HDR_RE.search(c0)
                                    if m_leg:
                                        role_lbl = m_leg.group(1).strip()
                                        short_p = m_leg.group(2).strip()
                                        par_cid = short_p if len(short_p) > 8 else prefix_to_cid.get(short_p[:8], "")
                                subagent_info[cid] = (w_ag, mod_slug or "gemini-4-argon-high", par_cid)
                                prev_m = conv_meta.get(cid, {})
                                title_fb = (
                                    f"{w_lbl} [{role_lbl}] ({mod_slug or w_ag})"
                                    if role_lbl != "Lead"
                                    else f"{w_lbl} ({mod_slug or w_ag})"
                                )
                                conv_meta[cid] = {
                                    "title": title_fb,
                                    "preview": prev_m.get("preview", ""),
                                    "step_count": prev_m.get("step_count", 1),
                                    "last_modified": prev_m.get("last_modified", ""),
                                    "workspace": ws_hdr,
                                    "agent": w_ag,
                                    "parent": par_cid,
                                    "killed": bool(prev_m.get("killed", False)),
                                }
                                if par_cid:
                                    attached_internal_children[par_cid].add(cid)
                            except Exception:
                                pass
                    if "Model Selection" in line and cid not in conv_first_from:
                        try:
                            d0 = json.loads(line)
                            m0 = MODEL_SELECTION_RE.search(d0.get("content", ""))
                            if m0:
                                src_m = m0.group(1).strip()
                                dst_m = m0.group(2).strip()
                                conv_first_from[cid] = dst_m if src_m.lower() in ("none", "null", "unknown", "") else src_m
                        except Exception:
                            pass
                    if "invoke_subagent" in line or (pending_sub and "conversationId" in line):
                        try:
                            d0 = json.loads(line)
                            if d0.get("type") == "PLANNER_RESPONSE":
                                for tc in d0.get("tool_calls", []):
                                    if tc.get("name") == "invoke_subagent":
                                        a = tc.get("args", {})
                                        pending_sub.append((a.get("TypeName", ""), a.get("Model", "inherit"), cid))
                            elif pending_sub and "conversationId" in d0.get("content", ""):
                                mc = SUBAGENT_CID_RE.search(d0.get("content", ""))
                                if mc:
                                    subagent_info[mc.group(1)] = pending_sub.pop(0)
                        except Exception:
                            pass
        except Exception:
            pass

    initial_models = {}
    for cid, _ in paths_items:
        initial_models[cid] = _resolve_initial_model(cid, conv_first_from, subagent_info, conv_meta, internal_worker_cids)

    all_requests = []
    daily = defaultdict(lambda: {"in": 0, "out": 0, "cache": 0, "total": 0, "units": 0.0, "steps": 0, "errors": 0, "tools": 0})
    tool_events = []
    commands = Counter()
    files_read = Counter()
    files_edited = Counter()
    errors = []
    frustrations = []
    user_turn_events = []

    session_base = {}

    for cid, p in paths_items:
        current_model = initial_models.get(cid, "Gemini 4 Argon (Medium)")
        consecutive_errors = 0
        prev_ts_ms = None
        open_tool_req = None
        pending_tool_events = []
        last_req_for_session = None
        meta_entry = conv_meta.get(cid, {})
        meta_ws = meta_entry.get("workspace", "")
        sub_tuple = subagent_info.get(cid)
        agent_type = meta_entry.get("agent") or (sub_tuple[0] if sub_tuple and sub_tuple[0] else ("subagent" if meta_entry.get("parent") else "Lead"))
        is_internal_worker = cid in internal_worker_cids

        ws_proj = infer_project_from_path(meta_ws) if meta_ws else None
        if ws_proj and ws_proj.startswith("~/.gemini/"):
            ws_proj = None
        inferred_proj = ws_proj if (ws_proj and ws_proj != "~") else None
        fallback_tool_proj = None

        first_ts = None
        last_ts = None
        turns_cnt = 0
        subagents_cnt = 0

        try:
            with open(p, "r", encoding="utf-8", errors="replace") as f:
                for step_idx, line in enumerate(f):
                    if not line.strip():
                        continue
                    d = json.loads(line)
                    stype = d.get("type")
                    source = d.get("source")
                    raw_dt = d.get("created_at", "")
                    content = d.get("content", "")

                    ts_ms = 0
                    loc_dt_str = raw_dt[:10]
                    if raw_dt:
                        try:
                            loc_dt = datetime.fromisoformat(raw_dt.replace("Z", "+00:00")).astimezone()
                            loc_dt_str = loc_dt.strftime("%Y-%m-%d")
                            ts_ms = int(loc_dt.timestamp() * 1000)
                        except Exception:
                            pass

                    if ts_ms > 0:
                        if open_tool_req is not None:
                            if stype == "GENERIC" and 0 <= (ts_ms - open_tool_req["ts"]) <= 180_000:
                                open_tool_req["durationMs"] = max(250, min(90000, ts_ms - open_tool_req["ts"]))
                                open_tool_req["durMeasured"] = True
                            open_tool_req = None
                        prev_ts_ms = ts_ms
                        if first_ts is None or ts_ms < first_ts:
                            first_ts = ts_ms
                        if last_ts is None or ts_ms > last_ts:
                            last_ts = ts_ms
                    else:
                        open_tool_req = None

                    if "Model Selection" in content:
                        m = MODEL_SELECTION_RE.search(content)
                        if m:
                            current_model = m.group(2).strip()

                    is_err = _is_step_error(d, stype, source, content)
                    if content and pending_tool_events:
                        c_len = len(content)
                        share_len = c_len // max(1, len(pending_tool_events))
                        for pte in pending_tool_events:
                            pte["result_chars"] += share_len
                            if is_err:
                                pte["is_err"] = True

                    if is_err and stype == "GENERIC" and last_req_for_session is not None:
                        last_req_for_session["is_err"] = True
                        last_req_for_session["status"] = "error"

                    if is_err:
                        consecutive_errors += 1
                        if loc_dt_str:
                            daily[loc_dt_str]["errors"] += 1
                        err_line = content.strip().split("\n")[0] if content else "Execution Error"
                        sig = normalize_error_signature(err_line)
                        errors.append({
                            "id": f"err-{cid[:8]}-{step_idx}",
                            "cid": cid,
                            "step": step_idx,
                            "time": raw_dt,
                            "ts": ts_ms,
                            "model": current_model,
                            "agent": agent_type,
                            "signature": sig,
                            "msg": err_line[:180],
                            "fullMsg": content[:2400] if content else err_line,
                            "title": meta_entry.get("title", "Untitled Session")
                        })
                    else:
                        if consecutive_errors >= 2 and not is_internal_worker:
                            frustrations.append({
                                "cid": cid,
                                "category": "error_loop",
                                "model": current_model,
                                "matched": f"{consecutive_errors} consecutive failures",
                                "detail": f"{consecutive_errors} consecutive failed attempts",
                                "time": raw_dt,
                                "ts": ts_ms,
                                "title": meta_entry.get("title", "Untitled Session")
                            })
                        consecutive_errors = 0

                    if source == "USER_EXPLICIT" and stype == "USER_INPUT":
                        last_req_for_session = None
                        pending_tool_events = []
                        if not is_internal_worker:
                            req_m = re.search(r"<USER_REQUEST>(.*?)</USER_REQUEST>", content, re.DOTALL)
                            user_text = req_m.group(1).strip() if req_m else content.strip()

                            if user_text and not user_text.startswith("This is a side question") and "[AGY_INTERNAL_WORKER]" not in user_text:
                                turns_cnt += 1
                                user_turn_events.append((cid, ts_ms))
                                found_for_turn = set()
                                for cat, rx in FRUSTRATION_PATTERNS.items():
                                    m = rx.search(user_text)
                                    if m:
                                        found_for_turn.add((cat, m.group(0).strip()))

                                first_line = user_text.split("\n")[0][:100]
                                for cat, matched_str in found_for_turn:
                                    frustrations.append({
                                        "cid": cid,
                                        "category": cat,
                                        "model": current_model,
                                        "matched": matched_str,
                                        "detail": f'"{matched_str}" — {first_line}',
                                        "time": raw_dt,
                                        "ts": ts_ms,
                                        "title": meta_entry.get("title", "Untitled Session")
                                    })

                    if stype == "PLANNER_RESPONSE" and "input_tokens" in d:
                        inp = int(d.get("input_tokens", 0) or 0)
                        out = int(d.get("output_tokens", 0) or 0)
                        cch = int(d.get("cache_read_tokens", 0) or 0)
                        tot = inp + out + cch
                        q_units = compute_quota_units(current_model, inp, out, cch)

                        tcalls = d.get("tool_calls", [])
                        tc_count = len(tcalls)
                        pending_tool_events = []

                        if loc_dt_str:
                            daily[loc_dt_str]["in"] += inp
                            daily[loc_dt_str]["out"] += out
                            daily[loc_dt_str]["cache"] += cch
                            daily[loc_dt_str]["total"] += tot
                            daily[loc_dt_str]["units"] += q_units
                            daily[loc_dt_str]["steps"] += 1
                            daily[loc_dt_str]["tools"] += tc_count

                        tc_tok_share = tot // max(1, tc_count) if tc_count > 0 else 0
                        tc_unit_share = q_units / max(1, tc_count) if tc_count > 0 else 0.0
                        tc_names_for_req = []

                        for tc in tcalls:
                            tname = tc.get("name", "unknown")
                            tc_names_for_req.append(tname)
                            if tname == "invoke_subagent":
                                subagents_cnt += 1
                            args = tc.get("args", {})
                            args_str = json.dumps(args) if isinstance(args, dict) else str(args)
                            cmd_bin = ""
                            f_read_name = ""
                            f_edit_name = ""

                            if isinstance(args, dict):
                                fp_candidate = args.get("Path") or args.get("AbsolutePath") or args.get("DirectoryPath") or ""
                                if fp_candidate and not inferred_proj:
                                    cand_proj = infer_project_from_path(str(fp_candidate))
                                    if cand_proj and cand_proj != "~":
                                        if not cand_proj.startswith("~/."):
                                            inferred_proj = cand_proj
                                        elif not fallback_tool_proj:
                                            fallback_tool_proj = cand_proj
                                if tname == "run_command":
                                    c_str = args.get("CommandLine", "").strip()
                                    cmd_bin = c_str.split()[0].replace('"', "").replace("'", "") if c_str else ""
                                    if cmd_bin:
                                        commands[cmd_bin] += 1
                                elif tname in ("read_file", "view_file"):
                                    if fp_candidate:
                                        f_read_name = os.path.basename(str(fp_candidate).replace("\\", "/").replace('"', ""))
                                        if f_read_name:
                                            files_read[f_read_name] += 1
                                elif tname in ("edit_file", "write_file"):
                                    if fp_candidate:
                                        f_edit_name = os.path.basename(str(fp_candidate).replace("\\", "/").replace('"', ""))
                                        if f_edit_name:
                                            files_edited[f_edit_name] += 1

                            te = {
                                "tool": tname,
                                "ts": ts_ms,
                                "time": raw_dt,
                                "model": current_model,
                                "args_chars": len(args_str),
                                "result_chars": 0,
                                "tokens_share": tc_tok_share,
                                "units_share": tc_unit_share,
                                "is_err": False,
                                "cmd_bin": cmd_bin,
                                "file_read": f_read_name,
                                "file_edited": f_edit_name,
                            }
                            tool_events.append(te)
                            pending_tool_events.append(te)

                        est_dur_ms = max(450, min(90000, int(round((max(24, out) / 80.0) * 1000.0))))
                        req_obj = {
                            "id": f"{cid[:8]}-{step_idx}",
                            "cid": cid,
                            "step": step_idx,
                            "time": raw_dt,
                            "ts": ts_ms,
                            "date": loc_dt_str,
                            "model": current_model,
                            "agent": agent_type,
                            "title": meta_entry.get("title") or (f"{agent_type} ({cid[:8]})" if meta_entry.get("parent") else "Untitled Session"),
                            "project": inferred_proj or fallback_tool_proj or ws_proj or "(unassigned)",
                            "in": inp,
                            "out": out,
                            "cache": cch,
                            "total": tot,
                            "units": q_units,
                            "pct_5h": units_to_pct_5h(q_units, 3, is_3p=_is_3p_model(current_model)),
                            "pct_week": units_to_pct_week(q_units, 3),
                            "durationMs": est_dur_ms,
                            "durMeasured": False,
                            "tools": tc_names_for_req,
                            "status": "error" if is_err else "ok",
                            "is_err": is_err,
                            "preview": (content[:300] if content else (", ".join(tc_names_for_req) if tc_names_for_req else "Model turn"))
                        }
                        all_requests.append(req_obj)
                        last_req_for_session = req_obj
                        if tc_count > 0 and ts_ms > 0:
                            open_tool_req = req_obj
                    else:
                        pending_tool_events = []

            proj_final = inferred_proj or fallback_tool_proj or ws_proj or "(unassigned)"
            # Backfill inferred project onto requests of this session
            for r in reversed(all_requests):
                if r["cid"] != cid:
                    break
                r["project"] = proj_final

            session_base[cid] = {
                "cid": cid,
                "title": meta_entry.get("title") or (f"{agent_type} ({cid[:8]})" if meta_entry.get("parent") else "Untitled Session"),
                "preview": (meta_entry.get("preview") or "")[:140],
                "workspace": proj_final,
                "agent": agent_type,
                "parent": meta_entry.get("parent") or (sub_tuple[2] if sub_tuple else ""),
                "killed": bool(meta_entry.get("killed", False)),
                "last_modified": meta_entry.get("last_modified", ""),
                "first_ts": first_ts or 0,
                "last_ts": last_ts or 0,
                "turns": turns_cnt,
                "subagents": subagents_cnt,
                "is_internal_worker": is_internal_worker,
                "initial_model": initial_models.get(cid, "Gemini 4 Argon (Medium)")
            }
        except Exception:
            pass

    # Link attached internal worker children & inherit parent project workspaces transitively
    for pcid, child_set in attached_internal_children.items():
        if pcid in session_base:
            valid_children = sum(1 for ch in child_set if ch in session_base)
            session_base[pcid]["subagents"] += valid_children

    reqs_by_cid = defaultdict(list)
    for r in all_requests:
        reqs_by_cid[r["cid"]].append(r)

    def _needs_parent_proj(proj_val):
        return (not proj_val) or proj_val in ("(unassigned)", "~") or str(proj_val).startswith("~/.gemini/")

    for cid, sb in session_base.items():
        if sb.get("parent") and _needs_parent_proj(sb.get("workspace")):
            cur_p = sb.get("parent")
            hops = 0
            while cur_p and hops < 4:
                psb = session_base.get(cur_p)
                if not psb:
                    break
                cand_w = psb.get("workspace")
                if not _needs_parent_proj(cand_w):
                    sb["workspace"] = cand_w
                    for req_item in reqs_by_cid.get(cid, ()):
                        req_item["project"] = cand_w
                    break
                cur_p = psb.get("parent")
                hops += 1

    all_requests.sort(key=lambda x: x["ts"], reverse=True)
    errors.sort(key=lambda x: x["ts"], reverse=True)
    frustrations.sort(key=lambda x: x["ts"], reverse=True)

    daily_out = {}
    for dt_k, dv in sorted(daily.items()):
        daily_out[dt_k] = {
            **dv,
            "pct_5h": units_to_pct_5h(dv["units"], 2),
            "pct_week": units_to_pct_week(dv["units"], 2)
        }

    quota_pools = fetch_live_quota()
    elapsed_ms = int((time.time() - t0) * 1000)

    _TELEMETRY_CACHE = {
        "scan_ms": elapsed_ms,
        "sessions_count": len(paths_items),
        "subagents_count": sum(1 for s in session_base.values() if s["parent"]),
        "killed_count": sum(1 for s in session_base.values() if s["killed"]),
        "transcript_paths": transcript_paths,
        "all_requests": all_requests,
        "all_errors": errors,
        "all_frustrations": frustrations,
        "user_turn_events": user_turn_events,
        "tool_events": tool_events,
        "session_base": session_base,
        "conv_meta": conv_meta,
        "initial_models": initial_models,
        "daily": daily_out,
        "commands": dict(commands.most_common(20)),
        "files_read": dict(files_read.most_common(15)),
        "files_edited": dict(files_edited.most_common(15)),
        "quota": quota_pools
    }
    _TELEMETRY_CACHE_TIME = now
    return _TELEMETRY_CACHE

def _ms_to_utc_iso(ms):
    return datetime.fromtimestamp(ms / 1000.0, tz=timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

def _build_pool_pacing(
    pool_key,
    label,
    full_name,
    wk_pool,
    fh_pool,
    local_wk_pct,
    local_5h_pct,
    wk_reset_ms,
    fh_reset_ms,
    now_ms,
    avg_wk_pct_per_req,
    pool_reqs=None,
    sessions_per_day=2.5,
):
    period_5h_ms = 5 * 3600 * 1000
    period_wk_ms = 7 * 86400 * 1000
    is_3p_pool = (pool_key == "3p")
    burst_to_wk_pct = get_pool_burst_to_wk_pct(pool_key)
    pool_reqs = pool_reqs or []

    wk_cycle_start_ms = (wk_reset_ms - period_wk_ms) if wk_reset_ms else (now_ms - period_wk_ms)
    fh_cycle_start_ms = (fh_reset_ms - period_5h_ms) if fh_reset_ms else (now_ms - period_5h_ms)
    wk_cycle_since = datetime.fromtimestamp(wk_cycle_start_ms / 1000).astimezone().strftime("%b %d %H:%M")
    fh_cycle_since = datetime.fromtimestamp(fh_cycle_start_ms / 1000).astimezone().strftime("%H:%M")

    wk_elapsed_pct = round(max(0.0, min(100.0, ((now_ms - wk_cycle_start_ms) / period_wk_ms) * 100.0)), 1)
    fh_elapsed_pct = round(max(0.0, min(100.0, ((now_ms - fh_cycle_start_ms) / period_5h_ms) * 100.0)), 1)

    raw_local_wk_pct = round(min(100.0, max(0.0, float(local_wk_pct))), 2)
    raw_local_5h_pct = round(min(100.0, max(0.0, float(local_5h_pct))), 2)

    wk_used = round(float(wk_pool.get("usedPct", raw_local_wk_pct)), 2) if wk_pool else raw_local_wk_pct
    wk_rem = round(float(wk_pool.get("remainingPct", max(0.0, 100.0 - wk_used))), 2) if wk_pool else round(max(0.0, 100.0 - wk_used), 2)
    fh_used = round(float(fh_pool.get("usedPct", raw_local_5h_pct)), 2) if fh_pool else raw_local_5h_pct
    fh_rem = round(float(fh_pool.get("remainingPct", max(0.0, 100.0 - fh_used))), 2) if fh_pool else round(max(0.0, 100.0 - fh_used), 2)

    bar_local_wk_pct = round(min(wk_used, raw_local_wk_pct), 2) if wk_pool else raw_local_wk_pct
    bar_local_5h_pct = round(min(fh_used, raw_local_5h_pct), 2) if fh_pool else raw_local_5h_pct

    other_wk = round(max(0.0, wk_used - bar_local_wk_pct), 2)
    other_5h = round(max(0.0, fh_used - bar_local_5h_pct), 2)

    wk_rem_hours = max(0.05, ((wk_reset_ms - now_ms) / 3_600_000.0) if (wk_reset_ms and wk_reset_ms > now_ms) else ((100.0 - wk_elapsed_pct) / 100.0 * 168.0))
    wk_el_hours = max(0.05, 168.0 - wk_rem_hours)
    wk_rem_days = wk_rem_hours / 24.0
    wk_el_days = wk_el_hours / 24.0

    fh_rem_hours = max(0.02, ((fh_reset_ms - now_ms) / 3_600_000.0) if (fh_reset_ms and fh_reset_ms > now_ms) else ((100.0 - fh_elapsed_pct) / 100.0 * 5.0))
    fh_el_hours = max(0.02, 5.0 - fh_rem_hours)

    # Strictly clamp rolling local lookbacks to active server reset cycle boundaries (never leak pre-reset burn)
    eff_cutoff_1h = max(now_ms - 3_600_000, fh_cycle_start_ms)
    eff_cutoff_24h = max(now_ms - 86_400_000, wk_cycle_start_ms)
    cutoff_7d = now_ms - 7 * 86_400_000
    u_1h = 0.0
    u_24h = 0.0
    local_wk_reqs = 0
    local_5h_reqs = 0
    hr_buckets_7d = Counter()
    hr_buckets_all = Counter()
    for r in pool_reqs:
        rts = r["ts"]
        ru = r["units"]
        hb = rts // 3_600_000
        hr_buckets_all[hb] += ru
        if rts >= cutoff_7d:
            hr_buckets_7d[hb] += ru
        if rts >= wk_cycle_start_ms:
            local_wk_reqs += 1
        if rts >= fh_cycle_start_ms:
            local_5h_reqs += 1
        if rts >= eff_cutoff_24h:
            u_24h += ru
        if rts >= eff_cutoff_1h:
            u_1h += ru

    loc_1h_span_h = max(0.25, min(1.0, (now_ms - eff_cutoff_1h) / 3_600_000.0))
    loc_24h_span_d = max(0.25, min(1.0, (now_ms - eff_cutoff_24h) / 86_400_000.0))
    local_1h_5h_rate = round(units_to_pct_5h(u_1h, 4, is_3p=is_3p_pool) / loc_1h_span_h, 2)
    local_24h_wk_rate = round(units_to_pct_week(u_24h, 4) / loc_24h_span_d, 2)
    active_hr_src = hr_buckets_7d if len(hr_buckets_7d) >= 3 else hr_buckets_all
    peak_1h_wk_pct = round(units_to_pct_week(max(active_hr_src.values()), 3), 2) if active_hr_src else 0.0

    if wk_reset_ms and fh_reset_ms and wk_reset_ms > fh_reset_ms:
        after_fh_hours = max(0.0, (wk_reset_ms - fh_reset_ms) / 3_600_000.0)
    elif not wk_reset_ms:
        after_fh_hours = max(0.0, wk_rem_hours - fh_rem_hours)
    else:
        after_fh_hours = 0.0

    if after_fh_hours > 0.05:
        full_extra = int(after_fh_hours // 5.0)
        rem_sliver_h = after_fh_hours - (full_extra * 5.0)
        extra_5h_windows = full_extra + (min(1.0, rem_sliver_h / 1.0) if rem_sliver_h > 0.05 else 0.0)
    else:
        extra_5h_windows = 0.0

    def _eval_view(v_wk_used, v_wk_rem, v_fh_used, v_fh_rem, v_wk_rate_day, v_fh_rate_hr, v_fh_src, v_src_actual):
        v_burst_win_left = round((v_fh_rem / 100.0) + extra_5h_windows, 1)
        v_smooth_cal_left = round(max(0.1, (v_fh_rem / 100.0) + (after_fh_hours / 5.0)), 1)
        v_max_add_wk = round(v_burst_win_left * burst_to_wk_pct, 1)
        v_max_final_wk = round(min(100.0, v_wk_used + v_max_add_wk), 1)
        v_wk_unkillable = bool(v_wk_rem > (v_burst_win_left * burst_to_wk_pct + 0.5) and v_wk_rem > 1.0)

        v_wk_cycle_day = v_wk_used / wk_el_days
        v_wk_cycle_hr = v_wk_used / wk_el_hours
        v_wk_rate_hr = v_wk_rate_day / 24.0
        v_wk_safe_hr = v_wk_rem / wk_rem_hours
        v_wk_safe_day = v_wk_rem / wk_rem_days

        v_fh_win_hr = v_fh_used / fh_el_hours
        v_fh_safe_hr = v_fh_rem / fh_rem_hours

        v_wk_warmup = bool(wk_el_hours < 6.0 and v_wk_used < 12.0)
        v_fh_warmup = bool(fh_el_hours < 0.25 and v_fh_used < 15.0)

        v_wk_unclipped = round(min(999.0, v_wk_used + v_wk_rate_hr * wk_rem_hours), 1)
        v_fh_unclipped = round(min(999.0, v_fh_used + v_fh_rate_hr * fh_rem_hours), 1)

        v_wk_ratio = round(v_wk_rate_day / (100.0 / 7.0), 2)
        v_fh_ratio = round(v_fh_rate_hr / 20.0, 2)

        v_wk_tte = round(v_wk_rem / v_wk_rate_hr, 2) if v_wk_rate_hr > 0.01 else None
        v_wk_short = round(max(0.0, wk_rem_hours - v_wk_tte), 2) if (v_wk_tte is not None and v_wk_tte < wk_rem_hours) else 0.0

        v_fh_tte = round(v_fh_rem / v_fh_rate_hr, 2) if v_fh_rate_hr > 0.05 else None
        v_fh_short = round(max(0.0, fh_rem_hours - v_fh_tte), 2) if (v_fh_tte is not None and v_fh_tte < fh_rem_hours) else 0.0

        v_wk_clock_delta = round(v_wk_used - wk_elapsed_pct, 1)
        v_fh_clock_delta = round(v_fh_used - fh_elapsed_pct, 1)
        v_less_than_one_burst = bool(v_wk_rem < burst_to_wk_pct and v_wk_rem > 0.05 and wk_rem_hours > 12.0)

        # Stock-vs-clock & compressed-runway warning gates (avoids Day-1 sleep/wake false alarms while catching 80% w/ 4d left)
        v_wk_overpace = bool(
            v_wk_short > 0.5 and (
                (v_wk_clock_delta >= 12.0 and (v_wk_used >= 35.0 or v_wk_safe_day <= 11.0))
                or (v_wk_used >= 75.0 and v_wk_clock_delta >= 5.0)
                or (wk_rem_days >= 1.0 and v_wk_safe_day <= 8.5)
                or (v_wk_unclipped >= 125.0 and v_wk_used >= 40.0 and v_wk_clock_delta >= 12.0)
            )
        )
        v_wk_runway_crushed = bool(wk_rem_days >= 1.25 and v_wk_safe_day <= 7.5 and v_wk_used >= 50.0)
        v_wk_run_out = bool(not v_wk_unkillable and not v_wk_warmup and (v_wk_rem <= 0.1 or v_wk_overpace or v_wk_runway_crushed))

        v_wk_caution = bool(
            not v_wk_unkillable and not v_wk_warmup and not v_wk_run_out and v_wk_rem > 0.1 and (
                v_wk_clock_delta >= 7.0
                or (wk_rem_days >= 1.5 and v_wk_safe_day <= 11.0)
                or (v_wk_unclipped >= 105.0 and v_wk_used >= 20.0)
            )
        )

        v_fh_run_out = bool(
            not v_fh_warmup and (
                v_fh_rem <= 0.1
                or (v_fh_short > 0.12 and (v_fh_used >= 25.0 or v_fh_clock_delta >= 15.0))
            )
        )

        v_target_wk_mult = round(v_wk_safe_day / v_wk_rate_day, 2) if v_wk_rate_day >= 0.35 else None
        v_target_5h_mult = round(v_fh_safe_hr / v_fh_rate_hr, 2) if v_fh_rate_hr >= 0.4 else None

        raw_awake = wk_rem_days * sessions_per_day
        v_awake_left = round(min(v_smooth_cal_left, max(min(1.0, v_smooth_cal_left), raw_awake)), 1)
        v_tanks_equiv = round(v_wk_rem / burst_to_wk_pct, 1)
        tanks_exact = v_wk_rem / burst_to_wk_pct
        v_smooth_sess = int(round((tanks_exact / max(0.2, v_awake_left)) * 100.0)) if v_wk_rem > 0.05 else 0
        v_smooth_24x7 = int(round((tanks_exact / max(0.2, v_smooth_cal_left)) * 100.0)) if v_wk_rem > 0.05 else 0

        v_sprint_hrs = round(v_wk_rem / peak_1h_wk_pct, 1) if peak_1h_wk_pct >= 0.05 else None
        v_est_reqs = int(round(v_wk_rem / max(0.0002, avg_wk_pct_per_req)))
        v_est_fh_reqs = int(round(((v_fh_rem / 100.0) * burst_to_wk_pct) / max(0.0002, avg_wk_pct_per_req)))

        return {
            "key": pool_key,
            "label": label,
            "fullName": full_name,
            "sourceActual": v_src_actual,
            "available": bool(wk_pool or fh_pool or raw_local_wk_pct > 0 or raw_local_5h_pct > 0),
            "wkCycleSince": wk_cycle_since,
            "fhCycleSince": fh_cycle_since,
            "serverWkUsedPct": v_wk_used,
            "serverWkRemPct": v_wk_rem,
            "localWkUsedPct": bar_local_wk_pct if v_src_actual == "server" else raw_local_wk_pct,
            "rawLocalWkUsedPct": raw_local_wk_pct,
            "localWkReqs": local_wk_reqs,
            "otherWkUsedPct": other_wk if v_src_actual == "server" else 0.0,
            "wkElapsedPct": wk_elapsed_pct,
            "wkClockDelta": v_wk_clock_delta,
            "wkElapsedDays": round(wk_el_days, 2),
            "wkRemainingDays": round(wk_rem_days, 2),
            "wkElapsedHours": round(wk_el_hours, 2),
            "wkRemainingHours": round(wk_rem_hours, 2),
            "serverWkPaceRatio": v_wk_ratio,
            "localWkPaceRatio": round(raw_local_wk_pct / max(2.0, wk_elapsed_pct), 2),
            "serverWkProjectedPct": round(min(100.0, v_wk_unclipped), 1),
            "serverWkUnclippedPct": v_wk_unclipped,
            "localWkProjectedPct": round(min(100.0, raw_local_wk_pct / max(0.02, wk_elapsed_pct / 100.0)), 1),
            "serverWkRatePerDay": round(v_wk_rate_day, 2),
            "cycleWkRatePerDay": round(v_wk_cycle_day, 2),
            "local24hWkRatePerDay": local_24h_wk_rate,
            "serverWkRatePerHour": round(v_wk_rate_hr, 2),
            "cycleWkRatePerHour": round(v_wk_cycle_hr, 2),
            "localWkRatePerDay": round(raw_local_wk_pct / wk_el_days, 2),
            "safeDailyBudgetLeft": round(v_wk_safe_day, 1),
            "safeHourlyBudgetLeft": round(v_wk_safe_hr, 2),
            "targetWkMultiplier": v_target_wk_mult,
            "wkTteHours": v_wk_tte,
            "wkShortfallHours": v_wk_short,
            "wkUnkillable": v_wk_unkillable,
            "wkWarmup": v_wk_warmup,
            "wkWillRunOut": v_wk_run_out,
            "wkCaution": v_wk_caution,
            "wkLessThanOneBurst": v_less_than_one_burst,
            "maxReachableAddWkPct": v_max_add_wk,
            "maxFinalWkPct": v_max_final_wk,
            "burstWindowsLeft": v_burst_win_left,
            "smoothCalWindowsLeft": v_smooth_cal_left,
            "awake5hSessionsLeft": v_awake_left,
            "sessionsPerDay": round(sessions_per_day, 1),
            "smooth5hSessionPct": v_smooth_sess,
            "smooth5h24x7Pct": v_smooth_24x7,
            "burstToWkPct": round(burst_to_wk_pct, 1),
            "wkTanksTotal": round(100.0 / burst_to_wk_pct, 1),
            "fhUsedAsWkPct": round((v_fh_used / 100.0) * burst_to_wk_pct, 2),
            "fhRemAsWkPct": round((v_fh_rem / 100.0) * burst_to_wk_pct, 2),
            "burstRatioCalibrated": bool(pool_key in _CALIBRATED_BURST_TO_WK_PCT),
            "burstTanksEquivLeft": v_tanks_equiv,
            "peak1hWkPct": peak_1h_wk_pct,
            "sprintHoursLeft": v_sprint_hrs,
            "estReqsLeft": v_est_reqs,
            "est5hReqsLeft": v_est_fh_reqs,
            "server5hUsedPct": v_fh_used,
            "server5hRemPct": v_fh_rem,
            "local5hUsedPct": bar_local_5h_pct if v_src_actual == "server" else raw_local_5h_pct,
            "rawLocal5hUsedPct": raw_local_5h_pct,
            "local5hReqs": local_5h_reqs,
            "other5hUsedPct": other_5h if v_src_actual == "server" else 0.0,
            "fhElapsedPct": fh_elapsed_pct,
            "fhClockDelta": v_fh_clock_delta,
            "fhElapsedHours": round(fh_el_hours, 2),
            "fhRemainingHours": round(fh_rem_hours, 2),
            "server5hPaceRatio": v_fh_ratio,
            "local5hPaceRatio": round(raw_local_5h_pct / max(4.0, fh_elapsed_pct), 2),
            "server5hProjectedPct": round(min(100.0, v_fh_unclipped), 1),
            "server5hUnclippedPct": v_fh_unclipped,
            "local5hProjectedPct": round(min(100.0, raw_local_5h_pct / max(0.02, fh_elapsed_pct / 100.0)), 1),
            "server5hRatePerHour": round(v_fh_rate_hr, 2),
            "window5hRatePerHour": round(v_fh_win_hr, 2),
            "local1h5hRatePerHour": local_1h_5h_rate,
            "fhRateSource": v_fh_src,
            "local5hRatePerHour": round(raw_local_5h_pct / fh_el_hours, 2),
            "safe5hHourlyBudgetLeft": round(v_fh_safe_hr, 1),
            "target5hMultiplier": v_target_5h_mult,
            "fhTteHours": v_fh_tte,
            "fhShortfallHours": v_fh_short,
            "fhWarmup": v_fh_warmup,
            "fhWillRunOut": v_fh_run_out,
            "wkResetTime": wk_pool.get("resetTime", "") if wk_pool else "",
            "fhResetTime": fh_pool.get("resetTime", "") if fh_pool else "",
        }

    # 1. Pure Server Pool View (100% server /usage stock-vs-clock + in-cycle server snapshot deltas; zero local token math)
    srv_rates = _RECENT_SERVER_RATES.get(pool_key) or {}
    srv_cycle_wk_day = wk_used / wk_el_days
    if wk_pool is not None:
        srv_rec_wk = srv_rates.get("wk_day")
        if srv_rec_wk is not None:
            srv_wk_rate_day = max(srv_cycle_wk_day, 0.6 * float(srv_rec_wk) + 0.4 * srv_cycle_wk_day)
        else:
            srv_wk_rate_day = srv_cycle_wk_day
        srv_actual = "server"
    else:
        loc_cyc = raw_local_wk_pct / wk_el_days
        srv_wk_rate_day = (0.6 * local_24h_wk_rate + 0.4 * loc_cyc) if (local_24h_wk_rate > 0 or loc_cyc > 0) else 0.0
        srv_actual = "local_fallback"

    srv_win_fh_hr = fh_used / fh_el_hours
    if fh_pool is not None:
        srv_rec_fh = srv_rates.get("fh_hr")
        if srv_rec_fh is not None and float(srv_rec_fh) > (srv_win_fh_hr + 0.5):
            srv_fh_rate_hr = float(srv_rec_fh)
            srv_fh_src = "recent server"
        else:
            srv_fh_rate_hr = srv_win_fh_hr
            srv_fh_src = "5h window"
    else:
        srv_fh_rate_hr = max(srv_win_fh_hr, local_1h_5h_rate)
        srv_fh_src = "last 1h" if local_1h_5h_rate > (srv_win_fh_hr + 0.5) else "5h window"

    srv_view = _eval_view(wk_used, wk_rem, fh_used, fh_rem, srv_wk_rate_day, srv_fh_rate_hr, srv_fh_src, srv_actual)

    # 2. Pure In-Cycle Local Setup View (for Multi-Surface / Local counting users; strictly clamped to current reset cycle)
    loc_wk_rem = round(max(0.0, 100.0 - raw_local_wk_pct), 2)
    loc_fh_rem = round(max(0.0, 100.0 - raw_local_5h_pct), 2)
    loc_cycle_wk_day = raw_local_wk_pct / wk_el_days
    loc_wk_rate_day = (0.6 * local_24h_wk_rate + 0.4 * loc_cycle_wk_day) if (local_24h_wk_rate > 0 or loc_cycle_wk_day > 0) else 0.0
    loc_win_fh_hr = raw_local_5h_pct / fh_el_hours
    loc_fh_rate_hr = max(loc_win_fh_hr, local_1h_5h_rate)
    loc_fh_src = "last 1h" if local_1h_5h_rate > (loc_win_fh_hr + 0.5) else "5h window"

    srv_view["localView"] = _eval_view(
        raw_local_wk_pct, loc_wk_rem, raw_local_5h_pct, loc_fh_rem,
        loc_wk_rate_day, loc_fh_rate_hr, loc_fh_src, "local",
    )
    return srv_view

def compute_stats_for_range(range_str="all", from_ms=None, to_ms=None):
    telemetry = load_raw_telemetry()
    all_reqs = telemetry["all_requests"]
    now_ms = int(time.time() * 1000)
    period_5h_ms = 5 * 3600 * 1000
    period_wk_ms = 7 * 86400 * 1000

    # Resolve live server reset cycle boundaries (5h and Weekly), rolling forward if a cached reset_time just passed
    raw_quota_list = telemetry.get("quota") or []
    gem_5h_raw = next((q for q in raw_quota_list if q.get("id") == "gemini-5h"), None)
    gem_wk_raw = next((q for q in raw_quota_list if q.get("id") == "gemini-weekly"), None)
    tp_5h_raw = next((q for q in raw_quota_list if q.get("id") == "3p-5h"), None)
    tp_wk_raw = next((q for q in raw_quota_list if q.get("id") == "3p-weekly"), None)

    raw_fh_reset_ms = parse_iso_ms(gem_5h_raw.get("resetTime")) if gem_5h_raw else None
    raw_wk_reset_ms = parse_iso_ms(gem_wk_raw.get("resetTime")) if gem_wk_raw else None
    raw_tp_fh_reset_ms = parse_iso_ms(tp_5h_raw.get("resetTime")) if tp_5h_raw else None
    raw_tp_wk_reset_ms = parse_iso_ms(tp_wk_raw.get("resetTime")) if tp_wk_raw else None

    fh_reset_ms = _project_reset_ms(raw_fh_reset_ms, period_5h_ms, now_ms)
    wk_reset_ms = _project_reset_ms(raw_wk_reset_ms, period_wk_ms, now_ms)
    tp_fh_reset_ms = _project_reset_ms(raw_tp_fh_reset_ms, period_5h_ms, now_ms)
    tp_wk_reset_ms = _project_reset_ms(raw_tp_wk_reset_ms, period_wk_ms, now_ms)

    fh_cycle_start_ms = (fh_reset_ms - period_5h_ms) if fh_reset_ms else (now_ms - period_5h_ms)
    wk_cycle_start_ms = (wk_reset_ms - period_wk_ms) if wk_reset_ms else (now_ms - period_wk_ms)
    tp_fh_cycle_start_ms = (tp_fh_reset_ms - period_5h_ms) if tp_fh_reset_ms else (now_ms - period_5h_ms)
    tp_wk_cycle_start_ms = (tp_wk_reset_ms - period_wk_ms) if tp_wk_reset_ms else (now_ms - period_wk_ms)

    fh_cycle_since = datetime.fromtimestamp(fh_cycle_start_ms / 1000).astimezone().strftime("%H:%M")
    wk_cycle_since = datetime.fromtimestamp(wk_cycle_start_ms / 1000).astimezone().strftime("%b %d %H:%M")
    fh_elapsed_pct = round(max(0.0, min(100.0, ((now_ms - fh_cycle_start_ms) / period_5h_ms) * 100.0)), 1)
    wk_elapsed_pct = round(max(0.0, min(100.0, ((now_ms - wk_cycle_start_ms) / period_wk_ms) * 100.0)), 1)

    cycle_5h_units = sum(r["units"] for r in all_reqs if r["ts"] >= fh_cycle_start_ms and not _is_3p_model(r["model"]))
    cycle_wk_units = sum(r["units"] for r in all_reqs if r["ts"] >= wk_cycle_start_ms and not _is_3p_model(r["model"]))
    cycle_3p_5h_units = sum(r["units"] for r in all_reqs if r["ts"] >= tp_fh_cycle_start_ms and _is_3p_model(r["model"]))
    cycle_3p_wk_units = sum(r["units"] for r in all_reqs if r["ts"] >= tp_wk_cycle_start_ms and _is_3p_model(r["model"]))

    range_configs = {
        "1h":  {"span_ms": 3600 * 1000,       "bucket_ms": 300 * 1000,   "unit": "5m", "desc": "Per 5m",   "label": "1h"},
        "5h":  {"span_ms": 5 * 3600 * 1000,   "bucket_ms": 300 * 1000,   "unit": "5m", "desc": "Per 5m",   "label": "5h"},
        "24h": {"span_ms": 86400 * 1000,      "bucket_ms": 3600 * 1000,  "unit": "1h", "desc": "Per hour", "label": "24h"},
        "7d":  {"span_ms": 7 * 86400 * 1000,  "bucket_ms": 86400 * 1000, "unit": "1d", "desc": "Per day",  "label": "7d"},
        "30d": {"span_ms": 30 * 86400 * 1000, "bucket_ms": 86400 * 1000, "unit": "1d", "desc": "Per day",  "label": "30d"},
        "90d": {"span_ms": 90 * 86400 * 1000, "bucket_ms": 86400 * 1000, "unit": "1d", "desc": "Per day",  "label": "90d"},
        "all": {"span_ms": None,              "bucket_ms": 86400 * 1000, "unit": "1d", "desc": "Per day",  "label": "all"}
    }

    if range_str == "custom" and from_ms is not None and to_ms is not None:
        start_ms = min(int(from_ms), int(to_ms))
        end_ms = max(int(from_ms), int(to_ms))
        span_ms = max(60_000, end_ms - start_ms)
        if span_ms <= 6 * 3600 * 1000:
            bucket_ms, unit, desc = 300 * 1000, "5m", "Per 5m"
        elif span_ms <= 48 * 3600 * 1000:
            bucket_ms, unit, desc = 3600 * 1000, "1h", "Per hour"
        else:
            bucket_ms, unit, desc = 86400 * 1000, "1d", "Per day"
        d_from = datetime.fromtimestamp(start_ms / 1000).astimezone().strftime("%b %d %H:%M")
        d_to = datetime.fromtimestamp(end_ms / 1000).astimezone().strftime("%b %d %H:%M")
        label = f"{d_from} – {d_to}"
        in_time = lambda ts: start_ms <= ts <= end_ms
        start_bucket = (start_ms // bucket_ms) * bucket_ms
        cur_bucket = (end_ms // bucket_ms) * bucket_ms
    else:
        cfg = range_configs.get(range_str, range_configs["all"])
        range_str = range_str if range_str in range_configs else "all"
        span_ms = cfg["span_ms"]
        bucket_ms = cfg["bucket_ms"]
        unit = cfg["unit"]
        desc = cfg["desc"]
        label = cfg["label"]
        cutoff = (now_ms - span_ms) if span_ms is not None else 0
        in_time = lambda ts: ts >= cutoff
        cur_bucket = (now_ms // bucket_ms) * bucket_ms
        if span_ms is not None:
            start_bucket = cur_bucket - span_ms + bucket_ms
        else:
            oldest_ts = all_reqs[-1]["ts"] if all_reqs else now_ms
            start_bucket = (oldest_ts // bucket_ms) * bucket_ms

    is_short_window = bool(span_ms is not None and span_ms < 86400 * 1000)
    is_subweek_window = bool(span_ms is not None and span_ms <= 7 * 86400 * 1000)

    in_range = [r for r in all_reqs if in_time(r["ts"])]
    errs_in_range = [e for e in telemetry["all_errors"] if in_time(e["ts"])]
    frust_in_range = [f for f in telemetry["all_frustrations"] if in_time(f["ts"])]
    turns_by_cid = Counter()
    turns_in_range = 0
    for u_cid, u_ts in telemetry["user_turn_events"]:
        if in_time(u_ts):
            turns_in_range += 1
            turns_by_cid[u_cid] += 1
    tools_in_range = [te for te in telemetry["tool_events"] if in_time(te["ts"])]

    bucket_map = {}
    t = start_bucket
    # Cap bucket count at 400 to prevent huge loops on multi-year empty spans
    if (cur_bucket - start_bucket) // max(1, bucket_ms) > 400:
        start_bucket = cur_bucket - 400 * bucket_ms
        t = start_bucket
    while t <= cur_bucket:
        bucket_map[t] = {"requests": 0, "errors": 0, "tokens": 0, "units": 0.0}
        t += bucket_ms

    tot_in = 0
    tot_out = 0
    tot_cch = 0
    tot_units = 0.0
    tot_errors = 0
    durs = []
    measured_durs = []
    measured_out = 0

    agent_counts = defaultdict(lambda: {"requests": 0, "in": 0, "out": 0, "cache": 0, "total": 0, "units": 0.0, "errors": 0})
    models_agg = defaultdict(lambda: {"in": 0, "out": 0, "cache": 0, "total": 0, "units": 0.0, "steps": 0, "errors": 0, "tools": 0, "durations": [], "measured_durs": []})
    sess_agg = defaultdict(lambda: {"in": 0, "out": 0, "cache": 0, "total": 0, "units": 0.0, "steps": 0, "errors": 0, "tools": 0, "models": set(), "first_ts": None, "last_ts": None})

    for r in in_range:
        inp = r["in"]
        out = r["out"]
        cch = r["cache"]
        tot = r["total"]
        qu = r["units"]
        is_err = r["is_err"]
        ag = r["agent"]
        dur = r["durationMs"]
        dur_meas = bool(r.get("durMeasured"))
        m_name = r["model"]
        cid = r["cid"]

        tot_in += inp
        tot_out += out
        tot_cch += cch
        tot_units += qu
        if is_err:
            tot_errors += 1
        durs.append(dur)
        if dur_meas:
            measured_durs.append(dur)
            measured_out += out

        ag_entry = agent_counts[ag]
        ag_entry["requests"] += 1
        ag_entry["in"] += inp
        ag_entry["out"] += out
        ag_entry["cache"] += cch
        ag_entry["total"] += tot
        ag_entry["units"] += qu
        if is_err:
            ag_entry["errors"] += 1

        ma = models_agg[m_name]
        ma["in"] += inp
        ma["out"] += out
        ma["cache"] += cch
        ma["total"] += tot
        ma["units"] += qu
        ma["steps"] += 1
        ma["tools"] += len(r["tools"])
        if is_err:
            ma["errors"] += 1
        if len(ma["durations"]) < 800:
            ma["durations"].append(dur)
        if dur_meas and len(ma["measured_durs"]) < 800:
            ma["measured_durs"].append(dur)

        sa = sess_agg[cid]
        sa["in"] += inp
        sa["out"] += out
        sa["cache"] += cch
        sa["total"] += tot
        sa["units"] += qu
        sa["steps"] += 1
        sa["tools"] += len(r["tools"])
        sa["models"].add(m_name)
        if sa["first_ts"] is None or r["ts"] < sa["first_ts"]:
            sa["first_ts"] = r["ts"]
        if sa["last_ts"] is None or r["ts"] > sa["last_ts"]:
            sa["last_ts"] = r["ts"]

        b_key = (r["ts"] // bucket_ms) * bucket_ms
        if b_key in bucket_map:
            bucket_map[b_key]["requests"] += 1
            if is_err:
                bucket_map[b_key]["errors"] += 1
            bucket_map[b_key]["tokens"] += tot
            bucket_map[b_key]["units"] += qu

    for e in errs_in_range:
        sess_agg[e["cid"]]["errors"] += 1

    frust_by_model = Counter(f["model"] for f in frust_in_range)
    frust_cats = Counter(f["category"] for f in frust_in_range)

    models_clean = {}
    for m_name, mv in sorted(models_agg.items(), key=lambda x: x[1]["units"], reverse=True):
        mdurs = sorted(mv["measured_durs"]) if mv["measured_durs"] else sorted(mv["durations"])
        models_clean[m_name] = {
            "in": mv["in"],
            "out": mv["out"],
            "cache": mv["cache"],
            "total": mv["total"],
            "steps": mv["steps"],
            "errors": mv["errors"],
            "tools": mv["tools"],
            "medianMs": mdurs[len(mdurs) // 2] if mdurs else 0,
            "p95Ms": mdurs[min(len(mdurs) - 1, int(len(mdurs) * 0.95))] if mdurs else 0,
            "pct_5h": units_to_pct_5h(mv["units"], 2, is_3p=_is_3p_model(m_name)),
            "pct_week": units_to_pct_week(mv["units"], 2),
            "is3p": _is_3p_model(m_name),
            "frustrations": frust_by_model.get(m_name, 0)
        }

    # Sessions & Projects in range
    session_base = telemetry["session_base"]
    projects_agg = defaultdict(lambda: {"sessions": 0, "requests": 0, "errors": 0, "in": 0, "out": 0, "cache": 0, "total": 0, "units": 0.0})
    sessions_list = []
    for cid, sa in sess_agg.items():
        if sa["steps"] == 0 and sa["errors"] == 0:
            continue
        sb = session_base.get(cid, {})
        proj = sb.get("workspace") or "(unassigned)"
        f_ts = sa["first_ts"] or sb.get("first_ts") or 0
        l_ts = sa["last_ts"] or sb.get("last_ts") or 0
        dur_s = max(1000, (l_ts - f_ts) if (f_ts and l_ts and l_ts >= f_ts) else sa["steps"] * 1200)

        pe = projects_agg[proj]
        pe["sessions"] += 1
        pe["requests"] += sa["steps"]
        pe["errors"] += sa["errors"]
        pe["in"] += sa["in"]
        pe["out"] += sa["out"]
        pe["cache"] += sa["cache"]
        pe["total"] += sa["total"]
        pe["units"] += sa["units"]

        p_5h = units_to_pct_5h(sa["units"], 2)
        p_wk = units_to_pct_week(sa["units"], 2)
        c_rate = round((sa["cache"] / max(1, sa["in"] + sa["cache"])) * 100.0, 1)
        avg_ctx = (sa["in"] + sa["cache"]) // max(1, sa["steps"])
        sess_turns = turns_by_cid.get(cid, 0) if range_str != "all" else sb.get("turns", 0)
        turns_val = max(1, sess_turns or sa["steps"])

        sessions_list.append({
            "cid": cid,
            "title": sb.get("title", "Untitled Session"),
            "preview": sb.get("preview", ""),
            "workspace": proj,
            "agent": sb.get("agent", "Lead"),
            "models": sorted(list(sa["models"])) if sa["models"] else [sb.get("initial_model", "Gemini 4 Argon (Medium)")],
            "turns": sess_turns,
            "steps": sa["steps"],
            "tools": sa["tools"],
            "subagents": sb.get("subagents", 0),
            "in": sa["in"],
            "out": sa["out"],
            "cache": sa["cache"],
            "total": sa["total"],
            "units": round(sa["units"], 4),
            "cacheRate": c_rate,
            "avgContextTokens": avg_ctx,
            "pct_5h": p_5h,
            "pct_week": p_wk,
            "pctWeekPerTurn": round(p_wk / turns_val, 3),
            "errors": sa["errors"],
            "durationMs": dur_s,
            "first_ts": f_ts,
            "last_ts": l_ts,
            "parent": sb.get("parent", ""),
            "killed": sb.get("killed", False)
        })
    sessions_list.sort(key=lambda x: (x["units"], x["total"], x["last_ts"]), reverse=True)

    projects_list = []
    for proj, pv in sorted(projects_agg.items(), key=lambda x: x[1]["units"], reverse=True):
        projects_list.append({
            "project": proj,
            "sessions": pv["sessions"],
            "requests": pv["requests"],
            "errors": pv["errors"],
            "in": pv["in"],
            "out": pv["out"],
            "cache": pv["cache"],
            "total": pv["total"],
            "cacheRate": round((pv["cache"] / max(1, pv["in"] + pv["cache"])) * 100, 1),
            "pct_5h": units_to_pct_5h(pv["units"], 2),
            "pct_week": units_to_pct_week(pv["units"], 2)
        })

    # Tools in range
    t_agg = defaultdict(lambda: {"calls": 0, "errors": 0, "args_chars": 0, "result_chars": 0, "tokens_share": 0, "units_share": 0.0, "models": Counter(), "last_used": ""})
    cmds_in_range = Counter()
    fread_in_range = Counter()
    fedit_in_range = Counter()
    for te in tools_in_range:
         tv = t_agg[te["tool"]]
         tv["calls"] += 1
         if te["is_err"]:
             tv["errors"] += 1
         tv["args_chars"] += te["args_chars"]
         tv["result_chars"] += te["result_chars"]
         tv["tokens_share"] += te["tokens_share"]
         tv["units_share"] += te["units_share"]
         tv["models"][te["model"]] += 1
         if te["time"] > tv["last_used"]:
             tv["last_used"] = te["time"]
         if te.get("cmd_bin"):
             cmds_in_range[te["cmd_bin"]] += 1
         if te.get("file_read"):
             fread_in_range[te["file_read"]] += 1
         if te.get("file_edited"):
             fedit_in_range[te["file_edited"]] += 1

    tools_detailed = []
    for tname, tv in sorted(t_agg.items(), key=lambda x: x[1]["calls"], reverse=True)[:25]:
        top_m = tv["models"].most_common(1)[0][0] if tv["models"] else "Gemini"
        tools_detailed.append({
            "tool": tname,
            "calls": tv["calls"],
            "errors": tv["errors"],
            "errorRate": round((tv["errors"] / max(1, tv["calls"])) * 100, 1),
            "argsChars": tv["args_chars"],
            "resultChars": tv["result_chars"],
            "avgResultChars": tv["result_chars"] // max(1, tv["calls"]),
            "tokensShare": tv["tokens_share"],
            "pct5hShare": units_to_pct_5h(tv["units_share"], 2),
            "pctWeekShare": units_to_pct_week(tv["units_share"], 2),
            "topModel": top_m,
            "lastUsed": tv["last_used"]
        })

    # Error signatures in range
    eg_agg = defaultdict(lambda: {"count": 0, "models": Counter(), "latest": "", "sample": ""})
    for e in errs_in_range:
        eg = eg_agg[e["signature"]]
        eg["count"] += 1
        eg["models"][e["model"]] += 1
        if e["time"] > eg["latest"]:
            eg["latest"] = e["time"]
            eg["sample"] = e["msg"]
    error_signatures_list = [
        {
            "signature": sig,
            "count": ev["count"],
            "topModel": ev["models"].most_common(1)[0][0] if ev["models"] else "Unknown",
            "latest": ev["latest"],
            "sample": ev["sample"]
        }
        for sig, ev in sorted(eg_agg.items(), key=lambda x: x[1]["count"], reverse=True)[:30]
    ]

    tot_requests = len(in_range)
    tot_conv = tot_in + tot_cch + tot_out
    cache_rate = tot_cch / max(1, tot_in + tot_cch)

    use_durs = sorted(measured_durs) if measured_durs else sorted(durs)
    avg_dur = sum(use_durs) / max(1, len(use_durs)) if use_durs else 0
    med_dur = use_durs[len(use_durs) // 2] if use_durs else 0
    p95_dur = use_durs[min(len(use_durs) - 1, int(len(use_durs) * 0.95))] if use_durs else 0
    avg_ttft = avg_dur * 0.28
    avg_tps = (measured_out / max(0.1, sum(measured_durs) / 1000.0)) if measured_durs else ((tot_out / max(0.1, sum(durs) / 1000.0)) if durs else 0.0)

    time_series = []
    for b_ts, b_val in sorted(bucket_map.items()):
        dt_obj = datetime.fromtimestamp(b_ts / 1000).astimezone()
        dt_label = dt_obj.strftime("%H:%M") if unit in ("5m", "1h") else dt_obj.strftime("%b %d")
        time_series.append({
            "timestamp": b_ts,
            "date": dt_label,
            "requests": b_val["requests"],
            "errors": b_val["errors"],
            "tokens": b_val["tokens"],
            "pct5h": units_to_pct_5h(b_val["units"], 2),
            "pctWeek": units_to_pct_week(b_val["units"], 2)
        })

    by_agent_type = []
    for ag_name, ag_val in sorted(agent_counts.items(), key=lambda x: x[1]["total"], reverse=True):
        ag_tot = ag_val["total"]
        by_agent_type.append({
            "agentType": ag_name,
            "totalRequests": ag_val["requests"],
            "totalInputTokens": ag_val["in"],
            "totalOutputTokens": ag_val["out"],
            "totalCacheReadTokens": ag_val["cache"],
            "totalCacheWriteTokens": 0,
            "totalTokens": ag_tot,
            "pctWeek": units_to_pct_week(ag_val["units"], 2),
            "share": round(ag_tot / max(1, tot_conv), 4),
            "errors": ag_val["errors"]
        })

    local_5h_cycle_pct = units_to_pct_5h(cycle_5h_units, 2, is_3p=False)
    local_wk_cycle_pct = units_to_pct_week(cycle_wk_units, 2)
    local_3p_5h_cycle_pct = units_to_pct_5h(cycle_3p_5h_units, 2, is_3p=True)
    local_3p_wk_cycle_pct = units_to_pct_week(cycle_3p_wk_units, 2)

    active_5h_gem_u = sum(r["units"] for r in in_range if not _is_3p_model(r["model"]) and r["ts"] >= fh_cycle_start_ms)
    active_5h_3p_u = sum(r["units"] for r in in_range if _is_3p_model(r["model"]) and r["ts"] >= tp_fh_cycle_start_ms)
    forgiven_5h_gem_u = sum(r["units"] for r in in_range if not _is_3p_model(r["model"]) and r["ts"] < fh_cycle_start_ms)
    forgiven_5h_3p_u = sum(r["units"] for r in in_range if _is_3p_model(r["model"]) and r["ts"] < tp_fh_cycle_start_ms)
    active_pct_5h_spent = round(units_to_pct_5h(active_5h_gem_u, 3, is_3p=False) + units_to_pct_5h(active_5h_3p_u, 3, is_3p=True), 2)
    forgiven_pct_5h_spent = round(units_to_pct_5h(forgiven_5h_gem_u, 3, is_3p=False) + units_to_pct_5h(forgiven_5h_3p_u, 3, is_3p=True), 2)

    active_wk_in_range_units = sum(
        r["units"] for r in in_range
        if r["ts"] >= (tp_wk_cycle_start_ms if _is_3p_model(r["model"]) else wk_cycle_start_ms)
    )
    prior_wk_in_range_units = sum(
        r["units"] for r in in_range
        if r["ts"] < (tp_wk_cycle_start_ms if _is_3p_model(r["model"]) else wk_cycle_start_ms)
    )
    active_pct_wk_spent = units_to_pct_week(active_wk_in_range_units, 2)
    prior_pct_wk_spent = units_to_pct_week(prior_wk_in_range_units, 2)

    effective_quota_list = []
    for q in raw_quota_list:
        qc = dict(q)
        qid = qc.get("id", "")
        qwin = qc.get("window", "")
        per_ms = period_5h_ms if qwin == "5h" or qid.endswith("-5h") else period_wk_ms
        q_raw_ms = parse_iso_ms(qc.get("resetTime"))
        if q_raw_ms and q_raw_ms <= now_ms:
            q_proj_ms = _project_reset_ms(q_raw_ms, per_ms, now_ms)
            qc["resetTime"] = _ms_to_utc_iso(q_proj_ms)
            loc_fallback = (
                local_5h_cycle_pct if qid == "gemini-5h" else
                local_wk_cycle_pct if qid == "gemini-weekly" else
                local_3p_5h_cycle_pct if qid == "3p-5h" else
                local_3p_wk_cycle_pct if qid == "3p-weekly" else 0.0
            )
            used_est = min(100.0, loc_fallback)
            qc["usedPct"] = round(used_est, 1)
            qc["remainingPct"] = round(max(0.0, 100.0 - used_est), 1)
            qc["remainingFraction"] = max(0.0, (100.0 - used_est) / 100.0)
        effective_quota_list.append(qc)

    gem_5h = next((q for q in effective_quota_list if q.get("id") == "gemini-5h"), None)
    gem_wk = next((q for q in effective_quota_list if q.get("id") == "gemini-weekly"), None)
    tp_5h = next((q for q in effective_quota_list if q.get("id") == "3p-5h"), None)
    tp_wk = next((q for q in effective_quota_list if q.get("id") == "3p-weekly"), None)

    gem_all = [r for r in all_reqs if not _is_3p_model(r["model"])]
    tp_all = [r for r in all_reqs if _is_3p_model(r["model"])]
    avg_gem_wk_per_req = (units_to_pct_week(sum(r["units"] for r in gem_all), 6) / len(gem_all)) if len(gem_all) >= 10 else 0.0015
    avg_tp_wk_per_req = (units_to_pct_week(sum(r["units"] for r in tp_all), 6) / len(tp_all)) if len(tp_all) >= 10 else 0.015

    active_5h_slots_7d = {r["ts"] // period_5h_ms for r in all_reqs if r["ts"] >= (now_ms - period_wk_ms)}
    sessions_per_day = round(min(3.2, max(2.0, len(active_5h_slots_7d) / 7.0)), 2) if len(active_5h_slots_7d) >= 4 else 2.5

    gem_pacing = _build_pool_pacing(
        "gemini", "Gemini", "Gemini Models",
        gem_wk, gem_5h, local_wk_cycle_pct, local_5h_cycle_pct,
        wk_reset_ms, fh_reset_ms, now_ms, avg_gem_wk_per_req,
        pool_reqs=gem_all, sessions_per_day=sessions_per_day,
    )
    tp_pacing = _build_pool_pacing(
        "3p", "Claude / GPT", "Claude and GPT models",
        tp_wk, tp_5h, local_3p_wk_cycle_pct, local_3p_5h_cycle_pct,
        tp_wk_reset_ms, tp_fh_reset_ms, now_ms, avg_tp_wk_per_req,
        pool_reqs=tp_all, sessions_per_day=sessions_per_day,
    )

    pacing = {
        **gem_pacing,
        "pools": {
            "gemini": gem_pacing,
            "3p": tp_pacing,
        },
    }

    range_gem_units = sum(r["units"] for r in in_range if not _is_3p_model(r["model"]))
    range_3p_units = sum(r["units"] for r in in_range if _is_3p_model(r["model"]))

    overall = {
        "range": range_str,
        "isShortWindow": is_short_window,
        "isSubweekWindow": is_subweek_window,
        "windowLabel": label,
        "unitDescription": desc,
        "unit": unit,
        "totalRequests": tot_requests,
        "totalSessionsInRange": len(sessions_list),
        "successfulRequests": max(0, tot_requests - tot_errors),
        "failedRequests": tot_errors,
        "errorRate": (tot_errors / max(1, tot_requests)) if tot_requests else 0.0,
        "totalInputTokens": tot_in,
        "totalOutputTokens": tot_out,
        "totalCacheReadTokens": tot_cch,
        "totalCacheWriteTokens": 0,
        "conversationTokens": tot_conv,
        "cacheRate": cache_rate,
        "cacheSavings": (tot_cch / max(1, tot_conv)) if tot_conv else 0.0,
        "totalSubagentRequests": sum(ag["totalRequests"] for ag in by_agent_type if ag["agentType"] != "Lead"),
        "avgDuration": avg_dur,
        "medianDuration": med_dur,
        "p95Duration": p95_dur,
        "avgTtft": avg_ttft,
        "avgTokensPerSecond": avg_tps,
        "pct5hSpent": units_to_pct_5h(tot_units, 2),
        "activePct5hSpent": active_pct_5h_spent,
        "forgivenPct5hSpent": forgiven_pct_5h_spent,
        "pctWeeklySpent": units_to_pct_week(tot_units, 2),
        "pctGeminiWeeklySpent": units_to_pct_week(range_gem_units, 2),
        "pct3pWeeklySpent": units_to_pct_week(range_3p_units, 2),
        "activePctWeekSpent": active_pct_wk_spent,
        "priorPctWeekSpent": prior_pct_wk_spent,
        "cycle5hLocalPct": local_5h_cycle_pct,
        "cycleWeekLocalPct": local_wk_cycle_pct,
        "cycle3p5hLocalPct": local_3p_5h_cycle_pct,
        "cycle3pWeekLocalPct": local_3p_wk_cycle_pct,
        "fhCycleSince": fh_cycle_since,
        "wkCycleSince": wk_cycle_since,
        "fhElapsedPct": fh_elapsed_pct,
        "wkElapsedPct": wk_elapsed_pct,
        "pacing": pacing
    }

    today_str = datetime.now().astimezone().strftime("%Y-%m-%d")
    today_entry = telemetry["daily"].get(today_str, {"in": 0, "out": 0, "cache": 0, "total": 0, "units": 0.0, "steps": 0, "errors": 0, "tools": 0, "pct_5h": 0.0, "pct_week": 0.0})

    return {
        "scan_ms": telemetry["scan_ms"],
        "sessions_count": len(sessions_list) if range_str != "all" else telemetry["sessions_count"],
        "total_sessions_count": telemetry["sessions_count"],
        "subagents_count": telemetry["subagents_count"],
        "killed_count": telemetry["killed_count"],
        "total_user_turns": turns_in_range,
        "overall": overall,
        "byAgentType": by_agent_type,
        "timeSeries": time_series,
        "recent_requests": in_range[:250],
        "daily": telemetry["daily"],
        "models": models_clean,
        "tools": {t["tool"]: t["calls"] for t in tools_detailed},
        "tools_detailed": tools_detailed,
        "commands": dict(cmds_in_range.most_common(20)) if range_str != "all" else telemetry["commands"],
        "files_read": dict(fread_in_range.most_common(15)) if range_str != "all" else telemetry["files_read"],
        "files_edited": dict(fedit_in_range.most_common(15)) if range_str != "all" else telemetry["files_edited"],
        "errors": errs_in_range[:250],
        "error_signatures": error_signatures_list,
        "frustrations": frust_in_range[:200],
        "frustration_categories": dict(frust_cats.most_common()),
        "projects": projects_list,
        "sessions": sessions_list,
        "quota": effective_quota_list,
        "today": {
            "date": today_str,
            **today_entry
        }
    }

def compute_overview_for_range(range_str="all", from_ms=None, to_ms=None):
    return compute_stats_for_range(range_str, from_ms, to_ms)

def collect_all_data():
    return compute_stats_for_range("all")

def build_session_trace(cid):
    if not cid or not re.match(r"^[0-9a-fA-F-]+$", cid):
        return {"error": "Invalid session id", "spans": []}
    telemetry = load_raw_telemetry()
    session_base = telemetry["session_base"]
    sb = session_base.get(cid, {})
    children_by_parent = defaultdict(list)
    for v in session_base.values():
        p_id = v.get("parent")
        if p_id:
            children_by_parent[p_id].append(v)

    children = []
    seen_desc = {cid}
    frontier = [(cid, 0)]
    while frontier:
        cur_id, depth = frontier.pop(0)
        if depth >= 3:
            continue
        for ch in sorted(children_by_parent.get(cur_id, ()), key=lambda x: x.get("first_ts", 0)):
            ch_id = ch["cid"]
            if ch_id not in seen_desc:
                seen_desc.add(ch_id)
                children.append(ch)
                frontier.append((ch_id, depth + 1))

    target_cids = [cid] + [c["cid"] for c in children]

    raw_spans = []
    tot_tokens = 0
    tot_units = 0.0
    tot_tools = 0
    tot_errors = 0
    models_seen = set()

    for t_cid in target_cids:
        if not _VALID_CID_RE.match(t_cid):
            continue
        t_sb = session_base.get(t_cid, {})
        ag = t_sb.get("agent", "Lead" if t_cid == cid else "subagent")
        cur_m = telemetry["initial_models"].get(t_cid, "Gemini 4 Argon (Medium)")
        tp = telemetry.get("transcript_paths", {}).get(t_cid)
        if not tp:
            for r_dir in _discover_agy_roots():
                cand_tp = os.path.join(r_dir, "brain", t_cid, ".system_generated", "logs", "transcript.jsonl")
                if os.path.exists(cand_tp):
                    tp = cand_tp
                    break
        if not tp or not os.path.exists(tp):
            continue
        prev_ts = None
        try:
            with open(tp, "r", encoding="utf-8", errors="replace") as f:
                for idx, line in enumerate(f):
                    if not line.strip():
                        continue
                    d = json.loads(line)
                    stype = d.get("type", "")
                    source = d.get("source", "")
                    raw_dt = d.get("created_at", "")
                    content = d.get("content", "")
                    if "Model Selection" in content:
                        m = MODEL_SELECTION_RE.search(content)
                        if m:
                            cur_m = m.group(2).strip()
                    ts_ms = 0
                    if raw_dt:
                        try:
                            ts_ms = int(datetime.fromisoformat(raw_dt.replace("Z", "+00:00")).timestamp() * 1000)
                        except Exception:
                            pass
                    dur_ms = max(120, min(90000, (ts_ms - prev_ts) if (prev_ts and ts_ms >= prev_ts) else 600))
                    if ts_ms > 0:
                        prev_ts = ts_ms

                    is_err = _is_step_error(d, stype, source, content)
                    if stype == "USER_INPUT" and source == "USER_EXPLICIT":
                        if t_cid != cid and t_sb.get("is_internal_worker"):
                            continue
                        req_m = re.search(r"<USER_REQUEST>(.*?)</USER_REQUEST>", content, re.DOTALL)
                        utxt = (req_m.group(1).strip() if req_m else content.strip())
                        if not utxt:
                            continue
                        raw_spans.append({
                            "id": f"{t_cid[:8]}-{idx}",
                            "cid": t_cid,
                            "step": idx,
                            "kind": "user",
                            "agent": "user",
                            "model": "User",
                            "time": raw_dt,
                            "ts": ts_ms,
                            "durationMs": 200,
                            "in": 0, "out": 0, "cache": 0, "total": 0,
                            "pct5h": 0.0, "pctWeek": 0.0,
                            "tools": [],
                            "isError": False,
                            "preview": utxt[:500]
                        })
                    elif stype == "PLANNER_RESPONSE" and "input_tokens" in d:
                        inp = int(d.get("input_tokens", 0) or 0)
                        out = int(d.get("output_tokens", 0) or 0)
                        cch = int(d.get("cache_read_tokens", 0) or 0)
                        tot = inp + out + cch
                        qu = compute_quota_units(cur_m, inp, out, cch)
                        tcalls = [tc.get("name", "tool") for tc in d.get("tool_calls", [])]
                        tot_tokens += tot
                        tot_units += qu
                        tot_tools += len(tcalls)
                        if is_err:
                            tot_errors += 1
                        models_seen.add(cur_m)
                        raw_spans.append({
                            "id": f"{t_cid[:8]}-{idx}",
                            "cid": t_cid,
                            "step": idx,
                            "kind": "error" if is_err else ("subagent" if t_cid != cid else "model"),
                            "agent": ag,
                            "model": cur_m,
                            "time": raw_dt,
                            "ts": ts_ms,
                            "durationMs": dur_ms,
                            "in": inp, "out": out, "cache": cch, "total": tot,
                            "pct5h": units_to_pct_5h(qu, 3, is_3p=_is_3p_model(cur_m)),
                            "pctWeek": units_to_pct_week(qu, 3),
                            "tools": tcalls,
                            "isError": is_err,
                            "preview": (content[:500] if content else (", ".join(tcalls) if tcalls else "Model turn"))
                        })
                    elif is_err:
                        tot_errors += 1
                        raw_spans.append({
                            "id": f"{t_cid[:8]}-{idx}",
                            "cid": t_cid,
                            "step": idx,
                            "kind": "error",
                            "agent": ag,
                            "model": cur_m,
                            "time": raw_dt,
                            "ts": ts_ms,
                            "durationMs": dur_ms,
                            "in": 0, "out": 0, "cache": 0, "total": 0,
                            "pct5h": 0.0, "pctWeek": 0.0,
                            "tools": [],
                            "isError": True,
                            "preview": content[:800] if content else "Execution error"
                        })
        except Exception:
            pass

    raw_spans.sort(key=lambda s: (s["ts"], s["step"]))
    valid_ts = [s["ts"] for s in raw_spans if s["ts"] > 0]
    min_ts = min(valid_ts) if valid_ts else 0
    max_ts = max((s["ts"] + s["durationMs"]) for s in raw_spans if s["ts"] > 0) if valid_ts else 1000
    total_dur = max(1000, max_ts - min_ts)

    for i, sp in enumerate(raw_spans):
        if sp["ts"] > 0 and min_ts > 0:
            off = ((sp["ts"] - min_ts) / total_dur) * 100.0
            wid = max(0.8, (sp["durationMs"] / total_dur) * 100.0)
            if off + wid > 100.0:
                wid = max(0.8, 100.0 - off)
        else:
            off = (i / max(1, len(raw_spans))) * 96.0
            wid = max(1.0, 96.0 / max(1, len(raw_spans)))
        sp["offsetPct"] = round(off, 2)
        sp["widthPct"] = round(wid, 2)

    return {
        "cid": cid,
        "title": sb.get("title", f"Session {cid[:8]}"),
        "agent": sb.get("agent", "Lead"),
        "workspace": sb.get("workspace", "~/Projects"),
        "parent": sb.get("parent", ""),
        "models": sorted(list(models_seen)) if models_seen else [sb.get("initial_model", "Gemini")],
        "durationMs": total_dur,
        "totalTokens": tot_tokens,
        "pct5h": units_to_pct_5h(tot_units, 2),
        "pctWeek": units_to_pct_week(tot_units, 2),
        "stepsCount": len(raw_spans),
        "toolsCount": tot_tools,
        "errorsCount": tot_errors,
        "subagents": [{"cid": c["cid"], "title": c["title"], "agent": c["agent"]} for c in children],
        "spans": raw_spans[:300]
    }

# ============================================================================
# CLI Output Renderers (Zero Emojis)
# ============================================================================
def draw_bar(pct, width=22):
    filled = int(round((min(max(pct, 0), 100) / 100.0) * width))
    empty = width - filled
    color = C.GREEN if pct > 50 else (C.YELLOW if pct > 20 else C.RED)
    return f"{color}{'█' * filled}{C.DIM}{'░' * empty}{C.RESET}"

def print_cli_summary(data):
    ov = data["overall"]
    td = data["today"]
    print(f"{C.BOLD}{C.CYAN}[AGY TELEMETRY]{C.RESET} {C.BOLD}{data['total_sessions_count']} sessions{C.RESET} ({data['subagents_count']} subagents) | {C.GREEN}{format_num(ov['totalRequests'])} requests{C.RESET} | {C.YELLOW}{ov['conversationTokens']/1e9:.2f}B tokens{C.RESET} ({ov['cacheRate']*100:.1f}% cache) | Today ({td['date']}): {C.BOLD}{td['total']/1e6:.1f}M tok{C.RESET} ({td['pct_week']:.2f}% wk quota)")

def print_cli_quota(data):
    groups = data["quota"]
    if not groups:
        return
    print(f"\n{C.BOLD}{C.CYAN}LIVE QUOTA POOLS & RUNWAY{C.RESET}")
    print(f"{C.DIM}{'─' * 84}{C.RESET}")
    print(f"  {C.BOLD}{'Pool / Window':<34} {'Remaining':<24} {'Used':>8}   {'Resets In':>12}{C.RESET}")
    print(f"{C.DIM}{'─' * 84}{C.RESET}")
    now = datetime.now().astimezone()
    for g in groups:
        rem = g.get("remainingPct", round(g.get("remainingFraction", 0) * 100, 1))
        used = g.get("usedPct", round(100.0 - rem, 1))
        label = f"{g.get('groupName', '')} · {g.get('windowLabel', '')}"
        r_str = g.get("resetTime", "")
        try:
            r_dt = datetime.fromisoformat(r_str.replace("Z", "+00:00")).astimezone()
            diff = int((r_dt - now).total_seconds())
            reset_disp = f"{diff//86400}d {(diff%86400)//3600}h" if diff > 86400 else f"{max(0,diff)//3600}h {(max(0,diff)%3600)//60}m"
        except Exception:
            reset_disp = r_str[:16]
        print(f"  {label:<34} {draw_bar(rem, 16)} {rem:>5.1f}%   {used:>6.1f}%   {C.DIM}{reset_disp:>12}{C.RESET}")

    p_root = data.get("overall", {}).get("pacing")
    if p_root:
        def _fmt_hrs_cli(h):
            if h is None:
                return "–"
            total_m = max(1, int(round(h * 60)))
            if total_m >= 1440:
                return f"{total_m // 1440}d {(total_m % 1440) // 60}h"
            if total_m >= 60:
                return f"{total_m // 60}h {total_m % 60}m"
            return f"{total_m}m"

        def _meter(pct, width=16, color=""):
            fill = int(round((min(max(pct, 0), 100) / 100.0) * width))
            emp = width - fill
            return f"{color}{'█' * fill}{C.DIM}{'░' * emp}{C.RESET}"

        q_mode_cli = load_config().get("web", {}).get("quota_mode", "server")
        pools_dict = p_root.get("pools") or {"gemini": p_root}
        for pk in ("gemini", "3p"):
            base_p = pools_dict.get(pk)
            if not base_p or not base_p.get("available"):
                continue
            p = (base_p.get("localView") or base_p) if q_mode_cli == "multi" else base_p
            if pk == "3p" and base_p.get("serverWkUsedPct", 0) <= 0 and base_p.get("server5hUsedPct", 0) <= 0 and p.get("serverWkUsedPct", 0) <= 0:
                continue

            wk_rem_h = float(p.get("wkRemainingHours", 24.0))
            fh_rem_h = float(p.get("fhRemainingHours", 5.0))
            reset_disp = _fmt_hrs_cli(wk_rem_h)
            fh_reset_disp = _fmt_hrs_cli(fh_rem_h)
            pace_ratio = float(p.get("serverWkPaceRatio", 1.0))
            cur_day_rate = float(p.get("serverWkRatePerDay", 0.0))
            safe_day_rate = float(p.get("safeDailyBudgetLeft", 0.0))
            wk_mult = p.get("targetWkMultiplier")
            sm_sess = int(p.get("smooth5hSessionPct", 0))
            sm_24x7 = int(p.get("smooth5h24x7Pct", 0))
            aw_sess = float(p.get("awake5hSessionsLeft", 1.0))
            cal_win = float(p.get("smoothCalWindowsLeft", 1.0))
            max_fin = float(p.get("maxFinalWkPct", 100.0))
            clock_delta = float(p.get("wkClockDelta", float(p.get("serverWkUsedPct", 0.0)) - float(p.get("wkElapsedPct", 0.0))))
            b2w = float(p.get("burstToWkPct", 25.0))

            if float(p.get("serverWkRemPct", 100.0)) <= 0.05:
                pace_pill = f"{C.BOLD}{C.RED}[EXHAUSTED]{C.RESET}"
                quota_color = C.RED
                runout_str = f"Already exhausted (0% left · resets in {reset_disp})"
                pace_100_str = "0x — wait for weekly reset or switch model pool"
                smooth_str = "0% available until weekly reset"
            elif p.get("wkWarmup"):
                pace_pill = f"{C.BOLD}{C.CYAN}[WARMING UP]{C.RESET}"
                quota_color = C.GREEN
                runout_str = "Calibrating (fresh weekly cycle < 6h elapsed)"
                pace_100_str = f"Aim for ~{safe_day_rate:.1f}%/day (~{p.get('estReqsLeft', 0):,} reqs left)"
                smooth_str = f"~{min(100, sm_sess)}% per 5h session (~{aw_sess:.0f} awake sessions · ~{sm_24x7}% if 24/7)"
            elif p.get("wkUnkillable"):
                pace_pill = f"{C.BOLD}{C.GREEN}[UNKILLABLE WK]{C.RESET}"
                quota_color = C.GREEN
                runout_str = f"Impossible before reset (finishes near ~{max_fin:.0f}% wk even if every 5h window is maxed)"
                mult_lbl = f"{wk_mult:.1f}x your pace needed — exceeds 5h cap" if wk_mult else "exceeds 5h cap"
                pace_100_str = f"Go all-out ({mult_lbl})"
                smooth_str = f"Max 100% every 5h window (~{cal_win:.1f} windows left · ~{p.get('burstTanksEquivLeft', 0):.1f} tanks of wk left)"
            elif p.get("wkWillRunOut"):
                pace_pill = f"{C.BOLD}{C.RED}[HIGH BURN {pace_ratio:.1f}x]{C.RESET}"
                quota_color = C.RED
                tte_s = _fmt_hrs_cli(p.get("wkTteHours"))
                short_s = _fmt_hrs_cli(p.get("wkShortfallHours"))
                ahead_note = f" · +{clock_delta:.0f}% ahead of clock" if clock_delta >= 5.0 else ""
                burst_warn = f" · <1 full 5h burst ({b2w:.0f}% wk) left" if p.get("wkLessThanOneBurst") else ""
                if p.get("wkTteHours") is not None and float(p.get("wkShortfallHours", 0)) > 0.25:
                    runout_str = f"Yes — empties in ~{tte_s} ({short_s} before reset{ahead_note}{burst_warn})"
                else:
                    runout_str = f"Tight runway — {p['serverWkRemPct']:.1f}% left for {reset_disp} ({safe_day_rate:.1f}%/day cap{ahead_note}{burst_warn})"
                mult_s = f"{wk_mult:.2f}x" if (wk_mult is not None and wk_mult < 1.0) else (f"{wk_mult:.1f}x" if wk_mult is not None else None)
                pace_100_str = (
                    f"{mult_s} your current pace (<= {safe_day_rate:.1f}%/day target vs ~{cur_day_rate:.1f}%/day now)"
                    if mult_s else f"Cap at <= {safe_day_rate:.1f}%/day"
                )
                smooth_str = f"Aim for ~{sm_sess}% per 5h session (~{aw_sess:.0f} awake sessions · ~{sm_24x7}% if 24/7)"
            elif p.get("wkCaution"):
                ahead_lbl = f"+{max(1.0, clock_delta):.0f}% AHEAD" if clock_delta >= 1.0 else f"{pace_ratio:.1f}x PACE"
                pace_pill = f"{C.BOLD}{C.YELLOW}[CAUTION · {ahead_lbl}]{C.RESET}"
                quota_color = C.YELLOW
                runout_str = f"Ahead of weekly clock — keep <= {safe_day_rate:.1f}%/day across {reset_disp} to avoid running dry"
                mult_s = f"{wk_mult:.2f}x" if (wk_mult is not None and wk_mult < 1.0) else f"{(wk_mult or 0.8):.1f}x"
                pace_100_str = f"{mult_s} your current pace (<= {safe_day_rate:.1f}%/day target vs ~{cur_day_rate:.1f}%/day now)"
                smooth_str = f"Aim for ~{sm_sess}% per 5h session (~{aw_sess:.0f} awake sessions · ~{sm_24x7}% if 24/7)"
            elif p.get("serverWkUnclippedPct", 0) >= 85.0:
                pace_pill = f"{C.BOLD}{C.GREEN}[ON TARGET {pace_ratio:.1f}x]{C.RESET}"
                quota_color = C.GREEN
                runout_str = f"No — lands near ~{min(100.0, p['serverWkUnclippedPct']):.0f}% at reset"
                mult_s = f"{wk_mult:.2f}x" if (wk_mult is not None and wk_mult < 1.0) else f"{(wk_mult or 1.0):.1f}x"
                pace_100_str = f"{mult_s} your current pace (hold steady: ~{cur_day_rate:.1f}%/day vs {safe_day_rate:.1f}%/day target)"
                smooth_str = (
                    f"Aim for ~{sm_sess}% per 5h session (~{aw_sess:.0f} awake sessions · ~{sm_24x7}% if 24/7)"
                    if sm_sess <= 95 else (
                        f"Max 100% every 5h window (~{cal_win:.1f} windows left)"
                        if sm_24x7 > 100 else f"Max ~100% per active 5h session (or ~{sm_24x7}% across all {cal_win:.1f} windows)"
                    )
                )
            else:
                pace_pill = f"{C.BOLD}{C.GREEN}[UNDER PACE {pace_ratio:.1f}x]{C.RESET}"
                quota_color = C.GREEN
                unused = max(0.0, 100.0 - float(p.get("serverWkUnclippedPct", 0.0)))
                runout_str = f"No — lands at ~{p['serverWkUnclippedPct']:.0f}% (~{unused:.0f}% unused at reset)"
                if wk_mult is not None and wk_mult <= 15.0:
                    pace_100_str = f"{wk_mult:.1f}x your current pace ({safe_day_rate:.1f}%/day target vs ~{cur_day_rate:.1f}%/day now)"
                else:
                    pace_100_str = f"Idle pace — room for {safe_day_rate:.1f}%/day (~{p.get('estReqsLeft', 0):,} reqs left)"
                smooth_str = (
                    f"Aim for ~{sm_sess}% per 5h session (~{aw_sess:.0f} awake sessions · no 100% maxing needed)"
                    if sm_sess <= 95 else (
                        f"Max 100% every 5h window (~{cal_win:.1f} windows left)"
                        if sm_24x7 > 100 else f"Max ~100% per active 5h session (or ~{sm_24x7}% across all {cal_win:.1f} windows)"
                    )
                )

            src_tag = " · LOCAL SETUP" if q_mode_cli == "multi" else ""
            used_row_lbl = "This setup used:" if q_mode_cli == "multi" else "Server pool used:"
            print(f"\n{C.BOLD}{C.CYAN}PACING & RUNWAY · {p.get('fullName', pk).upper()}{src_tag}{C.RESET}")
            print(f"{C.DIM}{'─' * 84}{C.RESET}")
            print(f"  {pace_pill}  Weekly: {p['serverWkUsedPct']:.1f}% used ({p['serverWkRemPct']:.1f}% left · resets in {reset_disp})")
            time_bar = _meter(p['wkElapsedPct'], 16, C.DIM)
            quota_bar = _meter(p['serverWkUsedPct'], 16, quota_color)
            print(f"    {'Week clock elapsed:':<24} {time_bar}  {p['wkElapsedPct']:>5.1f}%")
            print(f"    {used_row_lbl:<24} {quota_bar}  {p['serverWkUsedPct']:>5.1f}%")
            print(f"    {'Will it run out?:':<24} {runout_str}")
            print(f"    {'Pace to finish 100%:':<24} {pace_100_str}")
            print(f"    {'Smooth 5h strategy:':<24} {smooth_str}")
            fh_mult = p.get("target5hMultiplier")
            fh_src = p.get("fhRateSource", "5h window")
            if p.get("fhWillRunOut"):
                fh_note = f"empties ~{_fmt_hrs_cli(p['fhShortfallHours'])} early — slow to {(fh_mult or 0.5):.2f}x ({fh_src})"
            elif fh_mult and fh_mult <= 12.0:
                fh_note = f"{fh_mult:.1f}x room vs {fh_src} pace, ceiling {p['safe5hHourlyBudgetLeft']:.1f}%/hr"
            else:
                fh_note = f"ceiling {p['safe5hHourlyBudgetLeft']:.1f}%/hr"
            print(f"    {'5-Hour Burst:':<24} {p['server5hUsedPct']:.1f}% used · {p['server5hRemPct']:.1f}% left · refills in {fh_reset_disp} ({fh_note})")
            t_tot = float(p.get('wkTanksTotal', round(100.0 / max(1.0, b2w), 1)))
            print(f"    {'5h -> Weekly factor:':<24} {C.DIM}100% of 5h = {b2w:.1f}% of Weekly ({t_tot:.1f} full 5h tanks/wk · ~{p.get('burstTanksEquivLeft', 0):.1f} tanks left){C.RESET}")
            if p.get("sprintHoursLeft") and p.get("peak1hWkPct", 0) >= 0.05:
                print(f"    {'Peak sprint benchmark:':<24} {C.DIM}~{p['sprintHoursLeft']:.1f}h of coding left at your {p['peak1hWkPct']:.2f}%/hr peak hour{C.RESET}")
            if q_mode_cli == "multi":
                print(f"    {'Setup attribution:':<24} {C.DIM}This setup: {base_p['localWkUsedPct']:.2f}% | Other surfaces: {base_p['otherWkUsedPct']:.2f}% (Server total: {base_p['serverWkUsedPct']:.1f}%){C.RESET}")

def print_cli_tokens(data, limit_days=10):
    ov = data["overall"]
    td = data["today"]
    print(f"\n{C.BOLD}{C.CYAN}TOKEN SPENT OVERVIEW{C.RESET}")
    print(f"{C.DIM}{'─' * 84}{C.RESET}")
    print(f"  Conversation Tokens: {C.BOLD}{format_tokens(ov['conversationTokens'])}{C.RESET} | Cache Rate: {C.GREEN}{ov['cacheRate']*100:.1f}%{C.RESET} ({format_tokens(ov['totalCacheReadTokens'])} cached)")
    print(f"  Uncached Input:      {C.BOLD}{format_tokens(ov['totalInputTokens'])}{C.RESET} | Output Tokens: {C.BOLD}{format_tokens(ov['totalOutputTokens'])}{C.RESET}")
    print(f"  Today ({td['date']}):     {C.BOLD}{format_tokens(td['total'])}{C.RESET} ({td['pct_week']:.2f}% weekly quota)")
    print_cli_models(data)
    print_cli_days(data, limit_days)

def print_cli_models(data):
    print(f"\n{C.BOLD}{C.CYAN}MODELS{C.RESET}")
    print(f"{C.DIM}{'─' * 84}{C.RESET}")
    print(f"  {C.BOLD}{'Model':<30} {'Requests':>8} {'Input':>11} {'Output':>10} {'Cache':>12} {'Wk Quota':>10}{C.RESET}")
    print(f"{C.DIM}{'─' * 84}{C.RESET}")
    for m, st in data["models"].items():
        print(f"  {m:<30} {st['steps']:>8,} {st['in']/1e6:>10.2f}M {st['out']/1e6:>9.2f}M {st['cache']/1e6:>11.1f}M {C.CYAN}{st['pct_week']:>9.2f}%{C.RESET}")

def print_cli_days(data, limit_days):
    print(f"\n{C.BOLD}{C.CYAN}DAILY LEDGER ({'ALL' if limit_days >= 999 else f'LAST {limit_days}D'}){C.RESET}")
    print(f"{C.DIM}{'─' * 86}{C.RESET}")
    print(f"  {C.BOLD}{'Date':<12} {'Reqs':>7} {'Input':>11} {'Output':>10} {'Cache':>12} {'Total':>11} {'Wk Quota':>10}{C.RESET}")
    print(f"{C.DIM}{'─' * 86}{C.RESET}")
    items = list(data["daily"].items())[-limit_days:]
    for dt, st in items:
        mark = f"{C.GREEN}*{C.RESET}" if dt == data["today"]["date"] else " "
        print(f" {mark}{dt:<11} {st['steps']:>7,} {st['in']/1e6:>10.2f}M {st['out']/1e6:>9.2f}M {st['cache']/1e6:>11.1f}M {st['total']/1e6:>10.1f}M {C.CYAN}{st['pct_week']:>9.2f}%{C.RESET}")

def print_cli_sessions(data, limit=15):
    print(f"\n{C.BOLD}{C.CYAN}SESSIONS{C.RESET}")
    print(f"{C.DIM}{'─' * 90}{C.RESET}")
    print(f"  {C.BOLD}{'Session':<38} {'Agent':<12} {'Reqs':>6} {'Tokens':>10} {'Wk Quota':>10} {'Errs':>6}{C.RESET}")
    print(f"{C.DIM}{'─' * 90}{C.RESET}")
    by_tokens = sorted(data["sessions"], key=lambda x: x["pct_week"], reverse=True)[:limit]
    for s in by_tokens:
        title = (s["title"][:35] + "...") if len(s["title"]) > 38 else s["title"]
        role = (s["agent"][:11]) if s["agent"] else "Lead"
        print(f"  {title:<38} {role:<12} {s['steps']:>6,} {s['total']/1e6:>9.1f}M {C.CYAN}{s['pct_week']:>9.2f}%{C.RESET} {s['errors']:>6}")

def print_cli_tools(data):
    print(f"\n{C.BOLD}{C.CYAN}TOP TOOLS & SHELL COMMANDS{C.RESET}")
    print(f"{C.DIM}{'─' * 84}{C.RESET}")
    tools = list(data["tools"].items())[:12]
    cmds = list(data["commands"].items())[:12]
    for i in range(max(len(tools), len(cmds))):
        t_str = f"{tools[i][0]:<24} {tools[i][1]:>6,}" if i < len(tools) else " " * 31
        c_str = f"{cmds[i][0]:<22} {cmds[i][1]:>6,}" if i < len(cmds) else ""
        print(f"  {t_str}   │   {c_str}")

def print_cli_frustration(data):
    cats = data["frustration_categories"]
    frust = data["frustrations"]
    tot_f = sum(cats.values())
    rate = (tot_f / max(1, data["total_user_turns"])) * 100
    print(f"\n{C.BOLD}{C.CYAN}FRUSTRATION SIGNALS ({tot_f} detected / {rate:.1f}% of turns){C.RESET}")
    print(f"{C.DIM}{'─' * 84}{C.RESET}")
    cat_line = "  Categories: " + " | ".join(f"{k}: {C.YELLOW}{v}{C.RESET}" for k, v in sorted(cats.items(), key=lambda x: x[1], reverse=True))
    print(cat_line)
    print(f"{C.DIM}{'─' * 84}{C.RESET}")
    for f in frust[:10]:
        t_short = f["time"][:16].replace("T", " ")
        print(f"  {C.DIM}{t_short}{C.RESET}  [{C.RED}{f['category']:<10}{C.RESET}]  {f['detail'][:68]}")

OVERVIEW_SECTION_ITEMS = [
    ("summary",     "Summary & KPI Totals",        "Web Overview + CLI"),
    ("quota",       "Quota Pools & Weekly Pacing", "Web Overview + CLI"),
    ("models",      "Token Spend & Models",        "Web Overview + CLI"),
    ("days",        "Activity & Daily Ledger",     "Web Overview + CLI"),
    ("sessions",    "Top Sessions Leaderboard",    "Web Overview + CLI"),
    ("requests",    "Latest Requests Stream",      "Web Overview"),
    ("tools",       "Top Tools & Commands",        "CLI Overview"),
    ("frustration", "Frustration Signals",         "CLI Overview"),
]

MINIMALIST_DISABLED_SECTIONS = ["sessions", "requests", "tools", "frustration"]

def run_cli_view(view_name, data, disabled_sections=None, limit_days=10):
    disabled = set(disabled_sections or [])
    if view_name == "summary":
        print_cli_summary(data)
        return
    if view_name == "tokens":
        print_cli_tokens(data, limit_days)
        return
    if view_name == "quota":
        print_cli_quota(data)
        return
    if view_name == "sessions":
        print_cli_sessions(data, 20)
        return
    if view_name == "models":
        print_cli_models(data)
        return

    # Default: Overview respecting customized display sections
    cli_keys = ("summary", "quota", "models", "days", "sessions", "tools", "frustration")
    if "summary" not in disabled or all(k in disabled for k in cli_keys):
        print_cli_summary(data)
    if "quota" not in disabled:
        print_cli_quota(data)
    if "models" not in disabled:
        print_cli_models(data)
    if "days" not in disabled:
        print_cli_days(data, limit_days)
    if "sessions" not in disabled:
        print_cli_sessions(data, 15)
    if "tools" not in disabled:
        print_cli_tools(data)
    if "frustration" not in disabled:
        print_cli_frustration(data)

def _prompt_tty(prompt_str):
    if sys.stdin.isatty():
        return input(prompt_str)
    try:
        rlist, _, _ = select.select([sys.stdin], [], [], 0.0)
        if rlist:
            line = sys.stdin.readline()
            if line:
                sys.stdout.write(prompt_str)
                sys.stdout.flush()
                return line.rstrip("\r\n")
    except Exception:
        pass
    if os.path.exists("/dev/tty"):
        try:
            with open("/dev/tty", "r") as tty_in, open("/dev/tty", "w") as tty_out:
                tty_out.write(prompt_str)
                tty_out.flush()
                line = tty_in.readline()
                if not line:
                    raise EOFError
                return line.rstrip("\r\n")
        except (OSError, IOError):
            pass
    return input(prompt_str)

def _parse_semver(v_str):
    parts = re.findall(r"\d+", str(v_str or "0.0.0"))
    nums = [int(p) for p in parts[:3]]
    while len(nums) < 3:
        nums.append(0)
    return tuple(nums)

