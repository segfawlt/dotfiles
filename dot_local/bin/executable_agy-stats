FENCE_START = "# >>> agy-stats >>>"
FENCE_END = "# <<< agy-stats <<<"

POSIX_FENCED_BLOCK = (
    f"{FENCE_START}\n"
    "agy() {\n"
    '    if [ "$1" = "stats" ]; then\n'
    "        shift\n"
    "        if command -v agy-stats >/dev/null 2>&1; then\n"
    '            agy-stats "$@"\n'
    "        else\n"
    '            "$HOME/.local/bin/agy-stats" "$@"\n'
    "        fi\n"
    "    else\n"
    '        command agy "$@"\n'
    "    fi\n"
    "}\n"
    f"{FENCE_END}\n"
)

FISH_WRAPPER_CODE = (
    "# Managed by agy-stats\n"
    "function agy --wraps agy --description 'Antigravity CLI wrapper with stats subcommand support'\n"
    '    if test (count $argv) -ge 1 -a "$argv[1]" = "stats"\n'
    "        if command -q agy-stats\n"
    "            agy-stats $argv[2..-1]\n"
    '        else if test -x "$HOME/.local/bin/agy-stats"\n'
    '            "$HOME/.local/bin/agy-stats" $argv[2..-1]\n'
    "        else\n"
    '            echo "agy-stats not found at ~/.local/bin/agy-stats" >&2\n'
    "            return 127\n"
    "        end\n"
    "    else\n"
    "        command agy $argv\n"
    "    end\n"
    "end\n"
)

POWERSHELL_FENCED_BLOCK = (
    f"{FENCE_START}\n"
    "function agy-stats {\n"
    '    $script = Join-Path $HOME ".local\\bin\\agy-stats"\n'
    "    if (Get-Command py -CommandType Application -ErrorAction SilentlyContinue) {\n"
    "        & py -3 $script @args\n"
    "    } else {\n"
    "        & python $script @args\n"
    "    }\n"
    "}\n"
    "function agy {\n"
    '    if ($args.Count -ge 1 -and $args[0] -eq "stats") {\n'
    "        $rest = if ($args.Count -gt 1) { $args[1..($args.Count - 1)] } else { @() }\n"
    "        agy-stats @rest\n"
    "    } else {\n"
    "        $realAgy = Get-Command agy -CommandType Application -ErrorAction SilentlyContinue\n"
    "        if (-not $realAgy -and $env:LOCALAPPDATA) {\n"
    '            $cand = Join-Path $env:LOCALAPPDATA "agy\\bin\\agy.exe"\n'
    "            if (Test-Path $cand) { $realAgy = $cand }\n"
    "        }\n"
    "        if ($realAgy) {\n"
    "            & $realAgy @args\n"
    "        } else {\n"
    '            Write-Error "Antigravity CLI (\'agy\') not found. Run \'agy stats\' for telemetry or install Antigravity CLI."\n'
    "        }\n"
    "    }\n"
    "}\n"
    f"{FENCE_END}\n"
)

WINDOWS_CMD_SHIM = (
    "@echo off\r\n"
    "where py >nul 2>nul\r\n"
    "if %ERRORLEVEL% EQU 0 (\r\n"
    '    py -3 "%~dp0agy-stats" %*\r\n'
    ") else (\r\n"
    '    python "%~dp0agy-stats" %*\r\n'
    ")\r\n"
)

_LEGACY_RC_RE = re.compile(
    r"\n?# Antigravity CLI wrapper with stats support\n"
    r'(?:export PATH="\$HOME/\.local/bin:\$PATH"\n)?'
    r"agy\(\)\s*\{.*?\n\}\n?",
    re.DOTALL,
)
_FENCED_RC_RE = re.compile(
    re.escape(FENCE_START) + r".*?" + re.escape(FENCE_END) + r"\r?\n?",
    re.DOTALL,
)

def _get_powershell_profiles():
    override = os.environ.get("AGY_STATS_PS_PROFILE", "").strip()
    if override:
        return [(os.path.expanduser(override), "PowerShell")]
    if sys.platform != "win32":
        return []
    docs = os.path.join(os.path.expanduser("~"), "Documents")
    profiles = []
    ps7_dir = os.path.join(docs, "PowerShell")
    ps5_dir = os.path.join(docs, "WindowsPowerShell")
    if os.path.isdir(ps7_dir) or shutil.which("pwsh") is not None:
        profiles.append((os.path.join(ps7_dir, "Microsoft.PowerShell_profile.ps1"), "PowerShell 7"))
    profiles.append((os.path.join(ps5_dir, "Microsoft.PowerShell_profile.ps1"), "Windows PowerShell"))
    return profiles

def _detect_agy_surfaces_label():
    has_cli = os.path.isdir(os.path.expanduser("~/.gemini/antigravity-cli")) or (_find_agy_binary() is not None)
    has_desk = os.path.isdir(os.path.expanduser("~/.gemini/antigravity")) or os.path.isdir(os.path.expanduser("~/.gemini/antigravity-ide"))
    if has_cli and has_desk:
        return "Antigravity CLI + Desktop/IDE"
    if has_desk:
        return "Antigravity Desktop/IDE"
    if has_cli:
        return "Antigravity CLI"
    return "Antigravity CLI / Desktop (waiting for first session)"

def install_shell_integration(verbose=True, update_url=None):
    installed_actions = []
    local_bin = os.path.expanduser("~/.local/bin")
    target_bin = os.path.join(local_bin, "agy-stats")
    plat_key, plat_name, is_tested_linux = _detect_runtime_platform()

    if update_url:
        u_clean = str(update_url).strip()
        if u_clean.startswith(("https://", "file://")):
            save_config({"update_url": u_clean})

    # 1. Atomic user-space binary installation (~/.local/bin/agy-stats)
    try:
        current_script = os.path.abspath(__file__)
        os.makedirs(local_bin, exist_ok=True)
        if os.path.abspath(target_bin) != current_script and os.path.isfile(current_script):
            tmp_target = os.path.join(local_bin, f".agy-stats.tmp.{os.getpid()}")
            shutil.copy2(current_script, tmp_target)
            os.chmod(tmp_target, 0o755)
            os.replace(tmp_target, target_bin)
            installed_actions.append(f"Installed executable -> {target_bin}")
        elif os.path.exists(target_bin):
            os.chmod(target_bin, 0o755)

        if sys.platform == "win32":
            cmd_shim = os.path.join(local_bin, "agy-stats.cmd")
            existing_cmd = ""
            if os.path.exists(cmd_shim):
                with open(cmd_shim, "r", encoding="utf-8", errors="ignore") as f:
                    existing_cmd = f.read()
            if existing_cmd != WINDOWS_CMD_SHIM:
                with open(cmd_shim, "w", encoding="utf-8", newline="") as f:
                    f.write(WINDOWS_CMD_SHIM)
                installed_actions.append(f"Installed Windows launcher -> {cmd_shim}")
    except Exception as ex:
        if verbose:
            print(f"{C.YELLOW}Warning installing binary: {ex}{C.RESET}")

    # 2. Windows PowerShell $PROFILE integration (# >>> agy-stats >>> ... # <<< agy-stats <<<)
    for ps_path, ps_name in _get_powershell_profiles():
        try:
            os.makedirs(os.path.dirname(ps_path), exist_ok=True)
            content = ""
            if os.path.exists(ps_path):
                with open(ps_path, "r", encoding="utf-8", errors="replace") as f:
                    content = f.read()
            cleaned = _FENCED_RC_RE.sub("", content).rstrip()
            new_content = (cleaned + "\n\n" + POWERSHELL_FENCED_BLOCK) if cleaned else POWERSHELL_FENCED_BLOCK
            if new_content != content:
                with open(ps_path, "w", encoding="utf-8") as f:
                    f.write(new_content)
                installed_actions.append(f"Configured fenced {ps_name} hook -> {ps_path}")
        except Exception as ex:
            if verbose:
                print(f"{C.YELLOW}Warning configuring {ps_name}: {ex}{C.RESET}")

    # 3. Fish shell integration (~/.config/fish/functions/agy.fish, zero global PATH mutation)
    if sys.platform != "win32":
        fish_config_dir = os.path.expanduser("~/.config/fish")
        fish_available = os.path.isdir(fish_config_dir) or (shutil.which("fish") is not None)
        if fish_available:
            try:
                fish_funcs_dir = os.path.join(fish_config_dir, "functions")
                os.makedirs(fish_funcs_dir, exist_ok=True)
                fish_file = os.path.join(fish_funcs_dir, "agy.fish")
                existing_fish = ""
                if os.path.exists(fish_file):
                    with open(fish_file, "r", encoding="utf-8", errors="replace") as f:
                        existing_fish = f.read()
                if existing_fish != FISH_WRAPPER_CODE and (not existing_fish or "agy-stats" in existing_fish):
                    with open(fish_file, "w", encoding="utf-8") as f:
                        f.write(FISH_WRAPPER_CODE)
                    installed_actions.append(f"Configured Fish wrapper -> {fish_file}")
            except Exception as ex:
                if verbose:
                    print(f"{C.YELLOW}Warning configuring Fish shell: {ex}{C.RESET}")

        # 4. Bash & Zsh fenced integration (# >>> agy-stats >>> ... # <<< agy-stats <<<)
        user_shell = os.environ.get("SHELL", "")
        bashrc_path = os.path.expanduser("~/.bashrc")
        zshrc_path = os.path.expanduser("~/.zshrc")
        rc_targets = [
            (bashrc_path, "Bash", os.path.exists(bashrc_path) or user_shell.endswith("/bash")),
            (zshrc_path, "Zsh", os.path.exists(zshrc_path) or sys.platform == "darwin" or user_shell.endswith("/zsh")),
        ]
        for rc_path, shell_name, should_write in rc_targets:
            if should_write:
                try:
                    content = ""
                    if os.path.exists(rc_path):
                        with open(rc_path, "r", encoding="utf-8", errors="replace") as f:
                            content = f.read()
                    cleaned = _FENCED_RC_RE.sub("", content)
                    cleaned = _LEGACY_RC_RE.sub("\n", cleaned).rstrip()
                    new_content = (cleaned + "\n\n" + POSIX_FENCED_BLOCK) if cleaned else POSIX_FENCED_BLOCK
                    if new_content != content:
                        with open(rc_path, "w", encoding="utf-8") as f:
                            f.write(new_content)
                        installed_actions.append(f"Configured fenced {shell_name} hook -> {rc_path}")
                except Exception as ex:
                    if verbose:
                        print(f"{C.YELLOW}Warning configuring {shell_name}: {ex}{C.RESET}")

    if verbose:
        plat_badge = f"{plat_name} (Tested)" if is_tested_linux else f"{plat_name} (Untested)"
        if installed_actions:
            print(f"\n{C.BOLD}{C.GREEN}✓ Installation & Shell Integration Complete:{C.RESET}")
            for act in installed_actions:
                print(f"  • {act}")
        else:
            print(f"\n{C.BOLD}{C.GREEN}✓ Installation & shell hooks are already up to date (v{__version__}).{C.RESET}")
        print(f"  • Platform:  {plat_badge}")
        print(f"  • Surfaces:  {_detect_agy_surfaces_label()}")
        print(f"  • Footprint: ~/.local/bin/agy-stats + ~/.config/agy-stats/config.json")
        if not is_tested_linux:
            print(f"  • {C.YELLOW}[Notice] {plat_name} support is marked (Untested) — only native Linux is verified in production.{C.RESET}")
        shells_lbl = "PowerShell" if sys.platform == "win32" else "Fish, Bash, or Zsh"
        print(f"  • Ready:     run {C.CYAN}agy stats{C.RESET} in {shells_lbl}.\n")

    return installed_actions

def uninstall_agy_stats(purge=False, dry_run=False):
    actions = []
    local_bin = os.path.expanduser("~/.local/bin/agy-stats")
    local_cmd = os.path.expanduser("~/.local/bin/agy-stats.cmd")
    fish_file = os.path.expanduser("~/.config/fish/functions/agy.fish")

    # 1. Clean fenced blocks from ~/.bashrc and ~/.zshrc
    for rc_path, shell_name in [(os.path.expanduser("~/.bashrc"), "Bash"), (os.path.expanduser("~/.zshrc"), "Zsh")]:
        if os.path.exists(rc_path):
            try:
                with open(rc_path, "r", encoding="utf-8", errors="replace") as f:
                    content = f.read()
                cleaned_raw = _LEGACY_RC_RE.sub("\n", _FENCED_RC_RE.sub("", content))
                if not cleaned_raw.strip() and content.strip() == POSIX_FENCED_BLOCK.strip():
                    if not dry_run:
                        os.remove(rc_path)
                    actions.append(f"Removed {shell_name} hook file {rc_path}")
                else:
                    cleaned = re.sub(r"\n{3,}", "\n\n", cleaned_raw).rstrip() + ("\n" if cleaned_raw.strip() else "")
                    if cleaned != content:
                        if not dry_run:
                            with open(rc_path, "w", encoding="utf-8") as f:
                                f.write(cleaned)
                        actions.append(f"Removed {shell_name} hook block from {rc_path}")
            except Exception as ex:
                print(f"{C.YELLOW}Warning cleaning {rc_path}: {ex}{C.RESET}")

    # 2. Clean fenced blocks from PowerShell profiles
    for ps_path, ps_name in _get_powershell_profiles():
        if os.path.exists(ps_path):
            try:
                with open(ps_path, "r", encoding="utf-8", errors="replace") as f:
                    content = f.read()
                cleaned_raw = _FENCED_RC_RE.sub("", content)
                if not cleaned_raw.strip() and content.strip() == POWERSHELL_FENCED_BLOCK.strip():
                    if not dry_run:
                        os.remove(ps_path)
                    actions.append(f"Removed {ps_name} profile {ps_path}")
                else:
                    cleaned = re.sub(r"\n{3,}", "\n\n", cleaned_raw).rstrip() + ("\n" if cleaned_raw.strip() else "")
                    if cleaned != content:
                        if not dry_run:
                            with open(ps_path, "w", encoding="utf-8") as f:
                                f.write(cleaned)
                        actions.append(f"Removed {ps_name} hook block from {ps_path}")
            except Exception as ex:
                print(f"{C.YELLOW}Warning cleaning {ps_path}: {ex}{C.RESET}")

    # 3. Remove Fish function if managed by agy-stats
    if os.path.exists(fish_file):
        try:
            with open(fish_file, "r", encoding="utf-8", errors="replace") as f:
                fc = f.read()
            if "agy-stats" in fc:
                if not dry_run:
                    os.remove(fish_file)
                actions.append(f"Removed Fish wrapper {fish_file}")
        except Exception as ex:
            print(f"{C.YELLOW}Warning removing {fish_file}: {ex}{C.RESET}")

    # 4. Remove ~/.local/bin/agy-stats and ~/.local/bin/agy-stats.cmd
    for bin_p in (local_bin, local_cmd):
        if os.path.exists(bin_p):
            if not dry_run:
                try:
                    os.remove(bin_p)
                except Exception as ex:
                    print(f"{C.YELLOW}Warning removing {bin_p}: {ex}{C.RESET}")
            actions.append(f"Removed executable {bin_p}")

    # 5. Purge config directory if requested
    if purge and os.path.exists(CONFIG_DIR):
        if not dry_run:
            shutil.rmtree(CONFIG_DIR, ignore_errors=True)
        actions.append(f"Purged config directory {CONFIG_DIR}")

    prefix = "[DRY RUN] Would have executed" if dry_run else "✓ Uninstalled agy-stats cleanly (zero trace left)"
    print(f"\n{C.BOLD}{C.GREEN}{prefix}:{C.RESET}")
    if actions:
        for a in actions:
            print(f"  • {a}")
    else:
        print("  • Nothing to remove.")
    if not purge and os.path.exists(CONFIG_DIR):
        print(f"  {C.DIM}(Kept {CONFIG_PATH} — pass '--purge' to delete preferences too){C.RESET}")
    print()

_GH_RELEASE_URL_RE = re.compile(r"^https://github\.com/([^/]+)/([^/]+)/releases/(?:latest/download|download/[^/]+)/([^/?#]+)$")

class _RedirectTracker(urllib.request.HTTPRedirectHandler):
    def __init__(self):
        super().__init__()
        self.hops = []

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        full_new = urllib.parse.urljoin(req.full_url, newurl)
        self.hops.append((code, full_new))
        return super().redirect_request(req, fp, code, msg, headers, newurl)

def _resolve_migrated_github_url(orig_url, hops):
    """If github.com/<old_owner>/<old_repo> redirected to github.com/<new_owner>/<new_repo>,
    return the normalized latest-release URL on the new owner/repo (never objects.githubusercontent.com)."""
    m_orig = _GH_RELEASE_URL_RE.match(orig_url or "")
    if not m_orig:
        return None
    orig_owner, orig_repo, asset_name = m_orig.group(1), m_orig.group(2), m_orig.group(3)
    migrated = None
    for _code, hop_url in (hops or []):
        m_hop = _GH_RELEASE_URL_RE.match(hop_url or "")
        if m_hop:
            hop_owner, hop_repo = m_hop.group(1), m_hop.group(2)
            if (hop_owner.lower(), hop_repo.lower()) != (orig_owner.lower(), orig_repo.lower()):
                migrated = f"https://github.com/{hop_owner}/{hop_repo}/releases/latest/download/{asset_name}"
    return migrated

def _http_get_with_redirects(url, timeout=10, max_bytes=None):
    tracker = _RedirectTracker()
    opener = urllib.request.build_opener(tracker)
    req = urllib.request.Request(url, headers={"User-Agent": f"agy-stats/{__version__}"})
    with opener.open(req, timeout=timeout) as resp:
        data = resp.read(max_bytes) if max_bytes is not None else resp.read()
    return data, tracker.hops

def _parse_sig_bytes(sig_raw):
    if not sig_raw:
        return None
    if len(sig_raw) == 64:
        try:
            sig_raw.decode("ascii")
        except UnicodeDecodeError:
            return sig_raw
    try:
        txt = sig_raw.decode("utf-8", errors="strict").strip()
        tok = txt.split()[0] if txt else ""
        if re.fullmatch(r"[0-9a-fA-F]{128}", tok):
            return bytes.fromhex(tok)
    except Exception:
        pass
    if len(sig_raw) == 64:
        return sig_raw
    return None

def perform_self_update(url_override=None, check_only=False, force=False, quiet=False, allow_unverified=False):
    cfg = load_config()
    url = (url_override or os.environ.get("AGY_STATS_UPDATE_URL") or cfg.get("update_url") or DEFAULT_UPDATE_URL).strip()
    res = {
        "ok": False,
        "updated": False,
        "has_newer": False,
        "current_version": __version__,
        "remote_version": "",
        "sha_verified": False,
        "sig_verified": False,
        "migrated_url": "",
        "message": "",
    }
    if not url:
        res["message"] = "No update source URL configured yet."
        if not quiet:
            print(f"\n{C.YELLOW}No update source URL configured yet.{C.RESET}")
            print(f"    {C.CYAN}agy stats --settings update_url={DEFAULT_UPDATE_URL}{C.RESET}\n")
        return res

    parsed = urllib.parse.urlparse(url)
    if parsed.scheme not in ("https", "file"):
        res["message"] = f"Refusing insecure update URL '{url}' — only https:// (or local file://) is permitted."
        if not quiet:
            print(f"{C.RED}{res['message']}{C.RESET}")
        return res

    if not quiet:
        print(f"{C.DIM}Checking {url} ...{C.RESET}")
    try:
        raw_bytes, hops = _http_get_with_redirects(url, timeout=10)
    except Exception as ex:
        res["message"] = f"Failed to fetch update: {ex}"
        if not quiet:
            print(f"{C.RED}{res['message']}{C.RESET}")
        return res

    # 1. SHA-256 checksum verification (<url>.sha256)
    sha_verified = False
    sha_present = False
    try:
        sha_bytes, _ = _http_get_with_redirects(url + ".sha256", timeout=5)
        sha_text = sha_bytes.decode("utf-8", errors="replace").strip()
        expected_sha = sha_text.split()[0].lower() if sha_text else ""
        if re.fullmatch(r"[0-9a-f]{64}", expected_sha):
            sha_present = True
            actual_sha = hashlib.sha256(raw_bytes).hexdigest().lower()
            if actual_sha != expected_sha:
                res["message"] = f"SHA-256 mismatch! Expected {expected_sha[:12]}..., got {actual_sha[:12]}... — aborting."
                if not quiet:
                    print(f"{C.RED}{res['message']}{C.RESET}")
                return res
            sha_verified = True
    except Exception:
        pass
    res["sha_verified"] = sha_verified

    # 2. Ed25519 cryptographic signature verification (<url>.sig)
    sig_verified = False
    sig_present = False
    try:
        sig_raw, _ = _http_get_with_redirects(url + ".sig", timeout=5)
        sig_bytes = _parse_sig_bytes(sig_raw)
        if sig_bytes is None:
            sig_present = True
            res["message"] = "Malformed Ed25519 signature file (.sig) — aborting."
            if not quiet:
                print(f"{C.RED}{res['message']}{C.RESET}")
            return res
        sig_present = True
        pubkey_bytes = bytes.fromhex(RELEASE_PUBKEY_HEX)
        if not ed25519_verify(pubkey_bytes, raw_bytes, sig_bytes):
            res["message"] = "Ed25519 signature verification FAILED! Rejecting untrusted or hijacked update payload."
            if not quiet:
                print(f"{C.RED}{res['message']}{C.RESET}")
            return res
        sig_verified = True
    except Exception:
        pass
    res["sig_verified"] = sig_verified

    if not check_only and not (sha_verified and sig_verified):
        if not allow_unverified:
            missing = []
            if not sig_present:
                missing.append(".sig")
            if not sha_present:
                missing.append(".sha256")
            miss_str = " and ".join(missing) if missing else "verification"
            res["message"] = (
                f"Refusing unverified update (missing {miss_str}). "
                "Official updates require both Ed25519 (.sig) and SHA-256 (.sha256) verification "
                "(pass --allow-unverified on CLI only for custom unsigned builds)."
            )
            if not quiet:
                print(f"{C.RED}{res['message']}{C.RESET}")
            return res

    # 3. Auto-migrate GitHub repository/username redirect ONLY after Ed25519 signature passes!
    migrated_gh = _resolve_migrated_github_url(url, hops)
    if sig_verified:
        if migrated_gh and migrated_gh != cfg.get("update_url"):
            save_config({"update_url": migrated_gh})
            res["migrated_url"] = migrated_gh
            if not quiet:
                print(f"{C.CYAN}Auto-migrated verified GitHub release URL -> {migrated_gh}{C.RESET}")
        elif url_override and parsed.scheme == "https" and url_override != cfg.get("update_url"):
            save_config({"update_url": url_override})

    try:
        text = raw_bytes.decode("utf-8")
    except UnicodeDecodeError:
        res["message"] = "Downloaded payload is not valid UTF-8 Python source — aborting."
        if not quiet:
            print(f"{C.RED}{res['message']}{C.RESET}")
        return res

    if not text.startswith("#!/usr/bin/env python3"):
        res["message"] = "Downloaded payload missing '#!/usr/bin/env python3' header — aborting."
        if not quiet:
            print(f"{C.RED}{res['message']}{C.RESET}")
        return res

    m_ver = re.search(r'^__version__\s*=\s*["\']([^"\']+)["\']', text, re.MULTILINE)
    remote_ver = m_ver.group(1) if m_ver else "0.0.0"
    res["remote_version"] = remote_ver

    save_config({"last_update_check": int(time.time()), "latest_seen_version": remote_ver})

    has_newer = _parse_semver(remote_ver) > _parse_semver(__version__)
    res["has_newer"] = has_newer
    if check_only:
        res["ok"] = True
        v_tag = " [Ed25519+SHA256 verified]" if (sig_verified and sha_verified) else ""
        if has_newer:
            res["message"] = f"Update available: v{__version__} -> v{remote_ver}{v_tag}"
            if not quiet:
                print(f"{C.GREEN}Update available:{C.RESET} v{__version__} -> {C.BOLD}v{remote_ver}{C.RESET}{v_tag} (run 'agy stats --update')")
        else:
            res["message"] = f"Already on the latest version (v{__version__}){v_tag}."
            if not quiet:
                print(f"{C.GREEN}✓ {res['message']}{C.RESET}")
        return res

    if not has_newer and not force:
        res["ok"] = True
        res["message"] = f"Already up to date (v{__version__})."
        if not quiet:
            print(f"{C.GREEN}✓ {res['message']}{C.RESET} {C.DIM}(Pass --force to reinstall){C.RESET}")
        return res

    current_script = os.path.abspath(__file__)
    local_bin_dir = os.path.expanduser("~/.local/bin")
    os.makedirs(local_bin_dir, exist_ok=True)
    default_target = os.path.join(local_bin_dir, "agy-stats")
    if os.path.basename(current_script) == "agy-stats" and os.access(os.path.dirname(current_script), os.W_OK):
        target_bin = current_script
    else:
        target_bin = default_target
    target_dir = os.path.dirname(target_bin)
    tmp_path = os.path.join(target_dir, f".agy-stats.tmp.{os.getpid()}")
    tmp_pyc = tmp_path + ".pyc"

    try:
        with open(tmp_path, "wb") as f:
            f.write(raw_bytes)
        py_compile.compile(tmp_path, cfile=tmp_pyc, doraise=True)
        if os.path.exists(tmp_pyc):
            os.remove(tmp_pyc)
        os.chmod(tmp_path, 0o755)
        os.replace(tmp_path, target_bin)
    except Exception as ex:
        for p in (tmp_path, tmp_pyc):
            if os.path.exists(p):
                try: os.remove(p)
                except Exception: pass
        res["message"] = f"Verification/compile gate failed — binary untouched: {ex}"
        if not quiet:
            print(f"{C.RED}{res['message']}{C.RESET}")
        return res

    if sig_verified and sha_verified:
        sec_note = "Ed25519 + SHA-256 + bytecode verified"
    elif sha_verified:
        sec_note = "SHA-256 + bytecode verified (unverified signature override)"
    else:
        sec_note = "bytecode verified (--allow-unverified override)"
    res["ok"] = True
    res["updated"] = True
    res["message"] = f"Updated agy-stats: v{__version__} -> v{remote_ver} ({sec_note})"
    if quiet and has_newer:
        save_config({"last_auto_update_notice": f"v{__version__} -> v{remote_ver}"})
    if not quiet:
        print(f"{C.BOLD}{C.GREEN}✓ Updated agy-stats:{C.RESET} v{__version__} -> {C.BOLD}v{remote_ver}{C.RESET} ({sec_note}, atomic swap -> {target_bin})")
    return res

def self_update(url_override=None, check_only=False, force=False, quiet=False, allow_unverified=False):
    res = perform_self_update(url_override=url_override, check_only=check_only, force=force, quiet=quiet, allow_unverified=allow_unverified)
    return res["has_newer"] if check_only else res["ok"]

def run_bg_update_worker():
    try:
        cfg = load_config()
        url = (os.environ.get("AGY_STATS_UPDATE_URL") or cfg.get("update_url") or DEFAULT_UPDATE_URL).strip()
        if not url:
            return
        parsed = urllib.parse.urlparse(url)
        if parsed.scheme not in ("https", "file"):
            return
        if cfg.get("auto_update", False):
            perform_self_update(url_override=url, check_only=False, force=False, quiet=True, allow_unverified=False)
        elif cfg.get("auto_check_updates", True):
            head_bytes, _ = _http_get_with_redirects(url, timeout=4.0, max_bytes=8192)
            head_chunk = head_bytes.decode("utf-8", errors="ignore")
            m = re.search(r'^__version__\s*=\s*["\']([^"\']+)["\']', head_chunk, re.MULTILINE)
            if m:
                save_config({"last_update_check": int(time.time()), "latest_seen_version": m.group(1)})
    except Exception:
        pass

def maybe_check_updates_async(cfg):
    # 1. Surface one-time confirmation if the previous launch auto-updated us in the background
    notice = cfg.get("last_auto_update_notice", "")
    if notice:
        if sys.stdout.isatty():
            print(f"{C.GREEN}✓ [agy-stats] Auto-updated in background: {notice}{C.RESET}")
        save_config({"last_auto_update_notice": ""})

    auto_upd = bool(cfg.get("auto_update", False))
    auto_chk = bool(cfg.get("auto_check_updates", True))
    if not auto_upd and not auto_chk:
        return

    seen = cfg.get("latest_seen_version", "")
    seen_is_newer = bool(seen and _parse_semver(seen) > _parse_semver(__version__))
    if not auto_upd and seen_is_newer and sys.stdout.isatty():
        print(f"{C.DIM}[agy-stats] Update available: v{__version__} -> v{seen} (run 'agy stats --update' or '--settings auto_update=true'){C.RESET}")

    url = (os.environ.get("AGY_STATS_UPDATE_URL") or cfg.get("update_url") or "").strip()
    if not url:
        return
    parsed = urllib.parse.urlparse(url)
    if parsed.scheme not in ("https", "file"):
        return

    now_s = int(time.time())
    last_chk = int(cfg.get("last_update_check", 0))
    # Check every 6h for auto_update (or immediately if a newer version was already spotted), 12h for check-only
    interval_s = 0 if (auto_upd and seen_is_newer) else (21600 if auto_upd else 43200)
    if interval_s > 0 and (now_s - last_chk) < interval_s:
        return

    # Stamp timestamp before spawning detached worker so rapid CLI calls never spawn duplicates
    save_config({"last_update_check": now_s})
    try:
        subprocess.Popen(
            [sys.executable, os.path.abspath(__file__), "--_bg-update-worker"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except Exception:
        pass

_ANSI_SEQ_RE = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")

def _fit_ansi_line(line, max_cols):
    vis = 0
    out = []
    i = 0
    n = len(line)
    while i < n:
        if line[i] == "\x1b":
            m = _ANSI_SEQ_RE.match(line, i)
            if m:
                out.append(m.group(0))
                i = m.end()
                continue
        if vis >= max_cols - 1:
            out.append("…" + C.RESET)
            break
        out.append(line[i])
        vis += 1
        i += 1
    return "".join(out)

def _open_raw_tty():
    if os.environ.get("AGY_NONINTERACTIVE"):
        return None
    if sys.stdin.isatty() and sys.stdout.isatty() and (_HAS_TERMIOS or _HAS_MSVCRT):
        return (sys.stdin, sys.stdout, False)
    if not sys.stdin.isatty():
        try:
            rlist, _, _ = select.select([sys.stdin], [], [], 0.0)
            if rlist:
                return None
        except Exception:
            pass
        if _HAS_TERMIOS and os.path.exists("/dev/tty"):
            try:
                t_in = open("/dev/tty", "r")
                t_out = open("/dev/tty", "w")
                return (t_in, t_out, True)
            except OSError:
                return None
    return None

def _read_tty_key(tty_in):
    if _HAS_MSVCRT and not _HAS_TERMIOS:
        ch = msvcrt.getwch()
        if ch in ("\x03", "\x04"):
            return "CTRL_C"
        if ch in ("\r", "\n"):
            return "ENTER"
        if ch == " ":
            return "SPACE"
        if ch == "\x1b":
            return "ESC"
        if ch in ("\x00", "\xe0"):
            k2 = msvcrt.getwch()
            return {"H": "UP", "P": "DOWN", "M": "RIGHT", "K": "LEFT"}.get(k2, "OTHER")
        if ch in ("k", "K"): return "UP"
        if ch in ("j", "J"): return "DOWN"
        if ch in ("a", "A"): return "ALL"
        if ch in ("b", "B"): return "BACK"
        if ch in ("q", "Q"): return "QUIT"
        if ch.isdigit(): return ch
        return "OTHER"

    fd = tty_in.fileno()
    old_attrs = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        b1 = os.read(fd, 1)
        if not b1 or b1 in (b"\x03", b"\x04"):
            return "CTRL_C"
        if b1 in (b"\r", b"\n"):
            return "ENTER"
        if b1 == b" ":
            return "SPACE"
        if b1 == b"\x1b":
            r, _, _ = select.select([fd], [], [], 0.04)
            if not r:
                return "ESC"
            b2 = os.read(fd, 1)
            if b2 in (b"[", b"O"):
                r2, _, _ = select.select([fd], [], [], 0.04)
                if not r2:
                    return "ESC"
                b3 = os.read(fd, 1)
                if b3 == b"A": return "UP"
                if b3 == b"B": return "DOWN"
                if b3 == b"C": return "RIGHT"
                if b3 == b"D": return "LEFT"
                while select.select([fd], [], [], 0.005)[0]:
                    os.read(fd, 1)
                return "OTHER"
            return "ESC"
        ch = b1.decode("utf-8", errors="ignore")
        if ch in ("k", "K"): return "UP"
        if ch in ("j", "J"): return "DOWN"
        if ch in ("a", "A"): return "ALL"
        if ch in ("b", "B"): return "BACK"
        if ch in ("q", "Q"): return "QUIT"
        if ch.isdigit(): return ch
        return "OTHER"
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old_attrs)

class _ClackUI:
    """Inline-collapse terminal UI (@clack style): redraws active step in-place, preserves scrollback."""
    def __init__(self, tty_in, tty_out):
        self.tty_in = tty_in
        self.tty_out = tty_out
        self.prev_lines = 0

    def _term_size(self):
        try:
            sz = os.get_terminal_size(self.tty_out.fileno())
            return max(24, sz.columns), max(8, sz.lines)
        except Exception:
            sz = shutil.get_terminal_size((88, 24))
            return max(24, sz.columns), max(8, sz.lines)

    def draw(self, lines):
        term_cols, term_rows = self._term_size()
        cols = max(20, term_cols - 2)
        max_rows = max(6, term_rows - 1)
        visible_lines = lines[-max_rows:] if len(lines) > max_rows else lines
        fitted = [_fit_ansi_line(ln, cols) for ln in visible_lines]
        seq = ["\x1b[?25l"]
        if self.prev_lines > 0:
            seq.append(f"\x1b[{self.prev_lines}A\r\x1b[J")
        seq.append("\n".join(fitted) + "\n")
        self.tty_out.write("".join(seq))
        self.tty_out.flush()
        self.prev_lines = len(fitted)

    def finish(self, lines):
        self.draw(lines)
        self.tty_out.write("\x1b[?25h")
        self.tty_out.flush()
        self.prev_lines = 0

    def restore_cursor(self):
        try:
            self.tty_out.write("\x1b[?25h")
            self.tty_out.flush()
        except Exception:
            pass

    def select_one(self, header_lines, title, options, default_idx=0, subtitle="", footer="↑/↓ move · Enter select · Esc/b back"):
        idx = max(0, min(default_idx, len(options) - 1))
        while True:
            _, term_rows = self._term_size()
            lines = list(header_lines)
            lines.append(f"{C.CYAN}◆{C.RESET}  {C.BOLD}{title}{C.RESET}")
            if subtitle:
                lines.append(f"{C.DIM}│  {subtitle}{C.RESET}")
            overhead = len(lines) + 2
            avail = max(3, term_rows - overhead)
            n_opts = len(options)
            if n_opts > avail:
                win = max(2, avail - 1)
                start_i = max(0, min(idx - win // 2, n_opts - win))
                end_i = min(n_opts, start_i + win)
            else:
                start_i, end_i = 0, n_opts
            for i in range(start_i, end_i):
                val, label, hint, is_cancel = options[i]
                active = (i == idx)
                if is_cancel:
                    if active:
                        h_str = f"  {C.DIM}({hint}){C.RESET}" if hint else ""
                        lines.append(f"{C.DIM}│{C.RESET}  {C.YELLOW}❯ ↩ {label}{C.RESET}{h_str}")
                    else:
                        lines.append(f"{C.DIM}│    ↩ {label}{C.RESET}")
                else:
                    if active:
                        h_str = f"  {C.DIM}— {hint}{C.RESET}" if hint else ""
                        lines.append(f"{C.DIM}│{C.RESET}  {C.CYAN}❯ ●{C.RESET} {C.BOLD}{label}{C.RESET}{h_str}")
                    else:
                        h_str = f"  {C.DIM}— {hint}{C.RESET}" if hint else ""
                        lines.append(f"{C.DIM}│{C.RESET}    {C.DIM}○{C.RESET} {label}{h_str}")
            if n_opts > avail:
                lines.append(f"{C.DIM}│    ({idx + 1}/{n_opts} items · ↑/↓ scroll){C.RESET}")
            lines.append(f"{C.DIM}└  {footer}{C.RESET}")
            self.draw(lines)

            key = _read_tty_key(self.tty_in)
            if key == "CTRL_C":
                raise KeyboardInterrupt
            if key == "UP":
                idx = (idx - 1) % len(options)
            elif key == "DOWN":
                idx = (idx + 1) % len(options)
            elif key in ("ENTER", "SPACE"):
                val, _, _, is_cancel = options[idx]
                if is_cancel:
                    return ("BACK", val)
                return ("SELECT", val)
            elif key in ("ESC", "BACK"):
                return ("BACK", None)
            elif key == "QUIT":
                return ("QUIT", None)
            elif key.isdigit():
                num = int(key)
                if num == 0:
                    return ("BACK", None)
                if 1 <= num <= len(options):
                    val, _, _, is_cancel = options[num - 1]
                    if is_cancel:
                        return ("BACK", val)
                    return ("SELECT", val)

    def select_checkboxes(self, header_lines, title, items, initial_disabled):
        enabled = {k for (k, _, _) in items if k not in set(initial_disabled or [])}
        # Rows: 0..len(items)-1 = checkboxes, len(items) = Apply, len(items)+1 = Cancel
        n_items = len(items)
        total_rows = n_items + 2
        idx = 0
        while True:
            _, term_rows = self._term_size()
            lines = list(header_lines)
            lines.append(f"{C.CYAN}◆{C.RESET}  {C.BOLD}{title}{C.RESET}")
            lines.append(f"{C.DIM}│  Check the sections to display in Overview / Summary (uncheck to hide):{C.RESET}")
            overhead = len(lines) + 5
            avail = max(3, term_rows - overhead)
            focus_item = min(idx, n_items - 1)
            if n_items > avail:
                win = max(2, avail - 1)
                start_i = max(0, min(focus_item - win // 2, n_items - win))
                end_i = min(n_items, start_i + win)
            else:
                start_i, end_i = 0, n_items
            for i in range(start_i, end_i):
                key, label, scope = items[i]
                active = (i == idx)
                checked = (key in enabled)
                box = f"{C.GREEN}[✓]{C.RESET}" if checked else f"{C.DIM}[ ]{C.RESET}"
                ptr = f"{C.CYAN}❯{C.RESET}" if active else " "
                lbl = f"{C.BOLD}{label:<28}{C.RESET}" if active else f"{label:<28}"
                lines.append(f"{C.DIM}│{C.RESET}  {ptr} {box} {lbl} {C.DIM}({scope}){C.RESET}")
            if n_items > avail:
                lines.append(f"{C.DIM}│    ({focus_item + 1}/{n_items} sections · ↑/↓ scroll){C.RESET}")

            lines.append(f"{C.DIM}│    {'─' * 46}{C.RESET}")
            apply_active = (idx == n_items)
            cancel_active = (idx == n_items + 1)
            cnt_str = f"{len(enabled)}/{n_items} enabled"
            if apply_active:
                lines.append(f"{C.DIM}│{C.RESET}  {C.GREEN}❯ [✓] Apply selection ({cnt_str}){C.RESET}")
            else:
                lines.append(f"{C.DIM}│{C.RESET}    {C.GREEN}[✓]{C.RESET} Apply selection {C.DIM}({cnt_str}){C.RESET}")
            if cancel_active:
                lines.append(f"{C.DIM}│{C.RESET}  {C.YELLOW}❯ [↩] Cancel — return to menu{C.RESET}")
            else:
                lines.append(f"{C.DIM}│    [↩] Cancel — return to menu{C.RESET}")
            lines.append(f"{C.DIM}└  ↑/↓ move · Space toggle · a all/none · Enter apply · Esc cancel{C.RESET}")
            self.draw(lines)

            k = _read_tty_key(self.tty_in)
            if k == "CTRL_C":
                raise KeyboardInterrupt
            if k == "UP":
                idx = (idx - 1) % total_rows
            elif k == "DOWN":
                idx = (idx + 1) % total_rows
            elif k == "ALL":
                if len(enabled) == n_items:
                    enabled.clear()
                else:
                    enabled = {key for (key, _, _) in items}
            elif k == "SPACE":
                if idx < n_items:
                    item_key = items[idx][0]
                    if item_key in enabled:
                        enabled.remove(item_key)
                    else:
                        enabled.add(item_key)
                elif idx == n_items:
                    disabled_out = [key for (key, _, _) in items if key not in enabled]
                    return ("APPLY", disabled_out)
                else:
                    return ("CANCEL", None)
            elif k == "ENTER":
                if idx == n_items + 1:
                    return ("CANCEL", None)
                disabled_out = [key for (key, _, _) in items if key not in enabled]
                return ("APPLY", disabled_out)
            elif k in ("ESC", "BACK", "QUIT"):
                return ("CANCEL", None)

def _run_onboarding_fallback(cfg):
    """Non-TTY / piped-stdin fallback for automated scripts."""
    try:
        ans_mode = _prompt_tty("Step 1/4 Mode [1=web, 2=cli, 0=cancel] (default 1): ").strip()
        if ans_mode in ("0", "q", "cancel"):
            return cfg, False
        chosen_mode = "cli" if ans_mode == "2" else "web"
        open_browser = True
        cli_view = "overview"
        if chosen_mode == "web":
            ans_br = _prompt_tty("Step 2/4 Auto-open browser? [Y/n]: ").strip().lower()
            open_browser = False if ans_br in ("n", "no", "0", "false") else True
        else:
            ans_cv = _prompt_tty("Step 2/4 CLI view [1=overview,2=tokens,3=quota,4=summary,5=sessions]: ").strip()
            cli_view = {"1": "overview", "2": "tokens", "3": "quota", "4": "summary", "5": "sessions"}.get(ans_cv, "overview")
        ans_vis = _prompt_tty("Step 3/4 Display [1=full, 2=minimalist, 3=custom]: ").strip()
        disabled_sections = []
        if ans_vis == "2":
            disabled_sections = list(MINIMALIST_DISABLED_SECTIONS)
        elif ans_vis == "3":
            ans_custom = _prompt_tty("Comma-separated sections to hide (or 'cancel'): ").strip()
            if ans_custom.lower() != "cancel":
                disabled_sections = [x.strip().lower() for x in ans_custom.split(",") if x.strip()]
        ans_upd = _prompt_tty("Step 4/4 Updates [1=check, 2=auto-update, 3=off]: ").strip()
        auto_check_updates = False if ans_upd == "3" else True
        auto_update = True if ans_upd == "2" else False

        install_shell_integration(verbose=False)
        saved = save_config({
            "onboarded": True,
            "default_mode": chosen_mode,
            "auto_check_updates": auto_check_updates,
            "auto_update": auto_update,
            "web": {"open_browser": open_browser, "disabled_tabs": []},
            "cli": {"default_view": cli_view, "disabled_sections": disabled_sections},
        })
        print(f"\n{C.BOLD}{C.GREEN}✓ Setup complete! Saved to {CONFIG_PATH}{C.RESET}")
        print_usage_cheatsheet()
        return saved, True
    except (KeyboardInterrupt, EOFError):
        print(f"\n{C.DIM}Setup cancelled.{C.RESET}")
        return cfg, False

def run_onboarding_wizard(cfg=None, from_menu=False):
    if cfg is None:
        cfg = load_config()

    raw_tty = _open_raw_tty()
    if raw_tty is None:
        saved, _ = _run_onboarding_fallback(cfg)
        return saved

    tty_in, tty_out, should_close = raw_tty
    ui = _ClackUI(tty_in, tty_out)

    chosen_mode = cfg.get("default_mode", "web")
    open_browser = bool(cfg.get("web", {}).get("open_browser", True))
    cli_view = cfg.get("cli", {}).get("default_view", "overview")
    disabled_sections = list(cfg.get("cli", {}).get("disabled_sections", []))
    auto_check_updates = bool(cfg.get("auto_check_updates", True))
    auto_update = bool(cfg.get("auto_update", False))

    def _breadcrumbs(upto_step):
        hdr = [f"{C.CYAN}┌{C.RESET}  {C.BOLD}AGY STATS · Onboarding Setup{C.RESET}"]
        if upto_step >= 1:
            m_lbl = "Web Dashboard" if chosen_mode == "web" else "CLI Terminal"
            hdr.append(f"{C.GREEN}◇{C.RESET}  Launch Mode {C.DIM}·{C.RESET} {m_lbl}")
        if upto_step >= 2:
            if chosen_mode == "web":
                b_lbl = "Auto-open browser" if open_browser else "Server only"
            else:
                b_lbl = f"CLI view: {cli_view}"
            hdr.append(f"{C.GREEN}◇{C.RESET}  Mode Behavior {C.DIM}·{C.RESET} {b_lbl}")
        if upto_step >= 3:
            hdr.append(f"{C.GREEN}◇{C.RESET}  Overview Display {C.DIM}·{C.RESET} {_describe_display_sections(disabled_sections)}")
        hdr.append(f"{C.DIM}│{C.RESET}")
        return hdr

    try:
        step = 0
        while 0 <= step < 4:
            if step == 0:
                cancel_lbl = "Back to Settings Menu" if from_menu else "Cancel setup"
                act, val = ui.select_one(
                    _breadcrumbs(0),
                    "Step 1/4 — Default Launch Mode ('agy stats')",
                    [
                        ("web", "Web Dashboard", "Recommended · starts server & opens browser", False),
                        ("cli", "CLI Terminal", "Prints telemetry directly in terminal", False),
                        ("__cancel__", cancel_lbl, "", True),
                    ],
                    default_idx=(1 if chosen_mode == "cli" else 0),
                    footer="↑/↓ move · Enter select · Esc cancel",
                )
                if act in ("BACK", "QUIT") or val == "__cancel__":
                    ui.finish([
                        f"{C.CYAN}┌{C.RESET}  {C.BOLD}AGY STATS · Onboarding Setup{C.RESET}",
                        f"{C.DIM}└  Setup cancelled (no changes saved).{C.RESET}",
                    ])
                    return cfg
                chosen_mode = val
                step = 1

            elif step == 1:
                if chosen_mode == "web":
                    act, val = ui.select_one(
                        _breadcrumbs(1),
                        "Step 2/4 — Browser Launch Behavior",
                        [
                            (True, "Open browser immediately", "Recommended · launches dashboard tab automatically", False),
                            (False, "Start server quietly", "Prints localhost URL without opening browser", False),
                            ("__back__", "Back", "Return to Step 1", True),
                        ],
                        default_idx=(0 if open_browser else 1),
                        footer="↑/↓ move · Enter select · Esc/b back · q cancel",
                    )
                    if act == "QUIT":
                        ui.finish([
                            f"{C.CYAN}┌{C.RESET}  {C.BOLD}AGY STATS · Onboarding Setup{C.RESET}",
                            f"{C.DIM}└  Setup cancelled (no changes saved).{C.RESET}",
                        ])
                        return cfg
                    if act == "BACK" or val == "__back__":
                        step = 0
                        continue
                    open_browser = bool(val)
                    step = 2
                else:
                    cv_opts = ["overview", "tokens", "quota", "summary", "sessions"]
                    def_cv_idx = cv_opts.index(cli_view) if cli_view in cv_opts else 0
                    act, val = ui.select_one(
                        _breadcrumbs(1),
                        "Step 2/4 — CLI Default View",
                        [
                            ("overview", "Overview", "Uses your selected display sections below", False),
                            ("tokens", "Tokens Spent Only", "Token totals, model mix & daily ledger", False),
                            ("quota", "Quota & Pacing Only", "Live 5h/weekly quota pools & runway", False),
                            ("summary", "Compact 1-Line Summary", "Single-line status banner", False),
                            ("sessions", "Top Sessions Only", "Sessions ranked by quota usage", False),
                            ("__back__", "Back", "Return to Step 1", True),
                        ],
                        default_idx=def_cv_idx,
                        footer="↑/↓ move · Enter select · Esc/b back · q cancel",
                    )
                    if act == "QUIT":
                        ui.finish([
                            f"{C.CYAN}┌{C.RESET}  {C.BOLD}AGY STATS · Onboarding Setup{C.RESET}",
                            f"{C.DIM}└  Setup cancelled (no changes saved).{C.RESET}",
                        ])
                        return cfg
                    if act == "BACK" or val == "__back__":
                        step = 0
                        continue
                    cli_view = val
                    step = 2

            elif step == 2:
                cur_dis_set = set(disabled_sections)
                if not cur_dis_set:
                    vis_def = 0
                elif cur_dis_set == set(MINIMALIST_DISABLED_SECTIONS):
                    vis_def = 1
                else:
                    vis_def = 2

                act, val = ui.select_one(
                    _breadcrumbs(2),
                    "Step 3/4 — Overview & Summary Display",
                    [
                        ("full", "Full Overview", "Display all 8 summary & overview sections", False),
                        ("minimalist", "Minimalist", "Summary, Quota Pacing, Models & Activity only", False),
                        ("custom", "Custom...", "Choose exact sections from a checkbox list", False),
                        ("__back__", "Back", "Return to Step 2", True),
                    ],
                    default_idx=vis_def,
                    subtitle="Controls what gets displayed on the Overview summary & CLI report:",
                    footer="↑/↓ move · Enter select · Esc/b back · q cancel",
                )
                if act == "QUIT":
                    ui.finish([
                        f"{C.CYAN}┌{C.RESET}  {C.BOLD}AGY STATS · Onboarding Setup{C.RESET}",
                        f"{C.DIM}└  Setup cancelled (no changes saved).{C.RESET}",
                    ])
                    return cfg
                if act == "BACK" or val == "__back__":
                    step = 1
                    continue
                if val == "full":
                    disabled_sections = []
                    step = 3
                elif val == "minimalist":
                    disabled_sections = list(MINIMALIST_DISABLED_SECTIONS)
                    step = 3
                elif val == "custom":
                    c_act, c_dis = ui.select_checkboxes(
                        _breadcrumbs(2),
                        "Step 3/4 — Custom Overview & Summary Sections",
                        OVERVIEW_SECTION_ITEMS,
                        disabled_sections,
                    )
                    if c_act == "APPLY":
                        disabled_sections = c_dis
                        step = 3
                    # If CANCEL, stays on step == 2 (returns cleanly to the preset menu)

            elif step == 3:
                upd_def = 1 if auto_update else (0 if auto_check_updates else 2)
                act, val = ui.select_one(
                    _breadcrumbs(3),
                    "Step 4/4 — Launch Update Policy",
                    [
                        ("check", "Check & notify only", "Default · notifies when a new version is out", False),
                        ("auto", "Auto-update on launch", "Updates in background so next run is new", False),
                        ("off", "Disable update checks", "Manual 'agy stats --update' only", False),
                        ("__back__", "Back", "Return to Step 3", True),
                    ],
                    default_idx=upd_def,
                    footer="↑/↓ move · Enter complete setup · Esc/b back · q cancel",
                )
                if act == "QUIT":
                    ui.finish([
                        f"{C.CYAN}┌{C.RESET}  {C.BOLD}AGY STATS · Onboarding Setup{C.RESET}",
                        f"{C.DIM}└  Setup cancelled (no changes saved).{C.RESET}",
                    ])
                    return cfg
                if act == "BACK" or val == "__back__":
                    step = 2
                    continue
                auto_check_updates = (val != "off")
                auto_update = (val == "auto")
                step = 4

        install_shell_integration(verbose=False)
        saved = save_config({
            "onboarded": True,
            "default_mode": chosen_mode,
            "auto_check_updates": auto_check_updates,
            "auto_update": auto_update,
            "web": {
                "open_browser": open_browser,
                "disabled_tabs": [],
            },
            "cli": {
                "default_view": cli_view,
                "disabled_sections": disabled_sections,
            },
        })

        m_lbl = (
            f"Web Dashboard ({'auto-open' if open_browser else 'server only'})"
            if chosen_mode == "web"
            else f"CLI Terminal ({cli_view})"
        )
        upd_lbl = "Auto-update on launch" if auto_update else ("Check & notify only" if auto_check_updates else "Disabled")
        ui.finish([
            f"{C.GREEN}┌{C.RESET}  {C.BOLD}{C.GREEN}✓ Onboarding Setup Complete{C.RESET}",
            f"{C.GREEN}◇{C.RESET}  Default Mode     {C.DIM}·{C.RESET} {m_lbl}",
            f"{C.GREEN}◇{C.RESET}  Overview Display {C.DIM}·{C.RESET} {_describe_display_sections(disabled_sections)}",
            f"{C.GREEN}◇{C.RESET}  Launch Updates   {C.DIM}·{C.RESET} {upd_lbl}",
            f"{C.DIM}└  Saved to {CONFIG_PATH}{C.RESET}",
        ])
        print_usage_cheatsheet()
        return saved
    except (KeyboardInterrupt, EOFError):
        ui.restore_cursor()
        print(f"\n{C.DIM}Setup cancelled.{C.RESET}")
        return cfg
    finally:
        ui.restore_cursor()
        if should_close:
            try: tty_in.close()
            except Exception: pass
            try: tty_out.close()
            except Exception: pass

def run_interactive_onboarding(cfg):
    raw_tty = _open_raw_tty()
    if raw_tty is None:
        print_settings_table(cfg)
        return

    tty_in, tty_out, should_close = raw_tty
    ui = _ClackUI(tty_in, tty_out)
    status_note = ""

    try:
        while True:
            cfg = load_config()
            def_mode = cfg.get("default_mode", "web")
            open_br = cfg.get("web", {}).get("open_browser", True)
            q_mode = cfg.get("web", {}).get("quota_mode", "server")
            q_mode_lbl = "Local / Multi-Surface" if q_mode == "multi" else "Server Pool"
            show_rb = bool(cfg.get("web", {}).get("show_reset_breakdown", False))
            cli_view = cfg.get("cli", {}).get("default_view", "overview")
            dis_sec = cfg.get("cli", {}).get("disabled_sections", [])
            auto_upd = cfg.get("auto_update", False)
            auto_chk = cfg.get("auto_check_updates", True)
            upd_short = "Auto-update" if auto_upd else ("Check only" if auto_chk else "Off")

            hdr = [
                f"{C.CYAN}┌{C.RESET}  {C.BOLD}AGY STATS · Settings & Preferences (v{__version__}){C.RESET}",
                f"{C.DIM}│  Mode: {def_mode.upper()} · Quota: {q_mode_lbl} · Display: {_describe_display_sections(dis_sec)}{C.RESET}",
            ]
            if status_note:
                hdr.append(f"{C.GREEN}◇{C.RESET}  {status_note}")
            hdr.append(f"{C.DIM}│{C.RESET}")

            act, choice = ui.select_one(
                hdr,
                "Main Menu",
                [
                    ("wizard",  "Run Guided Onboarding Wizard", "4-step setup flow", False),
                    ("qmode",   f"Set Quota Counting Source (currently: {q_mode_lbl})", "Server Pool vs Local / Multi-Surface", False),
                    ("rbreak",  f"Toggle Overview Since-Reset Breakdown (currently: {'On' if show_rb else 'Quota tab only'})", "Server vs Local usage since 5h & weekly reset", False),
                    ("display", "Customize Overview & Summary Display", _describe_display_sections(dis_sec), False),
                    ("mode",    f"Switch Default Launch Mode (currently: {def_mode.upper()})", "Toggle Web <-> CLI", False),
                    ("browser", f"Toggle Auto-Open Browser (currently: {'On' if open_br else 'Off'})", "Web mode launch behavior", False),
                    ("cliview", f"Set CLI Default View (currently: {cli_view})", "overview, tokens, quota, summary, sessions", False),
                    ("updates", f"Launch Update Policy (currently: {upd_short})", "Check, Auto-update on launch, or Off", False),
                    ("table",   "Show Full Configuration Table", "Print config values & exit", False),
                    ("reset",   "Reset to Factory Defaults", "Restore clean initial defaults", False),
                    ("exit",    "Exit", "", True),
                ],
                default_idx=0,
                footer="↑/↓ move · Enter select · Esc/q exit",
            )

            if act in ("BACK", "QUIT") or choice == "exit":
                ui.finish([
                    f"{C.CYAN}┌{C.RESET}  {C.BOLD}AGY STATS · Settings & Preferences{C.RESET}",
                    f"{C.DIM}└  Closed.{C.RESET}",
                ])
                return

            if choice == "wizard":
                ui.finish([])
                prev_onboarded = cfg.get("onboarded", False)
                res_cfg = run_onboarding_wizard(cfg, from_menu=True)
                # If user completed wizard (didn't cancel), usage cheatsheet was printed — we're done!
                if res_cfg is not cfg:
                    return
                status_note = "Returned to main menu (wizard cancelled)."
                continue

            elif choice == "qmode":
                qm_act, qm_val = ui.select_one(
                    hdr,
                    "Quota Counting Source",
                    [
                        ("server", "Server Pool (Default)", "100% live /usage server state · ideal for single-product setups", False),
                        ("multi", "Local / Multi-Surface", "Local CLI % counting + This setup vs Other surfaces split", False),
                        ("__back__", "Back to Main Menu", "", True),
                    ],
                    default_idx=(1 if q_mode == "multi" else 0),
                    footer="↑/↓ move · Enter select · Esc/b back to main menu",
                )
                if qm_act == "SELECT" and qm_val != "__back__":
                    save_config({"onboarded": True, "web": {"quota_mode": qm_val}})
                    status_note = f"Quota counting source set to: {'Local / Multi-Surface' if qm_val == 'multi' else 'Server Pool'}"

            elif choice == "rbreak":
                save_config({"onboarded": True, "web": {"show_reset_breakdown": not show_rb}})
                status_note = f"Overview since-reset breakdown set to: {'Shown on Overview + Quota' if not show_rb else 'Quota tab only'}"

            elif choice == "display":
                while True:
                    cur_dis = load_config().get("cli", {}).get("disabled_sections", [])
                    d_act, d_val = ui.select_one(
                        hdr,
                        "Overview & Summary Display",
                        [
                            ("full", "Full Overview", "Show all 8 summary & overview sections", False),
                            ("minimalist", "Minimalist", "Summary, Quota Pacing, Models & Activity only", False),
                            ("custom", "Custom...", "Select sections via checkbox list", False),
                            ("__back__", "Back to Main Menu", "", True),
                        ],
                        default_idx=(0 if not cur_dis else (1 if set(cur_dis) == set(MINIMALIST_DISABLED_SECTIONS) else 2)),
                        footer="↑/↓ move · Enter select · Esc/b back to main menu",
                    )
                    if d_act in ("BACK", "QUIT") or d_val == "__back__":
                        break
                    if d_val == "full":
                        save_config({"onboarded": True, "cli": {"disabled_sections": []}})
                        status_note = "Overview display set to: Full Overview"
                        break
                    elif d_val == "minimalist":
                        save_config({"onboarded": True, "cli": {"disabled_sections": list(MINIMALIST_DISABLED_SECTIONS)}})
                        status_note = "Overview display set to: Minimalist"
                        break
                    elif d_val == "custom":
                        c_act, c_dis = ui.select_checkboxes(
                            hdr,
                            "Custom Overview & Summary Sections",
                            OVERVIEW_SECTION_ITEMS,
                            cur_dis,
                        )
                        if c_act == "APPLY":
                            save_config({"onboarded": True, "cli": {"disabled_sections": c_dis}})
                            status_note = f"Saved custom display ({_describe_display_sections(c_dis)})"
                            break
                        # On CANCEL, returns cleanly to Overview & Summary Display menu

            elif choice == "mode":
                new_mode = "cli" if def_mode == "web" else "web"
                save_config({"onboarded": True, "default_mode": new_mode})
                status_note = f"Default launch mode set to: {new_mode.upper()}"

            elif choice == "browser":
                save_config({"onboarded": True, "web": {"open_browser": not open_br}})
                status_note = f"Web auto-open browser set to: {'On' if not open_br else 'Off'}"

            elif choice == "cliview":
                cv_act, cv_val = ui.select_one(
                    hdr,
                    "CLI Default View",
                    [
                        ("overview", "Overview", "Uses your configured Overview Display sections", False),
                        ("tokens", "Tokens Spent Only", "Token totals, model mix & daily ledger", False),
                        ("quota", "Quota & Pacing Only", "Live quota pools & weekly runway", False),
                        ("summary", "Compact 1-Line Summary", "Single-line status banner", False),
                        ("sessions", "Top Sessions Only", "Sessions ranked by quota usage", False),
                        ("__back__", "Back to Main Menu", "", True),
                    ],
                    footer="↑/↓ move · Enter select · Esc/b back to main menu",
                )
                if cv_act == "SELECT" and cv_val != "__back__":
                    save_config({"onboarded": True, "cli": {"default_view": cv_val}})
                    status_note = f"CLI default view set to: {cv_val}"

            elif choice == "updates":
                u_act, u_val = ui.select_one(
                    hdr,
                    "Launch Update Policy",
                    [
                        ("check", "Check & notify only", "Default · notifies when a new version is out", False),
                        ("auto", "Auto-update on launch", "Updates silently in background for next launch", False),
                        ("off", "Disable update checks", "Manual 'agy stats --update' only", False),
                        ("__back__", "Back to Main Menu", "", True),
                    ],
                    footer="↑/↓ move · Enter select · Esc/b back to main menu",
                )
                if u_act == "SELECT" and u_val != "__back__":
                    save_config({
                        "onboarded": True,
                        "auto_check_updates": (u_val != "off"),
                        "auto_update": (u_val == "auto"),
                    })
                    status_note = f"Launch update policy set to: {u_val}"

            elif choice == "table":
                ui.finish([
                    f"{C.CYAN}┌{C.RESET}  {C.BOLD}AGY STATS · Settings & Preferences{C.RESET}",
                    f"{C.DIM}└  Showing full configuration table:{C.RESET}",
                ])
                print_settings_table(load_config())
                return

            elif choice == "reset":
                if os.path.exists(CONFIG_PATH):
                    os.remove(CONFIG_PATH)
                load_config()
                status_note = "Reset all preferences to factory defaults."
    except (KeyboardInterrupt, EOFError):
        ui.restore_cursor()
        print()
    finally:
        ui.restore_cursor()
        if should_close:
            try: tty_in.close()
            except Exception: pass
            try: tty_out.close()
            except Exception: pass

def handle_settings_cli(args_list):
    cfg = load_config()
    if not args_list:
        if sys.stdin.isatty() and sys.stdout.isatty():
            run_interactive_onboarding(cfg)
        else:
            print_settings_table(cfg)
        return

    if len(args_list) == 1 and args_list[0].lower() in ("show", "list", "status", "info"):
        print_settings_table(cfg)
        return

    if len(args_list) == 1 and args_list[0].lower() in ("onboard", "setup", "wizard"):
        run_onboarding_wizard(cfg)
        return

    if len(args_list) == 1 and args_list[0].lower() == "reset":
        if os.path.exists(CONFIG_PATH):
            os.remove(CONFIG_PATH)
        cfg = load_config()
        print(f"{C.GREEN}✓ Settings reset to factory defaults.{C.RESET}")
        print_settings_table(cfg)
        return

    updates = {"onboarded": True}
    for item in args_list:
        if "=" not in item:
            val = item.lower()
            if val in ("web", "cli"):
                updates["default_mode"] = val
            elif val == "minimalist":
                updates.setdefault("cli", {})["disabled_sections"] = list(MINIMALIST_DISABLED_SECTIONS)
            elif val == "full":
                updates.setdefault("cli", {})["disabled_sections"] = []
            elif val in ("overview", "tokens", "summary", "quota", "sessions"):
                updates.setdefault("cli", {})["default_view"] = val
            continue
        k, v = item.split("=", 1)
        k, v = k.strip().lower(), v.strip()
        if k in ("onboarded", "onboard"):
            updates["onboarded"] = v.lower() in ("1", "true", "yes", "on")
        elif k in ("update_url", "repo_url"):
            updates["update_url"] = v
        elif k in ("auto_check_updates", "check_updates"):
            updates["auto_check_updates"] = v.lower() in ("1", "true", "yes", "on")
        elif k in ("auto_update", "autoupdate"):
            updates["auto_update"] = v.lower() in ("1", "true", "yes", "on")
            if updates["auto_update"]:
                updates["auto_check_updates"] = True
        elif k in ("default", "default_mode", "mode"):
            updates["default_mode"] = "cli" if v.lower() in ("cli", "terminal") else "web"
        elif k in ("open_browser", "browser", "web.open_browser"):
            updates.setdefault("web", {})["open_browser"] = v.lower() in ("1", "true", "yes", "on")
        elif k in ("port", "web.port"):
            try: updates.setdefault("web", {})["port"] = int(v)
            except Exception: pass
        elif k in ("quota_mode", "web.quota_mode", "quota"):
            updates.setdefault("web", {})["quota_mode"] = "multi" if v.lower() in ("multi", "local") else "server"
        elif k in ("pacing_style", "web.pacing_style"):
            if v.lower() in ("fun", "straight", "minimal"):
                updates.setdefault("web", {})["pacing_style"] = v.lower()
        elif k in ("pacing_bars", "web.pacing_bars"):
            updates.setdefault("web", {})["pacing_bars"] = v.lower() in ("1", "true", "yes", "on")
        elif k in ("reset_breakdown", "show_reset_breakdown", "web.show_reset_breakdown"):
            updates.setdefault("web", {})["show_reset_breakdown"] = v.lower() in ("1", "true", "yes", "on")
        elif k in ("cli.view", "view", "default_view"):
            updates.setdefault("cli", {})["default_view"] = v.lower()
        elif k in ("display", "preset"):
            if v.lower() == "minimalist":
                updates.setdefault("cli", {})["disabled_sections"] = list(MINIMALIST_DISABLED_SECTIONS)
            elif v.lower() in ("full", "all"):
                updates.setdefault("cli", {})["disabled_sections"] = []
        elif k in ("disable", "disabled", "cli.disable", "cli.disabled"):
            updates.setdefault("cli", {})["disabled_sections"] = [x.strip().lower() for x in v.split(",") if x.strip()]
        elif k in ("enable", "cli.enable"):
            en = [x.strip().lower() for x in v.split(",") if x.strip()]
            cur_dis = cfg.get("cli", {}).get("disabled_sections", [])
            updates.setdefault("cli", {})["disabled_sections"] = [x for x in cur_dis if x not in en]

    saved = save_config(updates)
    print(f"{C.BOLD}{C.GREEN}✓ Settings updated successfully.{C.RESET}")
    print_settings_table(saved)

