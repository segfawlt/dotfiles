    }
  }
  const msgEl = document.getElementById("settingUpdateStatusMsg");
  if (msgEl) msgEl.style.display = "none";

  document.getElementById("settingsModalScrim")?.classList.add("open");
}

async function triggerWebUpdate(checkOnly = true) {
  const chkBtn = document.getElementById("checkUpdateWebBtn");
  const appBtn = document.getElementById("applyUpdateWebBtn");
  const msgEl = document.getElementById("settingUpdateStatusMsg");
  const urlVal = document.getElementById("settingUpdateUrl")?.value?.trim() || "";
  if (chkBtn) chkBtn.disabled = true;
  if (appBtn) appBtn.disabled = true;
  if (msgEl) {
    msgEl.style.display = "block";
    msgEl.style.color = "var(--ink-2)";
    msgEl.textContent = checkOnly ? "Checking update source..." : "Downloading & verifying atomic update...";
  }
  try {
    const res = await fetch("/api/update", {
      method: "POST",
      headers: { "Content-Type": "application/json", "X-Agy-Stats": "1" },
      body: JSON.stringify({ check_only: checkOnly, url: urlVal })
    });
    const out = await res.json();
    if (out.migrated_url) {
      const updUrlEl = document.getElementById("settingUpdateUrl");
      if (updUrlEl) updUrlEl.value = out.migrated_url;
    }
    if (msgEl) {
      msgEl.style.color = out.ok ? "var(--status-ok, #34d399)" : "var(--status-err, #f87171)";
      msgEl.textContent = out.message || (out.ok ? "Done." : "Update check failed.");
    }
    if (appBtn) {
      appBtn.style.display = (out.has_newer && !out.updated) ? "inline-flex" : "none";
    }
    const verBadge = document.getElementById("settingVersionBadge");
    if (verBadge && out.remote_version) {
      verBadge.textContent = out.updated
        ? `v${out.remote_version} (ready next launch)`
        : (out.has_newer ? `v${out.current_version} -> v${out.remote_version}` : `v${out.current_version}`);
    }
  } catch (err) {
    if (msgEl) {
      msgEl.style.color = "var(--status-err, #f87171)";
      msgEl.textContent = "Request failed: " + err;
    }
  } finally {
    if (chkBtn) chkBtn.disabled = false;
    if (appBtn) appBtn.disabled = false;
  }
}

function closeSettingsModal() {
  document.getElementById("settingsModalScrim")?.classList.remove("open");
}

async function saveSettingsFromModal() {
  const saveBtn = document.getElementById("saveSettingsBtn");
  if (saveBtn) saveBtn.textContent = "Saving...";

  const disabledCli = [];
  document.querySelectorAll(".setting-cli-toggle").forEach(cb => {
    if (!cb.checked) disabledCli.push(cb.value);
  });

  const autoUpdChecked = !!document.getElementById("settingAutoUpdate")?.checked;
  const autoChkChecked = autoUpdChecked || !!document.getElementById("settingAutoCheckUpdates")?.checked;
  const updUrlVal = document.getElementById("settingUpdateUrl")?.value?.trim() || "";

  const qModeVal = document.getElementById("settingQuotaMulti")?.checked ? "multi" : "server";
  const pStyleVal = document.getElementById("settingPacingMinimal")?.checked ? "minimal"
    : document.getElementById("settingPacingStraight")?.checked ? "straight"
    : "fun";

  const payload = {
    onboarded: true,
    default_mode: document.getElementById("settingModeCli")?.checked ? "cli" : "web",
    auto_check_updates: autoChkChecked,
    auto_update: autoUpdChecked,
    update_url: updUrlVal,
    web: {
      open_browser: !!document.getElementById("settingOpenBrowser")?.checked,
      quota_mode: qModeVal,
      show_reset_breakdown: !!document.getElementById("settingResetBreakdown")?.checked,
      pacing_style: pStyleVal,
      pacing_bars: document.getElementById("settingPacingBars") ? !!document.getElementById("settingPacingBars").checked : true,
      disabled_tabs: []
    },
    cli: {
      default_view: document.getElementById("settingCliView")?.value || "overview",
      disabled_sections: disabledCli
    }
  };

  try {
    const res = await fetch("/api/settings", {
      method: "POST",
      headers: { "Content-Type": "application/json", "X-Agy-Stats": "1" },
      body: JSON.stringify(payload)
    });
    if (res.ok) {
      G_SETTINGS = await res.json();
      applySettings(G_SETTINGS);
      closeSettingsModal();
      const lbl = document.getElementById("liveChipLabel");
      if (lbl && G_SYNC_PHASE === "idle") {
        lbl.textContent = "Saved";
        setTimeout(() => { if (G_SYNC_PHASE === "idle" && lbl.textContent === "Saved") lbl.textContent = "Live"; }, 2000);
      }
    }
  } catch (err) {
    console.error("Failed to save settings", err);
    alert("Failed to save settings: " + err);
  } finally {
    if (saveBtn) saveBtn.textContent = "Save Preferences";
  }
}

async function resetSettingsToDefault() {
  if (!confirm("Reset all settings to factory defaults?")) return;
  try {
    const res = await fetch("/api/settings", {
      method: "POST",
      headers: { "Content-Type": "application/json", "X-Agy-Stats": "1" },
      body: JSON.stringify({
        onboarded: false,
        default_mode: "web",
        update_url: "",
        auto_check_updates: true,
        auto_update: false,
        web: { open_browser: true, quota_mode: "server", show_reset_breakdown: false, pacing_style: "fun", pacing_bars: true, disabled_tabs: [] },
        cli: { default_view: "overview", days: 10, disabled_sections: [] }
      })
    });
    if (res.ok) {
      G_SETTINGS = await res.json();
      applySettings(G_SETTINGS);
      openSettingsModal(false);
    }
  } catch (err) {
    console.error("Failed to reset settings", err);
  }
}

let G_LOAD_SEQ = 0;

function setLoadingState(isLoading, isError = false, errorMsg = "") {
  const prog = document.getElementById("topbarProgress");
  const chip = document.getElementById("liveScanChip");
  const spin = document.getElementById("liveChipSpin");
  const dot = document.getElementById("liveChipDot");
  const lbl = document.getElementById("liveChipLabel");
  const info = document.getElementById("liveScanInfo");

  if (isLoading) {
    G_SYNC_PHASE = "syncing";
    if (prog) prog.dataset.loading = "true";
    if (chip) {
      chip.disabled = true;
      chip.title = "Ingesting session files";
    }
    if (spin) spin.style.display = "inline-block";
    if (dot) dot.style.display = "none";
    if (lbl) lbl.textContent = "Syncing";
    if (info) info.style.display = "none";
    if (G_INITIAL_REVEALED) {
      document.querySelectorAll('[data-stale-target="true"]').forEach(el => {
        el.dataset.stale = "true";
      });
    }
    return;
  }

  if (prog) prog.dataset.loading = "false";
  document.querySelectorAll('[data-stale-target="true"]').forEach(el => {
    el.dataset.stale = "false";
  });

  if (isError) {
    G_SYNC_PHASE = "error";
    if (chip) {
      chip.disabled = false;
      chip.title = `${errorMsg || "Sync failed"} — click to retry`;
    }
    if (spin) spin.style.display = "none";
    if (dot) {
      dot.style.display = "inline-block";
      dot.dataset.tone = "bad";
      dot.dataset.pulse = "false";
    }
    if (lbl) lbl.textContent = "Sync failed";
    if (info) info.style.display = "none";
    return;
  }

  G_SYNC_PHASE = "idle";
  if (chip) {
    chip.disabled = false;
    chip.title = G_FULL_DATA
      ? `Click to sync session files now · ${G_FULL_DATA.total_sessions_count || G_FULL_DATA.sessions_count || 0} sessions · ${G_FULL_DATA.scan_ms ?? 0}ms`
      : "Click to sync session files now";
  }
  if (spin) spin.style.display = "none";
  if (dot) {
    dot.style.display = "inline-block";
    dot.dataset.tone = "live";
    dot.dataset.pulse = "true";
  }
  if (lbl) lbl.textContent = "Live";
  updateLiveAgo();
}

async function loadStats(rangeKey = "all", force = false, fromMs = null, toMs = null) {
  const seq = ++G_LOAD_SEQ;
  setLoadingState(true);
  let errMsg = "";
  let hadErr = false;
  try {
    let url = `/api/stats?range=${encodeURIComponent(rangeKey)}`;
    if (rangeKey === "custom" && fromMs !== null && toMs !== null) {
      url += `&from=${Math.floor(fromMs)}&to=${Math.floor(toMs)}`;
    }
    if (force) url += "&refresh=1";
    const res = await fetch(url);
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    const data = await res.json();
    if (seq !== G_LOAD_SEQ) return;
    G_FULL_DATA = data;
    G_OVERVIEW_DATA = data;
    G_LAST_SYNCED_AT = Date.now();
    revealLoadedContent();
    renderDynamicOverview();
    renderFullViews();
    flashChangedStats();
    requestAnimationFrame(syncSegmentedThumbs);
  } catch (err) {
    if (seq !== G_LOAD_SEQ) return;
    console.error("Failed to load stats", err);
    hadErr = true;
    errMsg = err && err.message ? err.message : "Sync failed";
  } finally {
    if (seq === G_LOAD_SEQ) {
      setLoadingState(false, hadErr, errMsg);
    }
  }
}

if (typeof ResizeObserver !== "undefined") {
  const segRo = new ResizeObserver(() => syncSegmentedThumbs(true));
  document.querySelectorAll(".segmented").forEach(seg => segRo.observe(seg));
}
if (document.fonts && document.fonts.ready) {
  document.fonts.ready.then(() => syncSegmentedThumbs(true));
}

window.addEventListener("resize", () => {
  syncSegmentedThumbs(true);
  if (document.getElementById("pane-overview")?.classList.contains("active")) {
    renderOverviewActivityChart();
  }
});

initSkeletons();
initTheme();
syncSegmentedThumbs(true);
fetchSettings();
setTimeRange("all");
</script>
</body>
</html>
"""

_LOOPBACK_HOST_RE = re.compile(r"^(?:localhost|127\.0\.0\.1|\[::1\])(?::\d+)?$", re.IGNORECASE)
_LOOPBACK_ORIGIN_RE = re.compile(r"^http://(?:localhost|127\.0\.0\.1|\[::1\])(?::\d+)?$", re.IGNORECASE)
_MAX_POST_BYTES = 65536

class _StatsHTTPServer(ThreadingHTTPServer):
    allow_reuse_address = True
    daemon_threads = True

class StatsHandler(BaseHTTPRequestHandler):
    def log_message(self, format, *args):
        pass

    def _send_json_error(self, code, msg):
        body = json.dumps({"ok": False, "error": msg, "message": msg}).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _verify_request_origin(self, is_post=False, is_api=False):
        host = (self.headers.get("Host") or "").strip()
        if not host or not _LOOPBACK_HOST_RE.match(host):
            self._send_json_error(403, "Forbidden: non-loopback Host header rejected (DNS rebinding guard).")
            return False
        if is_api or is_post:
            sfs = (self.headers.get("Sec-Fetch-Site") or "").strip().lower()
            if sfs and sfs not in ("same-origin", "none"):
                self._send_json_error(403, "Forbidden: cross-site request rejected.")
                return False
            origin = (self.headers.get("Origin") or "").strip()
            if origin and not _LOOPBACK_ORIGIN_RE.match(origin):
                self._send_json_error(403, "Forbidden: cross-origin request rejected.")
                return False
        if is_post:
            if self.headers.get("X-Agy-Stats") != "1":
                self._send_json_error(403, "Forbidden: missing X-Agy-Stats anti-CSRF header.")
                return False
            ctype = (self.headers.get("Content-Type") or "").strip().lower()
            if not ctype.startswith("application/json"):
                self._send_json_error(415, "Unsupported Media Type: expected application/json.")
                return False
        return True

    def _read_bounded_json(self):
        raw_cl = self.headers.get("Content-Length", "0")
        try:
            content_len = int(raw_cl)
        except ValueError:
            self._send_json_error(400, "Invalid Content-Length header.")
            return None
        if content_len < 0 or content_len > _MAX_POST_BYTES:
            self._send_json_error(413, f"Request body exceeds {_MAX_POST_BYTES} bytes limit.")
            return None
        raw_body = self.rfile.read(content_len).decode("utf-8") if content_len > 0 else "{}"
        return json.loads(raw_body)

    def do_HEAD(self):
        if not self._verify_request_origin(is_post=False, is_api=False):
            return
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.end_headers()

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        is_api = parsed.path.startswith("/api/")
        if not self._verify_request_origin(is_post=False, is_api=is_api):
            return
        qs = urllib.parse.parse_qs(parsed.query)

        if parsed.path in ("/api/stats", "/api/stats/overview"):
            if "refresh" in qs:
                fetch_live_quota(force_refresh=True)
                load_raw_telemetry(force=True)
            range_key = qs.get("range", ["all"])[0]
            from_ms = int(qs["from"][0]) if "from" in qs and qs["from"][0].lstrip("-").isdigit() else None
            to_ms = int(qs["to"][0]) if "to" in qs and qs["to"][0].lstrip("-").isdigit() else None
            data = compute_stats_for_range(range_key, from_ms, to_ms)
            body = json.dumps(data).encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
        elif parsed.path == "/api/trace":
            cid = qs.get("cid", [""])[0]
            trace = build_session_trace(cid)
            body = json.dumps(trace).encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
        elif parsed.path == "/api/settings":
            cfg = load_config()
            cfg["current_version"] = __version__
            body = json.dumps(cfg).encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
        elif parsed.path in ("/favicon.svg", "/favicon.ico"):
            body = FAVICON_SVG.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "image/svg+xml; charset=utf-8")
            self.send_header("Cache-Control", "public, max-age=86400")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
        else:
            body = DASHBOARD_HTML.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

    def do_POST(self):
        parsed = urllib.parse.urlparse(self.path)
        if not self._verify_request_origin(is_post=True, is_api=True):
            return
        if parsed.path == "/api/settings":
            try:
                updates = self._read_bounded_json()
                if updates is None:
                    return
                saved = save_config(updates)
                saved["current_version"] = __version__
                body = json.dumps(saved).encode("utf-8")
                self.send_response(200)
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)
                return
            except Exception as e:
                self._send_json_error(400, str(e))
                return
        elif parsed.path == "/api/update":
            try:
                req_json = self._read_bounded_json()
                if req_json is None:
                    return
                check_only = bool(req_json.get("check_only", True))
                url_ov = str(req_json.get("url", "")).strip() or None
                res = perform_self_update(url_override=url_ov, check_only=check_only, force=False, quiet=True, allow_unverified=False)
                body = json.dumps(res).encode("utf-8")
                self.send_response(200)
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)
                return
            except Exception as e:
                self._send_json_error(400, str(e))
                return
        self.send_response(404)
        self.end_headers()

def _is_loopback_port_listening(port):
    try:
        with socket.create_connection(("127.0.0.1", port), timeout=0.15):
            return True
    except OSError:
        return False

def _terminate_existing_listener(port):
    if not _is_loopback_port_listening(port):
        return
    my_pid = os.getpid()
    try:
        if sys.platform.startswith("linux"):
            subprocess.run(["fuser", "-k", f"{port}/tcp"], capture_output=True)
        elif sys.platform == "darwin":
            out = subprocess.run(["lsof", "-ti", f"tcp:{port}", "-sTCP:LISTEN"], capture_output=True, text=True).stdout.strip()
            for pid_s in out.splitlines():
                if pid_s.strip().isdigit() and int(pid_s.strip()) != my_pid:
                    subprocess.run(["kill", "-TERM", pid_s.strip()], capture_output=True)
        elif sys.platform == "win32":
            out = subprocess.run(["netstat", "-ano", "-p", "tcp"], capture_output=True, text=True).stdout
            for ln in out.splitlines():
                parts = ln.split()
                if len(parts) >= 5 and parts[3].upper() == "LISTENING" and parts[1].endswith(f":{port}"):
                    if parts[4].isdigit() and int(parts[4]) != my_pid:
                        subprocess.run(["taskkill", "/PID", parts[4], "/F"], capture_output=True)
    except Exception:
        pass
    time.sleep(0.25)

def serve_web(port=None, open_browser=True):
    cfg = load_config()
    if port is None:
        port = cfg.get("web", {}).get("port", 3872)
    _terminate_existing_listener(port)
    socketserver.TCPServer.allow_reuse_address = True
    server = _StatsHTTPServer(("127.0.0.1", port), StatsHandler)
    url = f"http://localhost:{port}"
    print(f"{C.BOLD}{C.GREEN}agy stats ->{C.RESET} {C.BOLD}{C.CYAN}{url}{C.RESET}")
    if open_browser:
        print(f"{C.DIM}Opening web browser in default window...{C.RESET}")
        def _open():
            time.sleep(0.25)
            try:
                webbrowser.open(url)
            except Exception:
                pass
        threading.Thread(target=_open, daemon=True).start()
    print(f"{C.DIM}Press Ctrl+C to stop.{C.RESET}")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nStopped.")
    finally:
        server.server_close()

def main():
    parser = argparse.ArgumentParser(description="Antigravity Telemetry, Quota & Session Analytics")
    parser.add_argument("-v", "--version", action="store_true", help="Show version and binary path")
    parser.add_argument("--summary", action="store_true", help="Compact 1-line summary")
    parser.add_argument("--today", action="store_true", help="Show only today")
    parser.add_argument("--days", type=int, default=None, help="Number of days to show (default: 10)")
    parser.add_argument("--all", action="store_true", help="Show all days")
    parser.add_argument("--models", action="store_true", help="Show model breakdown")
    parser.add_argument("--quota", action="store_true", help="Show live quota pools")
    parser.add_argument("--sessions", action="store_true", help="Show sessions and quota usage")
    parser.add_argument("--tools", action="store_true", help="Show top tools and commands")
    parser.add_argument("--frustration", action="store_true", help="Show frustration signals")
    parser.add_argument("--tokens", action="store_true", help="Show token spent breakdown")
    parser.add_argument("--json", action="store_true", help="Output raw JSON")
    parser.add_argument("--cli", action="store_true", help="Force CLI terminal view")
    parser.add_argument("--web", "--serve", action="store_true", dest="web", help="Launch web dashboard")
    parser.add_argument("--no-open", action="store_true", help="Do not auto-open browser in web mode")
    parser.add_argument("--port", type=int, default=None, help="Web dashboard port (default: 3872)")
    parser.add_argument("--onboard", "--setup", action="store_true", dest="onboard", help="Run interactive step-by-step onboarding setup wizard")
    parser.add_argument("--install", action="store_true", help="Install agy-stats to ~/.local/bin and configure Fish/Bash/Zsh/PowerShell 'agy stats' subcommand")
    parser.add_argument("--update-url", default=None, help="Persist update source URL during --install")
    parser.add_argument("--update", nargs="?", const="", default=None, metavar="URL", help="Verified atomic self-update (optional source URL)")
    parser.add_argument("--check-update", action="store_true", help="Check if a newer version is available without updating")
    parser.add_argument("--force", action="store_true", help="Force reinstall during --update even if version matches")
    parser.add_argument("--allow-unverified", action="store_true", help="Allow CLI --update from a custom URL without Ed25519 .sig / .sha256")
    parser.add_argument("--uninstall", action="store_true", help="Cleanly remove agy-stats binary and shell hooks")
    parser.add_argument("--purge", action="store_true", help="Also delete ~/.config/agy-stats during --uninstall")
    parser.add_argument("--dry-run", action="store_true", help="Preview --uninstall actions without modifying files")
    parser.add_argument("--settings", "--config", nargs="*", dest="settings", help="View or modify user preferences (e.g. --settings default=web)")
    parser.add_argument("--_bg-update-worker", action="store_true", dest="bg_update_worker", help=argparse.SUPPRESS)
    args = parser.parse_args()

    if args.bg_update_worker:
        run_bg_update_worker()
        return

    if args.version:
        print(f"agy-stats v{__version__} ({os.path.abspath(__file__)})")
        return

    if args.uninstall:
        uninstall_agy_stats(purge=args.purge, dry_run=args.dry_run)
        return

    if args.update is not None or args.check_update:
        ok = self_update(url_override=args.update, check_only=args.check_update, force=args.force, allow_unverified=args.allow_unverified)
        sys.exit(0 if ok or args.check_update else 1)

    cfg = load_config()

    if args.install:
        install_shell_integration(verbose=True, update_url=args.update_url)
        cfg = load_config()
        has_tty = sys.stdin.isatty() or (os.path.exists("/dev/tty") and not os.environ.get("AGY_NONINTERACTIVE"))
        if not cfg.get("onboarded", False) and has_tty:
            cfg = run_onboarding_wizard(cfg)
        return

    if args.onboard:
        run_onboarding_wizard(cfg)
        return

    if args.settings is not None:
        handle_settings_cli(args.settings)
        return

    # Auto-detect first run if not onboarded and interactive TTY without explicit flags
    has_explicit_flag = any([
        args.summary, args.today, args.days is not None, args.all, args.models,
        args.quota, args.sessions, args.tools, args.frustration, args.tokens,
        args.json, args.no_open, args.cli, args.web, args.onboard,
        args.install, args.settings is not None
    ])
    if (not cfg.get("onboarded", False)) and sys.stdin.isatty() and sys.stdout.isatty() and not has_explicit_flag:
        print(f"\n{C.BOLD}{C.CYAN}First-time run detected! Starting quick onboarding setup...{C.RESET}\n")
        cfg = run_onboarding_wizard(cfg)
        if not cfg.get("onboarded", False):
            return

    if not args.json:
        maybe_check_updates_async(cfg)

    cfg_days = cfg.get("cli", {}).get("days", 10)
    limit_days = 1 if args.today else (9999 if args.all else (args.days if args.days is not None else cfg_days))

    if args.tokens:
        data = collect_all_data()
        print_cli_tokens(data, limit_days)
        return

    section_flags = any([args.summary, args.models, args.quota, args.sessions, args.tools, args.frustration])
    range_cli_flags = any([args.today, args.all, args.days is not None])
    force_cli = args.cli or section_flags or range_cli_flags or args.json

    # Determine mode:
    # Default is web unless --cli or specific CLI/range flags requested, or default_mode in config is "cli"
    run_web = False
    if args.web:
        run_web = True
    elif force_cli:
        run_web = False
    else:
        run_web = (cfg.get("default_mode", "web") == "web")

    if run_web:
        open_br = False if args.no_open else cfg.get("web", {}).get("open_browser", True)
        port = args.port if args.port is not None else cfg.get("web", {}).get("port", 3872)
        serve_web(port=port, open_browser=open_br)
        return

    data = collect_all_data()
    if args.json:
        print(json.dumps(data, indent=2))
        return

    if args.summary and not any([args.models, args.quota, args.sessions, args.tools, args.frustration, range_cli_flags]):
        print_cli_summary(data)
        return

    if not section_flags:
        def_view = cfg.get("cli", {}).get("default_view", "overview")
        dis_sec = cfg.get("cli", {}).get("disabled_sections", [])
        run_cli_view(def_view, data, dis_sec, limit_days)
        return

    print_cli_summary(data)
    if args.quota:
        print_cli_quota(data)
    if args.models:
        print_cli_models(data)
    if range_cli_flags:
        print_cli_days(data, limit_days)
    if args.sessions:
        print_cli_sessions(data, 15)
    if args.tools:
        print_cli_tools(data)
    if args.frustration:
        print_cli_frustration(data)

if __name__ == "__main__":
    main()
